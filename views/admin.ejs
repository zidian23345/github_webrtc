        // 封禁
        let currentBanName = null;
        function onBanReasonSelect(sel) {
            if (sel.value) document.getElementById('banReason').value = sel.value;
        }
        function onBanDurationSelect(sel) {
            document.getElementById('banCustomDurationBox').style.display = sel.value === 'custom' ? 'flex' : 'none';
        }
        // 计算封禁时长毫秒数（0 = 永久；-1 表示自定义输入无效）
        function getBanDurationMs() {
            const sel = document.getElementById('banDurationSelect');
            if (sel.value !== 'custom') return parseInt(sel.value) || 0;
            const num = parseFloat(document.getElementById('banCustomDurationNum').value);
            const unit = parseInt(document.getElementById('banCustomDurationUnit').value);
            if (!num || num <= 0) return -1;
            return Math.round(num * unit);
        }
        function openBanModal(socketId, name) {
            currentBanSocketId = socketId;
            currentBanName = name;
            document.getElementById('banUserInfo').textContent = `用户：${name}（${socketId}）`;
            document.getElementById('banReason').value = '';
            document.getElementById('banReasonSelect').value = '';
            document.getElementById('banDurationSelect').value = '0';
            document.getElementById('banCustomDurationBox').style.display = 'none';
            document.getElementById('banCustomDurationNum').value = '';
            document.getElementById('banChat').checked = true;
            document.getElementById('banMeeting').checked = false;
            document.getElementById('banIpDevice').checked = false;
            document.getElementById('banModal').classList.add('show');
        }
        function closeBanModal() { document.getElementById('banModal').classList.remove('show'); }
        async function confirmBan() {
            const reason = document.getElementById('banReason').value.trim();
            const banChat = document.getElementById('banChat').checked;
            const banMeeting = document.getElementById('banMeeting').checked;
            const banIpDevice = document.getElementById('banIpDevice').checked;
            const duration = getBanDurationMs();
            if (!reason) { alert('请输入封禁理由'); return; }
            if (duration < 0) { alert('请输入有效的自定义时长'); return; }
            try {
                const res = await fetch('/api/admin/ban', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    // 优先传 userName（持久化索引，socketId 在用户重连后会失效）；duration 毫秒，0 = 永久
                    body: JSON.stringify({ userName: currentBanName, socketId: currentBanSocketId, reason, banChat, banMeeting, duration, banIpDevice })
                });
                const data = await res.json();
                if (data.success) {
                    closeBanModal(); loadUsers(); loadIpBans();
                    const durText = duration > 0
                        ? '已封禁（定时 ' + formatBanDurationAdmin(duration) + '，到期自动解封）'
                        : '已封禁（永久）';
                    alert(durText + (data.ipDeviceNote ? '\n同时封禁：' + data.ipDeviceNote : ''));
                }
                else { alert(data.error || '封禁失败'); }
            } catch (e) { alert('网络错误'); }
        }
        function formatBanDurationAdmin(ms) {
            if (ms >= 86400000 && ms % 86400000 === 0) return (ms / 86400000) + ' 天';
            if (ms >= 3600000 && ms % 3600000 === 0) return (ms / 3600000) + ' 小时';
            if (ms >= 60000 && ms % 60000 === 0) return (ms / 60000) + ' 分钟';
            return Math.round(ms / 60000) + ' 分钟';
        }

