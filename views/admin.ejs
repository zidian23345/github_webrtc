        async function loadUsers() {
            try {
                const res = await fetch('/api/admin/users');
                const data = await res.json();
                document.getElementById('statOnline').textContent = data.onlineCount;
                document.getElementById('statBanned').textContent = data.users.filter(u => u.banned).length;
                const list = document.getElementById('usersList');
                if (data.users.length === 0) { list.innerHTML = '<div class="empty">暂无用户</div>'; return; }
                // 在线用户排在前面
                data.users.sort((a, b) => (b.online - a.online) || (b.lastSeen - a.lastSeen));
                let html = '<table><thead><tr><th>名称</th><th>状态</th><th>封禁</th><th>密码</th><th>最后在线</th><th>操作</th></tr></thead><tbody>';
                data.users.forEach(u => {
                    const lastSeen = u.lastSeen ? new Date(u.lastSeen).toLocaleString() : '未知';
                    let banCell = '正常';
                    if (u.banned) {
                        const bi = u.banInfo || {};
                        let expireText = '永久';
                        if (bi.expireAt) {
                            const left = bi.expireAt - Date.now();
                            if (left <= 0) expireText = '即将到期';
                            else if (left < 3600000) expireText = '剩 ' + Math.ceil(left / 60000) + ' 分钟';
                            else if (left < 86400000) expireText = '剩 ' + Math.ceil(left / 3600000) + ' 小时';
                            else expireText = '剩 ' + Math.ceil(left / 86400000) + ' 天';
                        }
                        banCell = '<span class="badge badge-banned">已封禁</span><br><small>' +
                            ((bi.bannedFromChat ? '禁言 ' : '') + (bi.bannedFromMeeting ? '禁会议 ' : '')).trim() +
                            ' · ' + expireText + '</small><br><small>' + (bi.reason || '') + '</small>';
                    }
                    const pwCell = u.hasPassword
                        ? '<span class="badge" style="background:#e6f7ff;color:#1976d2;">已设置</span>'
                        : '<span class="badge" style="background:#f5f5f5;color:#999;">未设置</span>';
                    html += `<tr>
                        <td><strong>${u.name}</strong></td>
                        <td>${u.online ? '<span class="badge badge-online">在线</span>' : '<span class="badge badge-offline">离线</span>'}</td>
                        <td>${banCell}</td>
                        <td>${pwCell}</td>
                        <td><small>${lastSeen}</small></td>
                        <td>
                            ${u.online ? `<button class="btn btn-rename" onclick="openRenameModal('${u.socketId}','${u.name.replace(/'/g,"\\'")}')">改名</button>` : ''}
                            ${u.banned ? `<button class="btn btn-unban" onclick="openUnbanModal('${u.socketId}','${u.name.replace(/'/g,"\\'")}')">解封</button>` :
                                `<button class="btn btn-ban" onclick="openBanModal('${u.socketId}','${u.name.replace(/'/g,"\\'")}')">封禁</button>`}
                            ${u.hasPassword
                                ? `<button class="btn" style="background:#1976d2;color:#fff;" onclick="openUserPasswordModal('${u.name.replace(/'/g,"\\'")}')">改密码</button><button class="btn" style="background:#888;color:#fff;" onclick="removeUserPassword('${u.name.replace(/'/g,"\\'")}')">移除密码</button>`
                                : `<button class="btn" style="background:#1976d2;color:#fff;" onclick="openUserPasswordModal('${u.name.replace(/'/g,"\\'")}')">设密码</button>`}
                        </td>
                    </tr>`;
                });
                html += '</tbody></table>';
                list.innerHTML = html;
            } catch (e) { console.error(e); }
        }

        async function loadWords() {
            try {
                const res = await fetch('/api/admin/banned-words');
                const data = await res.json();
                bannedWords = data.words || [];
                renderWords();
            } catch (e) { console.error(e); }
        }

        function renderWords() {
            const box = document.getElementById('wordsBox');
            if (bannedWords.length === 0) {
                box.innerHTML = '<small style="color:#999;">暂无违禁词</small>';
                return;
            }
            box.innerHTML = bannedWords.map((w, i) =>
                `<span class="word-tag">${w}<span class="remove" onclick="removeWord(${i})">×</span></span>`
            ).join('');
        }

        async function addWord() {
            const input = document.getElementById('newWordInput');
            const word = input.value.trim();
            if (!word) return;
            if (bannedWords.includes(word)) { alert('已存在'); return; }
            bannedWords.push(word);
            input.value = '';
            await saveWords();
            renderWords();
        }

        async function removeWord(index) {
            bannedWords.splice(index, 1);
            await saveWords();
            renderWords();
        }

        async function saveWords() {
            try {
                await fetch('/api/admin/banned-words', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ words: bannedWords })
                });
            } catch (e) { console.error(e); }
        }

