                        </div>
                        <div style="font-size:13px;color:#666;margin-top:6px;">举报理由：<b>${escapeHtml(r.reason || '-')}</b></div>
                        ${r.msgPreview ? `<div style="font-size:13px;margin-top:6px;background:#f9f9f9;border-radius:8px;padding:8px;word-break:break-word;">被举报消息：${escapeHtml(r.msgPreview)}</div>` : ''}
                        ${r.status !== 'pending' ? `<div style="font-size:12px;color:#888;margin-top:8px;">处理时间：${r.handledAt ? new Date(r.handledAt).toLocaleString() : '-'}${r.comment ? ' · 意见：' + escapeHtml(r.comment) : ''}</div>` : ''}
                        ${r.status === 'pending' ? `<div style="margin-top:10px;">
                            <button class="btn btn-unban" onclick="handleReport('${r.id}','resolved')"><i class="fa fa-check"></i> 已处理</button>
                            <button class="btn" style="background:#f5f5f5;color:#888;" onclick="handleReport('${r.id}','dismissed')"><i class="fa fa-times"></i> 忽略</button>
                            <button class="btn btn-ban" onclick="jumpToBanUser('${escapeHtml(r.reportedUser)}')"><i class="fa fa-ban"></i> 封禁该用户</button>
                        </div>` : ''}
                    </div>`).join('');
                window.__reportCache = {};
                list.forEach(r => { window.__reportCache[r.id] = r; });
            } catch (e) {
                wrap.innerHTML = '<div class="empty">加载失败：' + escapeHtml(e.message) + '</div>';
            }
        }
        // 处理举报（resolved=已处理 / dismissed=忽略）
        async function handleReport(id, action) {
            const comment = action === 'resolved' ? (prompt('处理意见（可选）：') || '') : '';
            try {
                const res = await fetch('/api/admin/handle-report', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id, action, comment })
                });
                const data = await res.json();
                if (data.success) { loadReports(); updateAdminDots(); }
                else { alert(data.error || '处理失败'); }
            } catch (e) { alert('网络错误'); }
        }
        // 从举报快速跳到用户面板封禁
        function jumpToBanUser(userName) {
            switchTab('users');
            setTimeout(() => {
                // 用户面板的封禁按钮按 data-name 匹配触发
                const btn = document.querySelector(`#usersList button[onclick*="${userName}"][onclick*="openBanModal"]`);
                if (btn) btn.click();
                else alert('未找到该用户（可能已离线），请在用户列表中手动操作');
            }, 600);
        }
        async function clearAllReports() {
            if (!confirm('确认清空全部举报记录？清空后不可恢复。')) return;
            try {
                const res = await fetch('/api/admin/clear-reports', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                const data = await res.json();
                if (data.success) { loadReports(); updateAdminDots(); alert('已清空 ' + (data.cleared || 0) + ' 条举报记录'); }
                else alert(data.error || '清空失败');
            } catch (e) { alert('网络错误'); }
        }

        // ===== 操作日志 =====
        async function loadLogs() {
            const wrap = document.getElementById('logsList');
            wrap.innerHTML = '<div class="empty">加载中...</div>';
            try {
                const res = await fetch('/api/admin/logs');
                if (!res.ok) { wrap.innerHTML = '<div class="empty">加载失败（未授权或服务异常）</div>'; return; }
                const data = await res.json();
                const list = data.list || [];
                if (!list.length) { wrap.innerHTML = '<div class="empty">暂无操作记录</div>'; return; }
                wrap.innerHTML = `<table><thead><tr><th>时间</th><th>操作</th><th>对象</th><th>详情</th><th>操作IP</th></tr></thead><tbody>` +
                    list.map(l => `<tr>
                        <td style="white-space:nowrap;">${l.createdAt ? new Date(l.createdAt).toLocaleString() : '-'}</td>
                        <td><b>${escapeHtml(l.action || '-')}</b></td>
                        <td>${escapeHtml(l.target || '-')}</td>
                        <td style="max-width:320px;word-break:break-all;">${escapeHtml(l.detail || '')}</td>
                        <td style="white-space:nowrap;">${escapeHtml(l.ip || '-')}</td>
                    </tr>`).join('') + '</tbody></table>';
            } catch (e) {
                wrap.innerHTML = '<div class="empty">加载失败：' + escapeHtml(e.message) + '</div>';
            }
        }
        async function clearAllLogs() {
            if (!confirm('确认清空全部操作日志？清空后不可恢复。')) return;
            try {
                const res = await fetch('/api/admin/clear-logs', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                const data = await res.json();
                if (data.success) { loadLogs(); alert('已清空 ' + (data.cleared || 0) + ' 条日志'); }
                else alert(data.error || '清空失败');
            } catch (e) { alert('网络错误'); }
        }

        // ===== IP/设备封禁管理 =====
        async function loadIpBans() {
            const wrap = document.getElementById('ipBansList');
            if (!wrap) return;
            wrap.innerHTML = '<div class="empty">加载中...</div>';
            try {
                const res = await fetch('/api/admin/ip-bans');
                if (!res.ok) { wrap.innerHTML = '<div class="empty">加载失败（未授权或服务异常）</div>'; return; }
                const data = await res.json();
                const list = data.list || [];
                if (!list.length) { wrap.innerHTML = '<div class="empty">暂无 IP/设备封禁</div>'; return; }
                wrap.innerHTML = `<table><thead><tr><th>类型</th><th>IP/设备ID</th><th>关联用户</th><th>封禁理由</th><th>时间</th><th>操作</th></tr></thead><tbody>` +
                    list.map(b => `<tr>
                        <td><span class="badge ${b.type === 'ip' ? 'badge-banned' : 'badge-online'}">${b.type === 'ip' ? 'IP' : '设备'}</span></td>
                        <td style="font-family:monospace;max-width:200px;word-break:break-all;">${escapeHtml(b.key)}</td>
                        <td>${escapeHtml(b.userName || '-')}</td>
                        <td style="max-width:220px;word-break:break-all;">${escapeHtml(b.reason || '-')}</td>
                        <td style="white-space:nowrap;">${b.bannedAt ? new Date(b.bannedAt).toLocaleString() : '-'}</td>
                        <td><button class="btn btn-unban" onclick="unbanIpDevice('${b.type}','${escapeHtml(b.key)}')">解除</button></td>
                    </tr>`).join('') + '</tbody></table>';
            } catch (e) {
                wrap.innerHTML = '<div class="empty">加载失败：' + escapeHtml(e.message) + '</div>';
            }
        }
        async function unbanIpDevice(type, key) {
            if (!confirm(`确认解除该${type === 'ip' ? ' IP' : '设备'}的封禁？\n${key}`)) return;
            try {
                const res = await fetch('/api/admin/unban-ip', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ type, key })
                });
                const data = await res.json();
                if (data.success) { loadIpBans(); alert('已解除'); }
                else alert(data.error || '解除失败');
            } catch (e) { alert('网络错误'); }
        }

        // ===== 小红点轮询：有待处理举报/申诉时在 Tab 上亮红点 =====
        async function updateAdminDots() {
            try {
                const res = await fetch('/api/admin/pending-count');
                if (!res.ok) return;
                const data = await res.json();
                const dotReports = document.getElementById('dotReports');
                const dotAppeals = document.getElementById('dotAppeals');
                if (dotReports) dotReports.style.display = (data.reports > 0) ? 'block' : 'none';
                if (dotAppeals) dotAppeals.style.display = (data.appeals > 0) ? 'block' : 'none';
            } catch (e) { /* 静默失败，下次轮询再试 */ }
        }
        // 每 15 秒轮询一次待处理数量
        setInterval(updateAdminDots, 15000);

        // 改名
        function openRenameModal(socketId, name) {
            currentRenameData = { socketId, name };
            document.getElementById('renameUserInfo').textContent = `当前名称：${name}`;
            document.getElementById('newName').value = name;
            document.getElementById('renameModal').classList.add('show');
        }
        function closeRenameModal() { document.getElementById('renameModal').classList.remove('show'); }
        async function confirmRename() {
            const newName = document.getElementById('newName').value.trim();
            if (!newName) { alert('请输入新名称'); return; }
            // 找到该用户所在的房间
            try {
                const res = await fetch('/api/admin/rooms');
                const data = await res.json();
                let roomId = null;
                for (const r of data.rooms) {
                    if (r.members.some(m => m.socketId === currentRenameData.socketId)) {
                        roomId = r.roomId; break;
                    }
                }
                if (!roomId) { alert('用户不在任何房间中'); return; }
                const res2 = await fetch('/api/admin/rename', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roomId, socketId: currentRenameData.socketId, newName })
                });
                const data2 = await res2.json();
                if (data2.success) { closeRenameModal(); loadUsers(); alert('已改名'); }
                else { alert(data2.error || '改名失败'); }
            } catch (e) { alert('网络错误'); }
        }

        // 隐藏/恢复消息
        async function hideMessage(msgId) {
            try {
                await fetch('/api/admin/hide-message', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ msgId })
                });
                loadMessages();
            } catch (e) { alert('网络错误'); }
        }
        async function showMessage(msgId) {
            try {
                await fetch('/api/admin/show-message', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ msgId })
                });
                loadMessages();
            } catch (e) { alert('网络错误'); }
        }

        // 删除单条消息
        async function deleteMessage(msgId) {
            if (!confirm('确定删除此消息？删除后所有用户都将看不到此消息。')) return;
            try {
                const res = await fetch('/api/admin/delete-message', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ msgId })
                });
                const data = await res.json();
                if (data.error) { alert(data.error); return; }
                loadMessages();
            } catch (e) { alert('网络错误'); }
        }

        // 清空所有消息
        async function clearAllMessages() {
            if (!confirm('确定清空所有聊天消息？此操作不可恢复！')) return;
            if (!confirm('再次确认：清空后所有用户的消息记录都将消失！')) return;
            try {
                const res = await fetch('/api/admin/clear-messages', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (data.error) { alert(data.error); return; }
                alert('已清空所有消息');
                loadMessages();
            } catch (e) { alert('网络错误'); }
        }

        // 初始化
        loadRooms();
        updateAdminDots();   // 启动时立即检查待处理举报/申诉（红点）
        // 自动刷新统计
        setInterval(() => {
            const activePanel = document.querySelector('.panel.active').id;
            if (activePanel === 'panel-rooms') loadRooms();
            else if (activePanel === 'panel-messages') loadMessages();
            else if (activePanel === 'panel-users') loadUsers();
        }, 5000);
    </script>
</body>
</html>
