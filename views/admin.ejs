                wrap.innerHTML = `<table><thead><tr><th>标题</th><th>内容</th><th>对象</th><th>时间</th><th>操作</th></tr></thead><tbody>` +
                    list.map(n => {
                        const isAll = !n.target || n.target === 'all';
                        const tag = isAll
                            ? '<span class="badge badge-online">全体</span>'
                            : '<span class="badge badge-banned">' + escapeHtml(n.target) + '</span>';
