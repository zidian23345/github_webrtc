<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>管理员后台</title>
    <link rel="stylesheet" href="/styles/fontawesome/css/font-awesome.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif; background: #f5f5f5; color: #333; }

        .header {
            background: linear-gradient(135deg, #5765ec 0%, #3f51b5 100%);
            color: #fff; padding: 20px 24px; display: flex;
            justify-content: space-between; align-items: center;
        }
        .header h1 { font-size: 22px; font-weight: 500; }
        .header-actions { display: flex; gap: 12px; }
        .header-btn {
            background: rgba(255,255,255,0.2); color: #fff; border: none;
            padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 14px;
            text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
        }
        .header-btn:hover { background: rgba(255,255,255,0.3); }

        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }

        .stats {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px; margin-bottom: 20px;
        }
        .stat-card {
            background: #fff; border-radius: 12px; padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }
        .stat-label { font-size: 13px; color: #888; margin-bottom: 6px; }
        .stat-value { font-size: 28px; font-weight: 600; color: #5765ec; }

        .tabs {
            display: flex; gap: 4px; margin-bottom: 16px;
            background: #fff; padding: 6px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }
        .tab {
            padding: 10px 20px; cursor: pointer; border-radius: 8px;
            font-size: 14px; color: #666; transition: all 0.2s; border: none;
            background: transparent; flex: 1; text-align: center;
        }
        .tab.active { background: #5765ec; color: #fff; }

        .panel { background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); display: none; }
        .panel.active { display: block; }

        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { text-align: left; padding: 10px 8px; background: #f5f5f5; color: #666; font-weight: 500; border-bottom: 1px solid #e0e0e0; }
        td { padding: 10px 8px; border-bottom: 1px solid #f0f0f0; vertical-align: top; }
        tr:hover { background: #fafafa; }

        .badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; }
        .badge-online { background: #e6f7e6; color: #52c41a; }
        .badge-offline { background: #f5f5f5; color: #999; }
        .badge-banned { background: #ffebee; color: #c62828; }
        .badge-host { background: #e3f2fd; color: #1976d2; }
        .badge-ghost { background: #f3e5f5; color: #7b1fa2; }
        .badge-hidden { background: #fff3e0; color: #e65100; }

        .btn {
            padding: 5px 10px; border: none; border-radius: 5px;
            cursor: pointer; font-size: 12px; margin: 2px;
        }
        .btn-ban { background: #fa5151; color: #fff; }
        .btn-unban { background: #07c160; color: #fff; }
        .btn-rename { background: #5765ec; color: #fff; }
        .btn-monitor { background: #ff9c19; color: #fff; }
        .btn-hide { background: #e65100; color: #fff; }
        .btn-show { background: #00ae9d; color: #fff; }
        .btn:hover { opacity: 0.85; }

        .msg-item { padding: 10px 8px; border-bottom: 1px solid #f0f0f0; display: flex; gap: 10px; }
        .msg-item.hidden { background: #fff5f5; }
        .msg-meta { font-size: 11px; color: #888; }
        .msg-content { font-size: 13px; margin-top: 4px; word-break: break-all; }
        .msg-content img { max-width: 100px; max-height: 100px; border-radius: 4px; }
        .msg-actions { margin-left: auto; white-space: nowrap; }

        .modal-mask {
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5); z-index: 200; display: none;
            align-items: center; justify-content: center;
        }
        .modal-mask.show { display: flex; }
        .modal-box { background: #fff; border-radius: 12px; width: 90%; max-width: 460px; overflow: hidden; }
        .modal-title { padding: 20px 16px 8px; font-size: 17px; font-weight: 500; text-align: center; }
        .modal-content { padding: 8px 16px 16px; }
        .modal-textarea {
            width: 100%; min-height: 80px; border: 1px solid #d9d9d9; border-radius: 8px;
            padding: 10px 12px; font-size: 14px; outline: none; margin-top: 8px; resize: vertical; font-family: inherit;
        }
        .modal-checkbox-group { margin-top: 12px; display: flex; flex-direction: column; gap: 8px; }
        .modal-checkbox-group label { display: flex; align-items: center; gap: 8px; font-size: 14px; }
        .modal-input {
            width: 100%; height: 40px; border: 1px solid #d9d9d9; border-radius: 8px;
            padding: 0 12px; font-size: 14px; outline: none; margin-top: 8px;
        }
        .modal-btns { display: flex; border-top: 1px solid #e5e5e5; }
        .modal-btn { flex: 1; height: 48px; border: none; background: #fff; font-size: 16px; cursor: pointer; color: #5765ec; }
        .modal-btn.cancel { color: #888; border-right: 1px solid #e5e5e5; }

        .banned-words-box {
            border: 1px solid #e0e0e0; border-radius: 8px; padding: 12px;
            min-height: 80px; margin-top: 8px;
        }
        .word-tag {
            display: inline-block; background: #ffebee; color: #c62828;
            padding: 4px 10px; margin: 2px; border-radius: 12px; font-size: 13px;
        }
        .word-tag .remove { cursor: pointer; margin-left: 6px; font-weight: bold; }

        .refresh-btn {
            background: #5765ec; color: #fff; border: none; padding: 8px 16px;
            border-radius: 6px; cursor: pointer; font-size: 13px; margin-bottom: 12px;
        }

        .empty { text-align: center; padding: 40px; color: #999; }

        /* ===== Tab 小红点（有待处理举报/申诉时显示）===== */
        .tab { position: relative; }
        .tab-dot {
            display: none; position: absolute; top: 4px; right: 0;
            width: 8px; height: 8px; border-radius: 50%;
            background: #fa5151; box-shadow: 0 0 0 2px #fff;
        }

        /* ===== 交互增强：键盘焦点环 + 按压反馈 ===== */
        .btn:focus-visible, .refresh-btn:focus-visible, .modal-btn:focus-visible,
        .header-btn:focus-visible, .tab:focus-visible, input:focus-visible,
        textarea:focus-visible, select:focus-visible {
            outline: 2px solid #5765ec;
            outline-offset: 2px;
        }
        .btn:active, .refresh-btn:active, .modal-btn:active { transform: scale(0.96); }
        .btn, .refresh-btn, .modal-btn { transition: opacity 0.15s, transform 0.1s; }
        .word-tag .remove:hover { color: #fa5151; }

        /* ===== 减弱动效：尊重系统无障碍设置 ===== */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1><i class="fa fa-shield"></i> 管理员后台</h1>
        <div class="header-actions">
            <a href="/" class="header-btn"><i class="fa fa-home"></i> 聊天室</a>
            <a href="/zidian/logout" class="header-btn"><i class="fa fa-sign-out"></i> 退出</a>
        </div>
    </div>

    <div class="container">
        <!-- 统计卡片 -->
        <div class="stats">
            <div class="stat-card">
                <div class="stat-label">在线用户</div>
                <div class="stat-value" id="statOnline">0</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">活跃会议</div>
                <div class="stat-value" id="statRooms">0</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">消息总数</div>
                <div class="stat-value" id="statMessages">0</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">已隐藏消息</div>
                <div class="stat-value" id="statHidden">0</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">已封禁用户</div>
                <div class="stat-value" id="statBanned">0</div>
            </div>
        </div>

        <!-- 标签页 -->
        <div class="tabs">
            <button class="tab active" onclick="switchTab('rooms')"><i class="fa fa-video-camera"></i> 会议</button>
            <button class="tab" onclick="switchTab('messages')"><i class="fa fa-comments"></i> 消息</button>
            <button class="tab" onclick="switchTab('friends')"><i class="fa fa-user-plus"></i> 好友</button>
            <button class="tab" onclick="switchTab('chatbgs')"><i class="fa fa-picture-o"></i> 背景管理</button>
            <button class="tab" onclick="switchTab('users')"><i class="fa fa-users"></i> 用户</button>
            <button class="tab" onclick="switchTab('words')"><i class="fa fa-filter"></i> 违禁词</button>
            <button class="tab" onclick="switchTab('notifications')"><i class="fa fa-bell"></i> 系统通知</button>
            <button class="tab" onclick="switchTab('appeals')"><i class="fa fa-commenting-o"></i> 申诉管理<span class="tab-dot" id="dotAppeals"></span></button>
            <button class="tab" onclick="switchTab('reports')"><i class="fa fa-flag"></i> 举报管理<span class="tab-dot" id="dotReports"></span></button>
            <button class="tab" onclick="switchTab('logs')"><i class="fa fa-history"></i> 操作日志</button>
            <button class="tab" onclick="switchTab('update')"><i class="fa fa-cloud-upload"></i> 发布更新</button>
        </div>

        <!-- 会议面板 -->
        <div class="panel active" id="panel-rooms">
            <button class="refresh-btn" onclick="loadRooms()"><i class="fa fa-refresh"></i> 刷新</button>
            <div id="roomsList"></div>
        </div>

        <!-- 消息面板 -->
        <div class="panel" id="panel-messages">
            <button class="refresh-btn" onclick="loadMessages()"><i class="fa fa-refresh"></i> 刷新</button>
            <button class="refresh-btn" style="background:#fa5151;color:#fff;margin-left:8px;" onclick="clearAllMessages()"><i class="fa fa-trash"></i> 清空所有消息</button>
            <div id="messagesList"></div>
        </div>

        <!-- 好友面板 -->
        <div class="panel" id="panel-friends">
            <h3 style="margin-bottom:8px;">好友关系</h3>
            <button class="refresh-btn" onclick="loadFriends()"><i class="fa fa-refresh"></i> 刷新好友列表</button>
            <button class="refresh-btn" style="background:#5765ec;color:#fff;margin-left:8px;" onclick="loadPrivateConversations()"><i class="fa fa-comments"></i> 查看私聊记录</button>
            <div id="friendsListAdmin" style="margin-top:12px;"></div>
            <div id="privateConversations" style="margin-top:20px;display:none;">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                    <button class="refresh-btn" onclick="backToFriendsList()"><i class="fa fa-angle-left"></i> 返回好友列表</button>
                    <span style="font-size:14px;font-weight:500;">私聊记录（服务端缓存最近 50 条/对）</span>
                </div>
                <div id="conversationsList"></div>
            </div>
            <div id="privateMessagesView" style="margin-top:20px;display:none;">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                    <button class="refresh-btn" onclick="backToConversationsList()"><i class="fa fa-angle-left"></i> 返回列表</button>
                    <span id="privateMessagesTitle" style="font-size:14px;font-weight:500;"></span>
                </div>
                <div id="privateMessagesList"></div>
            </div>
        </div>

        <!-- 聊天背景管理面板 -->
        <div class="panel" id="panel-chatbgs">
            <h3 style="margin-bottom:8px;">用户聊天背景</h3>
            <button class="refresh-btn" onclick="loadChatBgs()"><i class="fa fa-refresh"></i> 刷新背景列表</button>
            <div style="font-size:13px;color:#888;margin:8px 0;">说明：用户更换私聊背景时会上传缩略图。若发现不合规图片，点击"撤回"会将该用户的对应私聊背景重置为默认。</div>
            <div id="chatBgsList" style="margin-top:12px;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;"></div>
        </div>

        <!-- 用户面板 -->
        <div class="panel" id="panel-users">
            <button class="refresh-btn" onclick="loadUsers()"><i class="fa fa-refresh"></i> 刷新</button>
            <div id="usersList"></div>

            <!-- IP/设备封禁管理 -->
            <div style="margin-top:24px;border-top:1px solid #eee;padding-top:16px;">
                <h3 style="margin-bottom:8px;"><i class="fa fa-network-wired"></i> IP/设备封禁</h3>
                <p style="color:#666;font-size:13px;margin-bottom:12px;">封禁用户时勾选"同时封禁 IP/设备"会记录其网络 IP 与设备 ID，换用户名也无法进入。解除某用户的封禁时会自动解除其关联的 IP/设备封禁。</p>
                <button class="refresh-btn" onclick="loadIpBans()"><i class="fa fa-refresh"></i> 刷新列表</button>
                <div id="ipBansList"></div>
            </div>
        </div>

        <!-- 违禁词面板 -->
        <div class="panel" id="panel-words">
            <h3 style="margin-bottom: 12px;">违禁词管理</h3>
            <p style="color: #666; font-size: 13px; margin-bottom: 12px;">包含违禁词的消息将无法发送，发送者会收到提示。</p>
            <input type="text" class="modal-input" id="newWordInput" placeholder="输入违禁词，按回车添加" onkeypress="if(event.key==='Enter')addWord()">
            <div class="banned-words-box" id="wordsBox"></div>
        </div>

        <!-- 系统通知面板 -->
        <div class="panel" id="panel-notifications">
            <h3 style="margin-bottom: 12px;">系统通知管理</h3>
            <p style="color: #666; font-size: 13px; margin-bottom: 12px;">向全体用户或指定用户下发通知，用户首页左上角铃铛会显示红点提醒。封禁/解封也会自动生成定向通知。</p>
            <div style="background:#f9f9f9;border:1px solid #e8e8e8;border-radius:10px;padding:14px;margin-bottom:16px;max-width:600px;">
                <div style="margin-bottom:10px;">
                    <label style="display:block;font-size:13px;color:#666;margin-bottom:4px;">通知标题</label>
                    <input type="text" class="modal-input" id="notifTitleInput" placeholder="如：系统公告（留空默认为系统通知）" style="width:100%;">
                </div>
                <div style="margin-bottom:10px;">
                    <label style="display:block;font-size:13px;color:#666;margin-bottom:4px;">通知内容 *</label>
                    <textarea class="modal-textarea" id="notifContentInput" placeholder="输入通知内容" rows="3" style="width:100%;"></textarea>
                </div>
                <div style="margin-bottom:12px;">
                    <label style="display:block;font-size:13px;color:#666;margin-bottom:4px;">发送对象</label>
                    <input type="text" class="modal-input" id="notifTargetInput" placeholder="留空 = 全体用户；填用户名 = 仅该用户可见" style="width:100%;">
                </div>
                <button class="refresh-btn" style="background:#07c160;color:#fff;" onclick="sendNotification()"><i class="fa fa-paper-plane"></i> 下发通知</button>
            </div>
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                <h4 style="font-size:14px;color:#333;">已下发通知</h4>
                <button class="refresh-btn" onclick="loadNotifications()"><i class="fa fa-refresh"></i> 刷新</button>
                <button class="refresh-btn" style="background:#fa5151;color:#fff;" onclick="clearAllNotifications()"><i class="fa fa-trash"></i> 清空全部通知</button>
            </div>
            <div id="notificationsList"></div>
        </div>

        <!-- 申诉管理面板 -->
        <div class="panel" id="panel-appeals">
            <h3 style="margin-bottom: 8px;">封禁申诉管理</h3>
            <p style="color: #666; font-size: 13px; margin-bottom: 12px;">用户对封禁提交的申诉。同意后立即解封并通知用户；驳回后用户无法对该封禁再次申诉。</p>
            <button class="refresh-btn" onclick="loadAppeals()"><i class="fa fa-refresh"></i> 刷新</button>
            <button class="refresh-btn" style="background:#fa5151;color:#fff;" onclick="clearAllAppeals()"><i class="fa fa-trash"></i> 清空全部申诉</button>
            <div id="appealsList" style="margin-top:12px;"></div>
        </div>

        <!-- 举报管理面板 -->
        <div class="panel" id="panel-reports">
            <h3 style="margin-bottom: 8px;">消息举报管理</h3>
            <p style="color: #666; font-size: 13px; margin-bottom: 12px;">用户长按消息提交的举报（群聊/私聊）。"已处理"表示已跟进（如封禁/警告），"忽略"表示无需处理。收到新举报时顶部标签会显示小红点。</p>
            <button class="refresh-btn" onclick="loadReports()"><i class="fa fa-refresh"></i> 刷新</button>
            <button class="refresh-btn" style="background:#fa5151;color:#fff;" onclick="clearAllReports()"><i class="fa fa-trash"></i> 清空全部举报</button>
            <div id="reportsList" style="margin-top:12px;"></div>
        </div>

        <!-- 操作日志面板 -->
        <div class="panel" id="panel-logs">
            <h3 style="margin-bottom: 8px;">管理员操作日志</h3>
            <p style="color: #666; font-size: 13px; margin-bottom: 12px;">自动记录所有管理操作（封禁/解封/消息管理/通知/申诉处理等），最多保留 500 条，供审计追溯。</p>
            <button class="refresh-btn" onclick="loadLogs()"><i class="fa fa-refresh"></i> 刷新</button>
            <button class="refresh-btn" style="background:#fa5151;color:#fff;" onclick="clearAllLogs()"><i class="fa fa-trash"></i> 清空日志</button>
            <div id="logsList" style="margin-top:12px;"></div>
        </div>

        <!-- 发布更新面板 -->
        <div class="panel" id="panel-update">
            <h3 style="margin-bottom: 12px;">发布应用更新</h3>
            <div id="currentVersionInfo" style="background:#f5f5f5;padding:12px;border-radius:8px;margin-bottom:16px;font-size:13px;color:#666;">加载中...</div>
            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:13px;color:#666;margin-bottom:4px;">版本号（如 1.1）</label>
                <input type="text" class="modal-input" id="updateVersionName" placeholder="1.1" style="width:120px;">
            </div>
            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:13px;color:#666;margin-bottom:4px;">版本数字代码（递增整数）</label>
                <input type="number" class="modal-input" id="updateVersionCode" placeholder="2" style="width:120px;">
            </div>
            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:13px;color:#666;margin-bottom:4px;">更新内容</label>
                <textarea class="modal-textarea" id="updateContent" placeholder="1. 修复 xxx&#10;2. 新增 xxx&#10;3. 优化 xxx" rows="5" style="width:100%;max-width:500px;"></textarea>
            </div>
            <div style="margin-bottom:12px;">
                <label style="display:block;font-size:13px;color:#666;margin-bottom:4px;">APK 文件</label>
                <input type="file" id="updateApkFile" accept=".apk" style="font-size:13px;">
                <p style="font-size:12px;color:#999;margin-top:4px;">选择编译好的 APK 文件</p>
            </div>
            <button class="refresh-btn" style="background:#07c160;color:#fff;" onclick="publishUpdate()"><i class="fa fa-upload"></i> 发布更新</button>
        </div>
    </div>

    <!-- 封禁弹窗 -->
    <div class="modal-mask" id="banModal">
        <div class="modal-box">
            <div class="modal-title">封禁用户</div>
            <div class="modal-content">
                <p id="banUserInfo" style="font-size: 14px; margin-bottom: 8px;"></p>
                <select id="banReasonSelect" class="modal-input" onchange="onBanReasonSelect(this)">
                    <option value="">— 快速选择封禁理由 —</option>
                    <option>发布违规内容</option>
                    <option>辱骂他人</option>
                    <option>发送垃圾广告</option>
                    <option>泄露他人隐私</option>
                    <option>恶意刷屏</option>
                    <option>传播不当信息</option>
                    <option>骚扰其他用户</option>
                    <option>违反社区规范</option>
                </select>
                <textarea class="modal-textarea" id="banReason" placeholder="请输入封禁理由（可从上方快速选择后编辑）"></textarea>
                <select id="banDurationSelect" class="modal-input" onchange="onBanDurationSelect(this)">
                    <option value="0">永久封禁</option>
                    <option value="3600000">1 小时</option>
                    <option value="86400000">1 天</option>
                    <option value="604800000">7 天</option>
                    <option value="2592000000">30 天</option>
                    <option value="custom">自定义时长…</option>
                </select>
                <div id="banCustomDurationBox" style="display:none;gap:8px;align-items:center;margin-top:8px;">
                    <input type="number" class="modal-input" id="banCustomDurationNum" placeholder="数字" min="1" style="width:100px;flex:1;">
                    <select class="modal-input" id="banCustomDurationUnit" style="width:100px;flex:1;">
                        <option value="60000">分钟</option>
                        <option value="3600000" selected>小时</option>
                        <option value="86400000">天</option>
                    </select>
                </div>
                <div class="modal-checkbox-group">
                    <label><input type="checkbox" id="banChat" checked> 禁言（不能发消息）</label>
                    <label><input type="checkbox" id="banMeeting"> 禁用会议功能</label>
                    <label><input type="checkbox" id="banIpDevice"> 同时封禁 IP/设备（换用户名也无法进入）</label>
                </div>
            </div>
            <div class="modal-btns">
                <button class="modal-btn cancel" onclick="closeBanModal()">取消</button>
                <button class="modal-btn" onclick="confirmBan()" style="color:#fa5151;">确认封禁</button>
            </div>
        </div>
    </div>

    <!-- 解封弹窗 -->
    <div class="modal-mask" id="unbanModal">
        <div class="modal-box">
            <div class="modal-title">解封用户</div>
            <div class="modal-content">
                <p id="unbanUserInfo" style="font-size: 14px; margin-bottom: 8px;"></p>
                <textarea class="modal-textarea" id="unbanReason" placeholder="请输入解封理由"></textarea>
            </div>
            <div class="modal-btns">
                <button class="modal-btn cancel" onclick="closeUnbanModal()">取消</button>
                <button class="modal-btn" onclick="confirmUnban()" style="color:#07c160;">确认解封</button>
            </div>
        </div>
    </div>

    <!-- 用户密码设置弹窗 -->
    <div class="modal-mask" id="userPasswordModal">
        <div class="modal-box">
            <div class="modal-title">设置用户密码</div>
            <div class="modal-content">
                <p id="userPasswordInfo" style="font-size: 14px; margin-bottom: 8px;"></p>
                <input type="text" class="modal-input" id="userPasswordInput" placeholder="输入新密码（至少 4 位）" maxlength="64" style="width:100%;">
                <p style="font-size:12px;color:#888;margin-top:8px;line-height:1.6;">设置后该名称受密码保护，登录时必须输入正确密码；设置新密码会覆盖旧密码。</p>
            </div>
            <div class="modal-btns">
                <button class="modal-btn cancel" onclick="closeUserPasswordModal()">取消</button>
                <button class="modal-btn" onclick="confirmUserPassword()" style="color:#1976d2;">保存密码</button>
            </div>
        </div>
    </div>

    <!-- 处理申诉弹窗 -->
    <div class="modal-mask" id="handleAppealModal">
        <div class="modal-box">
            <div class="modal-title">处理申诉</div>
            <div class="modal-content">
                <p id="handleAppealInfo" style="font-size: 14px; margin-bottom: 8px;"></p>
                <textarea class="modal-textarea" id="handleAppealComment" placeholder="处理意见（可选，会展示给用户）"></textarea>
            </div>
            <div class="modal-btns">
                <button class="modal-btn cancel" onclick="closeHandleAppeal()">取消</button>
                <button class="modal-btn" onclick="confirmHandleAppeal()" style="color:#07c160;">确认</button>
            </div>
        </div>
    </div>

    <!-- 改名弹窗 -->
    <div class="modal-mask" id="renameModal">
        <div class="modal-box">
            <div class="modal-title">修改用户名称</div>
            <div class="modal-content">
                <p id="renameUserInfo" style="font-size: 14px; margin-bottom: 8px;"></p>
                <input type="text" class="modal-input" id="newName" placeholder="输入新名称">
            </div>
            <div class="modal-btns">
                <button class="modal-btn cancel" onclick="closeRenameModal()">取消</button>
                <button class="modal-btn" onclick="confirmRename()">确认</button>
            </div>
        </div>
    </div>

    <script>
        let currentBanSocketId = null;
        let currentUnbanSocketId = null;
        let currentRenameData = null;
        let bannedWords = [];

        function switchTab(name) {
            document.querySelectorAll('.tab').forEach((t, i) => {
                t.classList.toggle('active', ['rooms','messages','friends','chatbgs','users','words','notifications','appeals','reports','logs','update'][i] === name);
            });
            document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
            document.getElementById('panel-' + name).classList.add('active');
            if (name === 'rooms') loadRooms();
            else if (name === 'messages') loadMessages();
            else if (name === 'friends') loadFriends();
            else if (name === 'chatbgs') loadChatBgs();
            else if (name === 'users') { loadUsers(); loadIpBans(); }
            else if (name === 'words') loadWords();
            else if (name === 'notifications') loadNotifications();
            else if (name === 'appeals') loadAppeals();
            else if (name === 'reports') loadReports();
            else if (name === 'logs') loadLogs();
            else if (name === 'update') loadCurrentVersion();
        }

        // ===== 聊天背景管理 =====
        async function loadChatBgs() {
            const wrap = document.getElementById('chatBgsList');
            wrap.innerHTML = '<div class="empty">加载中...</div>';
            try {
                const res = await fetch('/api/admin/chat-bgs');
                if (!res.ok) { wrap.innerHTML = '<div class="empty">加载失败</div>'; return; }
                const data = await res.json();
                const list = data.list || [];
                if (list.length === 0) {
                    wrap.innerHTML = '<div class="empty">暂无用户设置聊天背景</div>';
                    return;
                }
                wrap.innerHTML = list.map(item => {
                    const date = new Date(item.updatedAt).toLocaleString();
                    return `<div style="border:1px solid #e0e0e0;border-radius:8px;padding:8px;background:#fff;">
                        <img src="${item.data}" style="width:100%;height:140px;object-fit:cover;border-radius:4px;background:#f5f5f5;cursor:pointer;" onclick="previewBgImage('${item.key}')" data-bg-key="${item.key}">
                        <div style="font-size:13px;margin-top:6px;">
                            <div><b>用户：</b>${escapeHtml(item.userName)}</div>
                            <div><b>对方：</b>${escapeHtml(item.peer)}</div>
                            <div style="color:#888;font-size:12px;">${date}</div>
                        </div>
                        <button class="refresh-btn" style="background:#fa5151;color:#fff;width:100%;margin-top:6px;" onclick="resetChatBgByAdmin('${item.userName}','${item.peer}')"><i class="fa fa-undo"></i> 撤回（重置为默认）</button>
                    </div>`;
                }).join('');
                // 缓存原图用于预览
                window.__chatBgCache = {};
                list.forEach(item => { window.__chatBgCache[item.key] = item.data; });
            } catch(e) {
                wrap.innerHTML = '<div class="empty">加载失败：' + escapeHtml(e.message) + '</div>';
            }
        }
        function previewBgImage(key) {
            const dataUrl = window.__chatBgCache && window.__chatBgCache[key];
            if (!dataUrl) return;
            // 复用图片预览模态
            let preview = document.getElementById('bgImagePreview');
            if (!preview) {
                preview = document.createElement('div');
                preview.id = 'bgImagePreview';
                preview.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.85);z-index:9999;display:none;align-items:center;justify-content:center;';
                preview.innerHTML = `<img style="max-width:90%;max-height:90%;border-radius:8px;"><i class="fa fa-times" style="position:absolute;top:20px;right:20px;color:#fff;font-size:32px;cursor:pointer;" onclick="document.getElementById('bgImagePreview').style.display='none';"></i>`;
                document.body.appendChild(preview);
            }
            preview.querySelector('img').src = dataUrl;
            preview.style.display = 'flex';
        }
        async function resetChatBgByAdmin(userName, peer) {
            if (!confirm(`确定撤回 ${userName} 与 ${peer} 的聊天背景吗？\n撤回后该用户此私聊的背景将被重置为默认。`)) return;
            try {
                const res = await fetch('/api/admin/reset-chat-bg', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userName, peer })
                });
                const data = await res.json();
                if (data.success) {
                    alert('已撤回');
                    loadChatBgs();
                } else {
                    alert('操作失败：' + (data.error || '未知错误'));
                }
            } catch(e) {
                alert('操作失败：' + e.message);
            }
        }

        // ===== 好友关系管理 =====
        async function loadFriends() {
            const el = document.getElementById('friendsListAdmin');
            el.innerHTML = '<div class="empty">加载中...</div>';
            // 切回好友列表视图（隐藏私聊相关面板）
            document.getElementById('friendsListAdmin').style.display = 'block';
            document.getElementById('privateConversations').style.display = 'none';
            document.getElementById('privateMessagesView').style.display = 'none';
            try {
                const res = await fetch('/api/admin/friends');
                const data = await res.json();
                const list = data.friends || [];
                if (list.length === 0) {
                    el.innerHTML = '<div class="empty">暂无好友关系</div>';
                    return;
                }
                let html = '<table><thead><tr><th>用户</th><th>好友列表</th><th>数量</th></tr></thead><tbody>';
                for (const item of list) {
                    const friends = item.friends || [];
                    const friendsHtml = friends.length === 0
                        ? '<span style="color:#999;">无</span>'
                        : friends.map(f => `<span class="badge badge-online" style="margin:2px;">${escapeHtml(f)}</span>`).join('');
                    html += `<tr>
                        <td style="font-weight:500;">${escapeHtml(item.userName)}</td>
                        <td>${friendsHtml}</td>
                        <td>${friends.length}</td>
                    </tr>`;
                }
                html += '</tbody></table>';
                el.innerHTML = html;
            } catch (e) {
                el.innerHTML = '<div class="empty">加载失败：' + (e.message || '') + '</div>';
            }
        }

        // 列出所有私聊会话
        async function loadPrivateConversations() {
            // 隐藏好友列表，显示私聊会话列表
            document.getElementById('friendsListAdmin').style.display = 'none';
            document.getElementById('privateMessagesView').style.display = 'none';
            const wrap = document.getElementById('privateConversations');
            const list = document.getElementById('conversationsList');
            wrap.style.display = 'block';
            list.innerHTML = '<div class="empty">加载中...</div>';
            try {
                const res = await fetch('/api/admin/private-conversations');
                const data = await res.json();
                const convs = data.conversations || [];
                if (convs.length === 0) {
                    list.innerHTML = '<div class="empty">暂无私聊记录</div>';
                    return;
                }
                let html = '<table><thead><tr><th>会话双方</th><th>消息数</th><th>最后消息时间</th><th>操作</th></tr></thead><tbody>';
                for (const c of convs) {
                    const time = c.lastTime ? new Date(c.lastTime).toLocaleString() : '-';
                    html += `<tr>
                        <td><span class="badge badge-host">${escapeHtml(c.userA)}</span> <i class="fa fa-exchange" style="color:#999;"></i> <span class="badge badge-host">${escapeHtml(c.userB)}</span></td>
                        <td>${c.count}</td>
                        <td style="font-size:12px;color:#888;">${time}</td>
                        <td><button class="btn btn-rename" onclick="viewPrivateMessages('${encodeURIComponent(c.userA)}','${encodeURIComponent(c.userB)}')">查看记录</button></td>
                    </tr>`;
                }
                html += '</tbody></table>';
                list.innerHTML = html;
            } catch (e) {
                list.innerHTML = '<div class="empty">加载失败：' + (e.message || '') + '</div>';
            }
        }

        // 查看具体某两个用户的私聊记录
        async function viewPrivateMessages(userAEnc, userBEnc) {
            const userA = decodeURIComponent(userAEnc);
            const userB = decodeURIComponent(userBEnc);
            // 切换视图：隐藏会话列表，显示消息记录
            document.getElementById('privateConversations').style.display = 'none';
            document.getElementById('privateMessagesView').style.display = 'block';
            document.getElementById('privateMessagesTitle').textContent = userA + ' ↔ ' + userB;
            const list = document.getElementById('privateMessagesList');
            list.innerHTML = '<div class="empty">加载中...</div>';
            try {
                const res = await fetch(`/api/admin/private-messages?userA=${encodeURIComponent(userA)}&userB=${encodeURIComponent(userB)}`);
                const data = await res.json();
                const msgs = data.messages || [];
                if (msgs.length === 0) {
                    list.innerHTML = '<div class="empty">该会话暂无消息</div>';
                    return;
                }
                let html = '';
                for (const m of msgs) {
                    // 服务端消息字段：sender（发送者） + 推送时附带 from 字段
                    const fromName = m.sender || m.from || '';
                    const toName = (fromName === userA) ? userB : userA;
                    const time = m.timestamp ? new Date(m.timestamp).toLocaleString() : '';
                    let content = '';
                    if (m.type === 'image' && m.content) {
                        content = `<img src="${m.content}" style="max-width:120px;max-height:120px;border-radius:4px;">`;
                    } else if (m.type === 'video' && m.content) {
                        content = `<a href="${m.content}" target="_blank" style="color:#5765ec;">[视频消息]</a>`;
                    } else if (m.type === 'voice') {
                        content = `[语音消息] ${m.duration || 0}秒`;
                    } else if (m.type === 'call') {
                        content = `[通话记录] ${m.callType || 'voice'} ${m.callOutcome || ''}`;
                    } else if (m.type === 'bg-invite') {
                        content = '[背景邀请] ' + (m.content ? '<span style="color:#888;">(含图片数据)</span>' : '');
                    } else if (m.type === 'bg-accepted') { content = '[已接受背景邀请]'; }
                    else if (m.type === 'bg-rejected') { content = '[已拒绝背景邀请]'; }
                    else if (m.type === 'bg-reset') { content = '[恢复默认背景]'; }
                    else if (m.type === 'bg-reset-by-admin') { content = '[管理员重置背景]'; }
                    else {
                        content = escapeHtml(m.content || '');
                        if (m.recalled) content = '<span style="color:#999;">[已撤回] ' + content + '</span>';
                    }
                    const isSelf = fromName === userA;
                    const hidden = m.adminHidden;
                    const msgId = m.id || '';
                    html += `<div class="msg-item" style="background:${hidden ? '#fff3f3' : (isSelf ? '#f6f9ff' : '#fff')};${hidden ? 'border-left:3px solid #fa5151;':''}">
                        <div style="flex:1;">
                            <div class="msg-meta">
                                <strong>${escapeHtml(fromName)}</strong> → <strong>${escapeHtml(toName)}</strong> · ${time}
                                ${hidden ? '<span style="color:#fa5151;font-size:11px;margin-left:6px;">[已隐藏]</span>' : ''}
                            </div>
                            <div class="msg-content">${content}</div>
                            <div style="margin-top:6px;display:flex;gap:6px;">
                                <button class="btn-mini" style="background:#fa5151;color:#fff;border:none;padding:3px 10px;border-radius:4px;font-size:12px;cursor:pointer;" onclick="deletePrivateMsg('${encodeURIComponent(userA)}','${encodeURIComponent(userB)}','${msgId}')">删除</button>
                                <button class="btn-mini" style="background:${hidden?'#07c160':'#ffa500'};color:#fff;border:none;padding:3px 10px;border-radius:4px;font-size:12px;cursor:pointer;" onclick="toggleHidePrivateMsg('${encodeURIComponent(userA)}','${encodeURIComponent(userB)}','${msgId}',${hidden?'false':'true'})">${hidden?'取消隐藏':'隐藏'}</button>
                            </div>
                        </div>
                    </div>`;
                }
                list.innerHTML = html;
            } catch (e) {
                list.innerHTML = '<div class="empty">加载失败：' + (e.message || '') + '</div>';
            }
        }

        // 删除私聊消息
        async function deletePrivateMsg(userAEnc, userBEnc, msgId) {
            const userA = decodeURIComponent(userAEnc);
            const userB = decodeURIComponent(userBEnc);
            if (!confirm('确定删除这条消息吗？删除后不可恢复。')) return;
            try {
                const res = await fetch('/api/admin/delete-private-msg', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userA, userB, msgId })
                });
                const data = await res.json();
                if (data.success) {
                    alert('已删除');
                    viewPrivateMessages(userAEnc, userBEnc);
                } else {
                    alert('删除失败：' + (data.error || ''));
                }
            } catch(e) { alert('操作失败：' + e.message); }
        }
        // 隐藏/取消隐藏私聊消息
        async function toggleHidePrivateMsg(userAEnc, userBEnc, msgId, hidden) {
            const userA = decodeURIComponent(userAEnc);
            const userB = decodeURIComponent(userBEnc);
            try {
                const res = await fetch('/api/admin/hide-private-msg', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userA, userB, msgId, hidden: hidden === true || hidden === 'true' })
                });
                const data = await res.json();
                if (data.success) {
                    viewPrivateMessages(userAEnc, userBEnc);
                } else {
                    alert('操作失败：' + (data.error || ''));
                }
            } catch(e) { alert('操作失败：' + e.message); }
        }

        // 返回好友列表视图（从私聊会话列表返回）
        function backToFriendsList() {
            document.getElementById('privateConversations').style.display = 'none';
            document.getElementById('privateMessagesView').style.display = 'none';
            document.getElementById('friendsListAdmin').style.display = 'block';
        }

        // 从单条会话消息视图返回到会话列表
        function backToConversationsList() {
            document.getElementById('privateMessagesView').style.display = 'none';
            document.getElementById('privateConversations').style.display = 'block';
            document.getElementById('friendsListAdmin').style.display = 'none';
        }

        function escapeHtml(s) {
            if (s === null || s === undefined) return '';
            return String(s).replace(/[&<>"']/g, ch => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            })[ch]);
        }

        // 加载当前已发布版本信息
        async function loadCurrentVersion() {
            try {
                const res = await fetch('/api/admin/app-version');
                const data = await res.json();
                const el = document.getElementById('currentVersionInfo');
                if (data.versionInfo) {
                    const v = data.versionInfo;
                    const date = new Date(v.publishedAt).toLocaleString();
                    el.innerHTML = `<strong>当前已发布版本：</strong>v${v.versionName} (code=${v.versionCode})<br><strong>发布时间：</strong>${date}<br><strong>更新内容：</strong><br>${(v.updateContent||'无').replace(/\n/g,'<br>')}`;
                    // 自动填充新版本字段（递增）
                    document.getElementById('updateVersionName').value = v.versionName;
                    document.getElementById('updateVersionCode').value = v.versionCode + 1;
                } else {
                    el.innerHTML = '<strong>当前：</strong>尚无已发布的版本';
                }
            } catch (e) {
                document.getElementById('currentVersionInfo').textContent = '加载失败';
            }
        }

        // 发布更新
        async function publishUpdate() {
            const versionName = document.getElementById('updateVersionName').value.trim();
            const versionCode = document.getElementById('updateVersionCode').value.trim();
            const updateContent = document.getElementById('updateContent').value.trim();
            const fileInput = document.getElementById('updateApkFile');
            if (!versionName || !versionCode) { alert('请填写版本号'); return; }
            if (!fileInput.files[0]) { alert('请选择 APK 文件'); return; }
            const file = fileInput.files[0];
            if (!file.name.endsWith('.apk')) { alert('请选择 .apk 文件'); return; }
            if (file.size > 80 * 1024 * 1024) { alert('APK 文件不能超过 80MB'); return; }
            if (!confirm(`确定发布版本 v${versionName} (code=${versionCode})？`)) return;
            try {
                document.querySelector('button[onclick="publishUpdate()"]').textContent = '上传中...';
                const reader = new FileReader();
                reader.onload = async function(e) {
                    const res = await fetch('/api/admin/publish-update', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            versionCode: parseInt(versionCode),
                            versionName,
                            updateContent,
                            apkData: e.target.result
                        })
                    });
                    const data = await res.json();
                    document.querySelector('button[onclick="publishUpdate()"]').innerHTML = '<i class="fa fa-upload"></i> 发布更新';
                    if (data.error) { alert(data.error); return; }
                    alert('发布成功！客户端将在下次启动时收到更新提示');
                    loadCurrentVersion();
                    document.getElementById('updateContent').value = '';
                    document.getElementById('updateApkFile').value = '';
                };
                reader.readAsDataURL(file);
            } catch (e) { alert('发布失败：网络错误'); }
        }

        async function loadRooms() {
            try {
                const res = await fetch('/api/admin/rooms');
                const data = await res.json();
                document.getElementById('statRooms').textContent = data.total;
                const list = document.getElementById('roomsList');
                if (data.rooms.length === 0) { list.innerHTML = '<div class="empty">暂无活跃会议</div>'; return; }
                let html = '<table><thead><tr><th>房间号</th><th>房主</th><th>人数</th><th>成员</th><th>操作</th></tr></thead><tbody>';
                data.rooms.forEach(r => {
                    const members = r.members.map(m => `${m.name}${m.isHost ? '(房主)' : ''}${m.isGhost ? '(监控)' : ''}`).join(', ');
                    html += `<tr>
                        <td><strong>${r.roomId}</strong></td>
                        <td>${r.hostName}</td>
                        <td>${r.memberCount}</td>
                        <td style="max-width:300px;word-break:break-all;">${members}</td>
                        <td>
                            <button class="btn btn-monitor" onclick="monitorRoom('${r.roomId}')"><i class="fa fa-eye"></i> 监控</button>
                            <button class="btn" style="background:#fa5151;color:#fff;margin-left:6px;" onclick="endRoom('${r.roomId}')"><i class="fa fa-stop"></i> 结束会议</button>
                        </td>
                    </tr>`;
                });
                html += '</tbody></table>';
                list.innerHTML = html;
            } catch (e) { console.error(e); }
        }

        async function loadMessages() {
            try {
                const res = await fetch('/api/admin/messages?limit=100');
                const data = await res.json();
                document.getElementById('statMessages').textContent = data.total;
                document.getElementById('statHidden').textContent = data.hiddenCount;
                const list = document.getElementById('messagesList');
                if (data.messages.length === 0) { list.innerHTML = '<div class="empty">暂无消息</div>'; return; }
                let html = '';
                data.messages.reverse().forEach(m => {
                    const time = new Date(m.timestamp).toLocaleString();
                    let content = '';
                    if (m.recalled) {
                        content = '<em style="color:#999;">[已撤回] ' + (m.type === 'voice' ? '语音消息' : m.type === 'image' ? '图片消息' : m.type === 'video' ? '视频消息' : (m.originalContent || '消息')) + '</em>';
                    } else if (m.type === 'image') content = '<img src="' + m.content + '">';
                    else if (m.type === 'video') content = '<video src="' + m.content + '" controls playsinline webkit-playsinline style="max-width:200px;max-height:200px;border-radius:4px;"></video>';
                    else if (m.type === 'voice') content = '[语音 ' + (m.duration||0) + '秒]';
                    else if (m.type === 'system') content = '<em>' + m.content + '</em>';
                    else content = m.content;
                    const hiddenClass = (m.hidden || m.banned) ? ' hidden' : '';
                    const hiddenBadge = (m.hidden || m.banned) ? ' <span class="badge badge-hidden">已隐藏</span>' : '';
                    const recalledBadge = m.recalled ? ' <span class="badge" style="background:#999;color:#fff;">已撤回</span>' : '';
                    html += `<div class="msg-item${hiddenClass}">
                        <div style="flex:1;">
                            <div class="msg-meta">
                                <strong>${m.name || '系统'}</strong> · ${time} ${hiddenBadge} ${recalledBadge}
                                ${m.socketId ? '<br>Socket: ' + m.socketId : ''}
                            </div>
