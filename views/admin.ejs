                        ${a.images && a.images.length ? `<div style="display:flex;gap:8px;margin-top:8px;">${a.images.map((src, i) => `<img src="${src}" onclick="previewAppealImgAdmin('${a.id}',${i})" style="width:90px;height:90px;object-fit:cover;border-radius:8px;cursor:zoom-in;">`).join('')}</div>` : ''}
