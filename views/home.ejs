            if (input) setTimeout(() => input.focus(), 100);
            // 打开时先展示最近记录
            runChatSearch();
        }

        // 判断消息是否命中关键词（kw 为空 = 全部命中）
        function matchChatRecordMsg(m, kw) {
            let text = '';
            if (m.recalled || m.adminHidden || m.banned || m.hidden) text = '[已撤回]';
            else if (m.type === 'voice') text = '[语音]';
            else if (m.type === 'image') text = '[图片]';
            else if (m.type === 'video') text = '[视频]';
            else if (m.type === 'call') text = '[通话] ' + (m.content || '');
            else if (m.type === 'bg-invite') text = '[聊天背景邀请]';
            else text = String(m.content || '');
            if (!kw) return true;
            return text.toLowerCase().includes(kw);
        }

        // 执行搜索并渲染结果
        function runChatSearch() {
            const peerName = chatSearchPeer;
            if (!peerName) return;
            const input = document.getElementById('chatSearchInput');
            const wrap = document.getElementById('chatSearchResults');
            if (!wrap) return;
            const kw = (input ? input.value.trim() : '').toLowerCase();

            const results = [];
            // 1) 私聊记录（本地缓存包含全部历史）
            const privMsgs = privateMsgsCache[peerName] || [];
            privMsgs.forEach(m => {
                if (matchChatRecordMsg(m, kw)) results.push({ scene: 'private', msg: m });
            });
            // 2) 该用户在群聊中发送的消息（群聊本地缓存）
            let groupCache = [];
            try { groupCache = JSON.parse(localStorage.getItem('chatHistoryCache')) || []; } catch (e) { groupCache = []; }
            groupCache.forEach(m => {
                const sender = m.senderName || m.name;
                if (sender !== peerName) return;
                if (m.type === 'system') return;
                if (matchChatRecordMsg(m, kw)) results.push({ scene: 'group', msg: m });
            });

            // 按时间倒序，最多展示 100 条
            results.sort((a, b) => (b.msg.timestamp || 0) - (a.msg.timestamp || 0));
            const shown = results.slice(0, 100);

            if (!shown.length) {
                wrap.innerHTML = '<div style="text-align:center;color:#999;padding:24px 0;">没有找到相关记录</div>';
                return;
            }
            wrap.innerHTML = shown.map(r => {
                const m = r.msg;
                const sender = r.scene === 'private' ? m.sender : (m.senderName || m.name || '');
                const typeTag = r.scene === 'private'
                    ? '<span style="background:#e8f0fe;color:#5765ec;font-size:11px;padding:1px 6px;border-radius:8px;margin-right:6px;">私聊</span>'
                    : '<span style="background:#f0f9eb;color:#07c160;font-size:11px;padding:1px 6px;border-radius:8px;margin-right:6px;">群聊</span>';
                return `<div onclick="locateChatRecord('${r.scene}','${m.id}')" style="padding:8px 6px;border-bottom:1px solid #f5f5f5;cursor:pointer;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2px;">
                        <span style="font-size:12px;">${typeTag}<b>${escapeHtml(sender || '?')}</b></span>
                        <span style="font-size:11px;color:#999;">${m.timestamp ? new Date(m.timestamp).toLocaleString() : '-'}</span>
                    </div>
                    <div style="font-size:13px;color:#555;word-break:break-all;">${escapeHtml(getChatRecordPreview(m)).slice(0, 60)}</div>
                </div>`;
            }).join('');
        }

        // 获取记录预览文本
        function getChatRecordPreview(m) {
            if (m.recalled || m.adminHidden || m.banned || m.hidden) return '[已撤回]';
            if (m.type === 'voice') return '[语音]';
            if (m.type === 'image') return '[图片]';
            if (m.type === 'video') return '[视频]';
            if (m.type === 'call') return '[通话] ' + (m.content || '');
            if (m.type === 'bg-invite') return '[聊天背景邀请]';
            return String(m.content || '').replace(/\n/g, ' ');
        }

        // 点击搜索结果：定位到原消息
        async function locateChatRecord(scene, msgId) {
            closeModal();
            if (scene === 'private') {
                // 打开（或复用）私聊页后滚动定位
                const wrap = document.getElementById('privateChatWrap');
                const alreadyOpen = wrap && wrap.classList.contains('show') && currentPrivatePeer === chatSearchPeer;
                if (!alreadyOpen) await openPrivateChat(chatSearchPeer);
                else await loadPrivateMessagesFromServer(chatSearchPeer), renderPrivateMessages(chatSearchPeer);
                setTimeout(() => scrollToPrivateMsg(msgId, chatSearchPeer), 300);
            } else {
                // 关闭私聊覆盖层，回到群聊视图定位
                closePrivateChat();
                setTimeout(() => scrollToMsg(msgId), 100);
            }
        }

        // ===== 暗色模式 =====
        function initTheme() {
            const mode = localStorage.getItem('themeMode') || 'system';
            applyTheme(mode);
            updateThemeLabel(mode);
            // 监听系统主题变化（跟随系统模式时自动切换）
            if (window.matchMedia) {
                const mql = window.matchMedia('(prefers-color-scheme: dark)');
                if (mql.addEventListener) mql.addEventListener('change', () => {
                    const cur = localStorage.getItem('themeMode') || 'system';
                    if (cur === 'system') applyTheme('system');
                });
                else if (mql.addListener) mql.addListener(() => {
                    const cur = localStorage.getItem('themeMode') || 'system';
                    if (cur === 'system') applyTheme('system');
                });
            }
            // Android 端注入：系统主题切换时由原生 onConfigurationChanged 调用此回调
            // 某些 Android WebView 上 prefers-color-scheme 媒体查询不触发，需要原生主动通知
            window.__onSystemThemeChange = function(isDark) {
                const cur = localStorage.getItem('themeMode') || 'system';
                if (cur === 'system') {
                    document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
                }
            };
        }
        function getEffectiveTheme(mode) {
            if (mode === 'system') {
                return (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
            }
            return mode;
        }
        function applyTheme(mode) {
            const effective = getEffectiveTheme(mode);
            document.documentElement.setAttribute('data-theme', effective);
        }
        function updateThemeLabel(mode) {
            const label = document.getElementById('themeCurrentLabel');
            if (!label) return;
            const labels = { system: '跟随系统', light: '浅色', dark: '深色' };
            label.textContent = labels[mode] || '跟随系统';
        }
        function showThemePicker() {
            const cur = localStorage.getItem('themeMode') || 'system';
            const html = `<div class="modal-title">暗色模式</div>
                <div class="modal-content">
                    <div class="theme-selector">
                        <div class="theme-option ${cur==='system'?'active':''}" onclick="setTheme('system')">
                            <span class="theme-option-label"><i class="fa fa-adjust"></i>跟随系统</span>
                            <i class="fa fa-check theme-option-check"></i>
                        </div>
                        <div class="theme-option ${cur==='light'?'active':''}" onclick="setTheme('light')">
                            <span class="theme-option-label"><i class="fa fa-sun-o"></i>浅色</span>
                            <i class="fa fa-check theme-option-check"></i>
                        </div>
                        <div class="theme-option ${cur==='dark'?'active':''}" onclick="setTheme('dark')">
                            <span class="theme-option-label"><i class="fa fa-moon-o"></i>深色</span>
                            <i class="fa fa-check theme-option-check"></i>
                        </div>
                    </div>
                </div>
                <div class="modal-buttons"><button class="modal-btn cancel" onclick="closeModal()">关闭</button></div>`;
            showModal(html);
        }
        function setTheme(mode) {
            localStorage.setItem('themeMode', mode);
            applyTheme(mode);
            updateThemeLabel(mode);
            // 更新弹窗中的选中状态
            document.querySelectorAll('.theme-option').forEach(el => el.classList.remove('active'));
            const target = document.querySelector(`.theme-option[onclick="setTheme('${mode}')"]`);
            if (target) target.classList.add('active');
        }

        // ===== 聊天背景功能 =====
        let bgPickerPeer = null;       // 当前正在选择背景的好友
        let bgPickerFullData = null;   // 背景选择页中暂存的原图 dataUrl

        // 打开背景选择页
        function openChatBgPicker(peerName) {
            bgPickerPeer = peerName;
            bgPickerFullData = null;
            let wrap = document.getElementById('chatBgPickerOverlay');
            if (!wrap) {
                wrap = document.createElement('div');
                wrap.id = 'chatBgPickerOverlay';
                wrap.className = 'bg-picker-overlay';
                document.body.appendChild(wrap);
            }
            const hasBg = !!localStorage.getItem('chatBg_' + peerName);
            wrap.innerHTML = `
                <div class="bg-picker-header">
                    <i class="fa fa-angle-left back-btn" onclick="closeChatBgPicker()"></i>
                    <span class="title">聊天背景</span>
                </div>
                <div class="bg-picker-body">
                    <div class="bg-preview" id="bgPreview">
                        <div class="placeholder">
                            <i class="fa fa-image"></i>
                            点击下方按钮选择图片
                        </div>
                    </div>
                    <div class="bg-actions">
                        <button class="bg-btn outline" onclick="document.getElementById('chatBgFileInput').click()">
                            <i class="fa fa-photo"></i> 选择图片
                        </button>
                        <button class="bg-btn primary" id="bgApplySelfBtn" onclick="applyChatBgSelf()" disabled>仅自己更换</button>
                        <button class="bg-btn secondary" id="bgInviteBtn" onclick="sendChatBgInvite()" disabled>邀请对方一起更换</button>
                        <button class="bg-btn danger" id="bgClearBtn" onclick="clearChatBg()" style="display:${hasBg?'block':'none'}">清除当前背景</button>
                        <button class="bg-btn outline" id="bgResetBtn" onclick="resetChatBgBoth()" style="display:${hasBg?'block':'none'}">恢复默认（双方）</button>
                    </div>
                    <p class="bg-picker-hint">
                        "仅自己更换"只改变你看到的背景<br>
                        "邀请对方一起更换"会发送邀请消息<br>
                        对方同意后双方都会更换背景
                    </p>
                </div>
                <input type="file" id="chatBgFileInput" accept="image/*" style="display:none" onchange="onChatBgPhotoSelected(this)">
            `;
            wrap.style.display = 'flex';
            void wrap.offsetWidth;
            requestAnimationFrame(() => wrap.classList.add('show'));
            if (!history.state || history.state.view !== 'bgPicker') {
                history.pushState({ view: 'bgPicker', peer: peerName }, '');
            }
        }

        function closeChatBgPicker() {
            const wrap = document.getElementById('chatBgPickerOverlay');
            if (wrap && wrap.classList.contains('show')) {
                wrap.classList.remove('show');
                wrap.classList.add('closing');
                const done = () => {
                    wrap.style.display = 'none';
                    wrap.classList.remove('closing');
                    wrap.removeEventListener('transitionend', done);
                };
                wrap.addEventListener('transitionend', done);
                setTimeout(() => { if (wrap.classList.contains('closing')) { wrap.style.display = 'none'; wrap.classList.remove('closing'); } }, 500);
            }
            bgPickerPeer = null;
            bgPickerFullData = null;
            if (history.state && history.state.view === 'bgPicker') history.back();
        }

        // 选择图片后打开裁切器（9:16 竖屏裁切）
        async function onChatBgPhotoSelected(input) {
            const file = input.files[0];
            if (!file) return;
            try {
                // 先压缩到合理尺寸
                const fullDataUrl = await compressImage(file, 1080, 0.85);
                openBgCropper(fullDataUrl);
            } catch(e) {
                showToast('图片加载失败', 'error');
            }
            input.value = '';
        }

        // ===== 图片裁切器（9:16 竖屏，支持拖动+双指缩放）=====
        let bgCropState = { img: null, x: 0, y: 0, scale: 1, minScale: 1, imgW: 0, imgH: 0, frameW: 0, frameH: 0 };
        function openBgCropper(dataUrl) {
            let wrap = document.getElementById('bgCropOverlay');
            if (!wrap) {
                wrap = document.createElement('div');
                wrap.id = 'bgCropOverlay';
                wrap.className = 'bg-crop-overlay';
                document.body.appendChild(wrap);
            }
            wrap.innerHTML = `
                <div class="bg-crop-header">
                    <button class="btn" onclick="closeBgCropper()">取消</button>
                    <span class="title">裁切背景（9:16）</span>
                    <button class="btn primary" onclick="confirmBgCropper()">完成</button>
                </div>
                <div class="bg-crop-stage">
                    <div class="bg-crop-frame" id="bgCropFrame">
                        <img id="bgCropImg" src="${dataUrl}">
                    </div>
                </div>
                <div class="bg-crop-tip">拖动调整位置 · 双指缩放 · 双击还原</div>
            `;
            wrap.classList.add('show');
            const img = document.getElementById('bgCropImg');
            img.onload = () => {
                initBgCropper();
            };
        }
        function initBgCropper() {
            const img = document.getElementById('bgCropImg');
            const frame = document.getElementById('bgCropFrame');
            const frameW = frame.clientWidth;
            const frameH = frame.clientHeight;
            const imgW = img.naturalWidth;
            const imgH = img.naturalHeight;
            // 默认以 cover 方式填满（保持比例，居中）
            const scaleCover = Math.max(frameW / imgW, frameH / imgH);
            const minScale = scaleCover;  // 不允许缩小到小于 cover（避免黑边）
            const initScale = scaleCover;
            // 居中
            const x = (frameW - imgW * initScale) / 2;
            const y = (frameH - imgH * initScale) / 2;
            bgCropState = { img, x, y, scale: initScale, minScale, imgW, imgH, frameW, frameH };
            applyBgCropTransform();
            bindBgCropGestures();
        }
        function applyBgCropTransform() {
            const { img, x, y, scale } = bgCropState;
            if (!img) return;
            img.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
        }
        function clampBgCropPos() {
            const { imgW, imgH, scale, frameW, frameH } = bgCropState;
            const dispW = imgW * scale;
            const dispH = imgH * scale;
            // 图片必须完全覆盖 frame（不允许露出黑边）
            let minX = Math.min(0, frameW - dispW);
            let maxX = Math.max(0, frameW - dispW);
            let minY = Math.min(0, frameH - dispH);
            let maxY = Math.max(0, frameH - dispH);
            bgCropState.x = Math.max(minX, Math.min(maxX, bgCropState.x));
            bgCropState.y = Math.max(minY, Math.min(maxY, bgCropState.y));
        }
        function bindBgCropGestures() {
            const frame = document.getElementById('bgCropFrame');
            // 移除旧监听（避免重复绑定）
            frame._panHandler && frame.removeEventListener('pointerdown', frame._panHandler);
            let lastX = 0, lastY = 0;
            let dragging = false;
            // 双指缩放
            let pinchStartDist = 0, pinchStartScale = 1;
            const getDist = (touches) => {
                const dx = touches[0].clientX - touches[1].clientX;
                const dy = touches[0].clientY - touches[1].clientY;
                return Math.hypot(dx, dy);
            };
            frame.ontouchstart = (e) => {
                if (e.touches.length === 2) {
                    pinchStartDist = getDist(e.touches);
                    pinchStartScale = bgCropState.scale;
                    dragging = false;
                } else if (e.touches.length === 1) {
                    dragging = true;
                    lastX = e.touches[0].clientX;
                    lastY = e.touches[0].clientY;
                }
            };
            frame.ontouchmove = (e) => {
                e.preventDefault();
                if (e.touches.length === 2 && pinchStartDist > 0) {
                    const dist = getDist(e.touches);
                    let s = pinchStartScale * (dist / pinchStartDist);
                    bgCropState.scale = Math.max(bgCropState.minScale, Math.min(s, 5));
                    clampBgCropPos();
                    applyBgCropTransform();
                } else if (e.touches.length === 1 && dragging) {
                    const dx = e.touches[0].clientX - lastX;
                    const dy = e.touches[0].clientY - lastY;
                    bgCropState.x += dx;
                    bgCropState.y += dy;
                    clampBgCropPos();
                    applyBgCropTransform();
                    lastX = e.touches[0].clientX;
                    lastY = e.touches[0].clientY;
                }
            };
            frame.ontouchend = (e) => {
                if (e.touches.length < 2) pinchStartDist = 0;
                if (e.touches.length === 0) dragging = false;
            };
            // 鼠标拖动（电脑端）
            let mouseDown = false;
            frame.onmousedown = (e) => {
                mouseDown = true; lastX = e.clientX; lastY = e.clientY;
            };
            frame.onmousemove = (e) => {
                if (!mouseDown) return;
                const dx = e.clientX - lastX;
                const dy = e.clientY - lastY;
                bgCropState.x += dx;
                bgCropState.y += dy;
                clampBgCropPos();
                applyBgCropTransform();
                lastX = e.clientX; lastY = e.clientY;
            };
            frame.onmouseup = () => { mouseDown = false; };
            frame.onmouseleave = () => { mouseDown = false; };
            // 鼠标滚轮缩放（电脑端）
            frame.onwheel = (e) => {
                e.preventDefault();
                let s = bgCropState.scale - e.deltaY * 0.001;
                bgCropState.scale = Math.max(bgCropState.minScale, Math.min(s, 5));
                clampBgCropPos();
                applyBgCropTransform();
            };
            // 双击还原
            frame.ondblclick = () => {
                bgCropState.scale = bgCropState.minScale;
                bgCropState.x = (bgCropState.frameW - bgCropState.imgW * bgCropState.scale) / 2;
                bgCropState.y = (bgCropState.frameH - bgCropState.imgH * bgCropState.scale) / 2;
                applyBgCropTransform();
            };
        }
        function closeBgCropper() {
            const wrap = document.getElementById('bgCropOverlay');
            if (wrap) wrap.classList.remove('show');
        }
        // 完成裁切：用 Canvas 截取当前可见区域，生成 9:16 的最终图
        function confirmBgCropper() {
            const { img, x, y, scale, imgW, imgH, frameW, frameH } = bgCropState;
            if (!img) { closeBgCropper(); return; }
            // 计算源图中对应的裁切区域
            const srcX = -x / scale;
            const srcY = -y / scale;
            const srcW = frameW / scale;
            const srcH = frameH / scale;
            // 限制在图片范围内
            const sx = Math.max(0, Math.min(srcX, imgW - srcW));
            const sy = Math.max(0, Math.min(srcY, imgH - srcH));
            const sw = Math.min(srcW, imgW - sx);
            const sh = Math.min(srcH, imgH - sy);
            const canvas = document.createElement('canvas');
            // 输出尺寸：宽度 720，高度按 9:16 = 1280
            const outW = 720;
            const outH = Math.round(outW * (frameH / frameW));
            canvas.width = outW;
            canvas.height = outH;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#000';
            ctx.fillRect(0, 0, outW, outH);
            ctx.drawImage(img, sx, sy, sw, sh, 0, 0, outW, outH);
            const dataUrl = canvas.toDataURL('image/jpeg', 0.82);
            bgPickerFullData = dataUrl;
            const preview = document.getElementById('bgPreview');
            if (preview) preview.innerHTML = `<img src="${dataUrl}">`;
            document.getElementById('bgApplySelfBtn').disabled = false;
            document.getElementById('bgInviteBtn').disabled = false;
            closeBgCropper();
            showToast('已裁切，可点击"仅自己更换"或"邀请对方"', 'info');
        }

        // 仅自己更换
        async function applyChatBgSelf() {
            if (!bgPickerPeer || !bgPickerFullData) return;
            const peer = bgPickerPeer;
            setChatBackground(peer, bgPickerFullData);
            localStorage.setItem('chatBg_' + peer, bgPickerFullData);
            // 同步上传缩略图到服务器（供管理员查看）
            try {
                const thumb = await makeThumbnail(bgPickerFullData, 200, 0.6);
                await fetch('/api/chat/upload-bg', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userName: myName, peer, thumb })
                });
            } catch(e) { console.warn('背景缩略图上传失败', e); }
            showToast('背景已更换', 'info');
            // 关闭背景选择器后返回私聊页（而非首页）
            closeChatBgPickerAndReturnToChat(peer);
        }

        // 邀请对方一起更换
        async function sendChatBgInvite() {
            if (bannedFromChat) { showToast('你已被禁言，无法邀请更换背景', 'error'); return; }
            if (!bgPickerPeer || !bgPickerFullData) return;
            const peer = bgPickerPeer;
            const fullData = bgPickerFullData;
            // 生成缩略图（200px 宽，质量 0.6）
            const thumb = await makeThumbnail(fullData, 200, 0.6);
            // 自己先设置背景
            setChatBackground(peer, fullData);
            localStorage.setItem('chatBg_' + peer, fullData);
            // 备份原图，供对方同意后本地使用
            localStorage.setItem('chatBgInviteFull_' + peer, fullData);
            // 同步上传缩略图到服务器（供管理员查看）
            try {
                await fetch('/api/chat/upload-bg', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userName: myName, peer, thumb })
                });
            } catch(e) { console.warn('背景缩略图上传失败', e); }
            // 发送邀请消息（content = JSON {thumb, full}）
            const content = JSON.stringify({ thumb, full: fullData });
            await sendPrivateMessageOfType('bg-invite', content);
            showToast('邀请已发送，等待对方确认', 'info');
            // 关闭背景选择器后返回私聊页（而非首页）
            closeChatBgPickerAndReturnToChat(peer);
        }

        // 关闭背景选择器并返回私聊页（而非首页）
        function closeChatBgPickerAndReturnToChat(peer) {
            const wrap = document.getElementById('chatBgPickerOverlay');
            if (wrap && wrap.classList.contains('show')) {
                wrap.classList.remove('show');
                wrap.classList.add('closing');
                const done = () => {
                    wrap.style.display = 'none';
                    wrap.classList.remove('closing');
                    wrap.removeEventListener('transitionend', done);
                };
                wrap.addEventListener('transitionend', done);
                setTimeout(() => { if (wrap.classList.contains('closing')) { wrap.style.display = 'none'; wrap.classList.remove('closing'); } }, 500);
            }
            bgPickerPeer = null;
            bgPickerFullData = null;
            // 不调用 history.back()，而是确保私聊页仍然打开
            if (currentPrivatePeer !== peer) {
                openPrivateChat(peer);
            } else {
                // 私聊页已打开，只需清除 bgPicker 的 history state
                if (history.state && history.state.view === 'bgPicker') history.back();
            }
        }

        // 生成缩略图工具函数
        function makeThumbnail(srcDataUrl, maxSize, quality) {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.onload = () => {
                    let { width, height } = img;
                    if (width > height) { height = Math.round(height * maxSize / width); width = maxSize; }
                    else { width = Math.round(width * maxSize / height); height = maxSize; }
                    const canvas = document.createElement('canvas');
                    canvas.width = width; canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, width, height);
                    ctx.drawImage(img, 0, 0, width, height);
                    resolve(canvas.toDataURL('image/jpeg', quality));
                };
                img.onerror = () => reject(new Error('缩略图生成失败'));
                img.src = srcDataUrl;
            });
        }

        // 接受背景邀请（从消息缓存中获取原图数据）
        async function acceptChatBgInvite(msgId, peerName) {
            const msgs = privateMsgsCache[peerName] || [];
            const msg = msgs.find(m => m.id === msgId);
            if (!msg || msg.type !== 'bg-invite') { showToast('邀请数据缺失', 'error'); return; }
            let bgData = {};
            try { bgData = JSON.parse(msg.content); } catch(e) {}
            if (!bgData.full) { showToast('背景数据缺失', 'error'); return; }
            setChatBackground(peerName, bgData.full);
            localStorage.setItem('chatBg_' + peerName, bgData.full);
            // 同步上传缩略图到服务器（供管理员查看）
            try {
                const thumb = await makeThumbnail(bgData.full, 200, 0.6);
                await fetch('/api/chat/upload-bg', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userName: myName, peer: peerName, thumb })
                });
            } catch(e) { console.warn('背景缩略图上传失败', e); }
            // 调用 bg-reply API 只更新原邀请消息状态，不产生新消息
            try {
                await fetch('/api/friends/bg-reply', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ from: myName, to: peerName, msgId, status: 'accepted' })
                });
            } catch(e) { console.warn('背景邀请回复失败', e); }
            // 本地更新邀请消息状态为"已接受"（对方视角：您已接受）
            updateBgInviteMsgStatus(msgId, peerName, 'accepted');
            showToast('已接受背景邀请', 'info');
        }

        // 拒绝背景邀请
        async function rejectChatBgInvite(msgId, peerName) {
            // 调用 bg-reply API 只更新原邀请消息状态，不产生新消息
            try {
                await fetch('/api/friends/bg-reply', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ from: myName, to: peerName, msgId, status: 'rejected' })
                });
            } catch(e) { console.warn('背景邀请回复失败', e); }
            // 本地更新邀请消息状态为"已拒绝"（对方视角：您已拒绝）
            updateBgInviteMsgStatus(msgId, peerName, 'rejected');
        }

        // 更新邀请消息状态并重新渲染
        function updateBgInviteMsgStatus(msgId, peerName, status) {
            const msgs = privateMsgsCache[peerName] || [];
            const msg = msgs.find(m => m.id === msgId);
            if (msg) {
                msg.bgStatus = status;
                savePrivateMsgsCache();
                renderPrivateMessages(peerName);
            }
        }

        // 设置/清除聊天背景（DOM 层）
        function setChatBackground(peerName, dataUrl) {
            const body = document.getElementById('privateChatBody');
            if (!body) return;
            if (dataUrl) {
                // 图片已按 9:16 裁切，用 cover 保持比例填满私聊区域；fixed 让背景不随消息滚动
                body.style.backgroundImage = `url("${dataUrl}")`;
                body.style.backgroundSize = 'cover';
                body.style.backgroundPosition = 'center';
                body.style.backgroundRepeat = 'no-repeat';
                body.style.backgroundAttachment = 'fixed';
            } else {
                body.style.backgroundImage = '';
                body.style.backgroundSize = '';
                body.style.backgroundPosition = '';
                body.style.backgroundRepeat = '';
                body.style.backgroundAttachment = '';
            }
        }

        // 清除背景
        function clearChatBg() {
            if (!bgPickerPeer) return;
            const peer = bgPickerPeer;
            localStorage.removeItem('chatBg_' + peer);
            setChatBackground(peer, null);
            // 同步清除服务器记录
            fetch('/api/chat/clear-bg', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userName: myName, peer })
            }).catch(()=>{});
            showToast('背景已清除', 'info');
            closeChatBgPickerAndReturnToChat(peer);
        }

        // 恢复默认背景（双方同步，无需对方确认）
        async function resetChatBgBoth() {
            if (!bgPickerPeer) return;
            const peer = bgPickerPeer;
            // 自己先清除
            localStorage.removeItem('chatBg_' + peer);
            localStorage.removeItem('chatBgInviteFull_' + peer);
            setChatBackground(peer, null);
            // 同步清除服务器记录
            fetch('/api/chat/clear-bg', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userName: myName, peer })
            }).catch(()=>{});
            // 发送 bg-reset 消息给对方，对方收到后自动清除
            await sendPrivateMessageOfType('bg-reset', 'reset');
            showToast('已恢复默认背景（双方）', 'info');
            closeChatBgPickerAndReturnToChat(peer);
        }

        // 预览背景缩略图（通过 msgId 从消息缓存中获取图片）
        function previewBgThumb(msgId) {
            let dataUrl = '';
            // 在所有好友的消息缓存中查找该消息
            for (const peer in privateMsgsCache) {
                const msg = (privateMsgsCache[peer] || []).find(m => m.id === msgId);
                if (msg && msg.type === 'bg-invite') {
                    try { dataUrl = JSON.parse(msg.content).thumb || ''; } catch(e) {}
                    break;
                }
            }
            if (!dataUrl) return;
            let preview = document.getElementById('imagePreview');
            if (!preview) {
                preview = document.createElement('div');
                preview.id = 'imagePreview';
                preview.className = 'image-preview';
                preview.innerHTML = `<img><i class="fa fa-times image-preview-close" onclick="closeImagePreview()"></i>`;
                document.body.appendChild(preview);
            }
            preview.querySelector('img').src = dataUrl;
            showImagePreview();
        }
        function confirmDeleteFriend(peerName) {
            const html = `<div class="modal-title">删除好友</div>
                <div class="modal-content"><p style="text-align:center;color:#666;">确定删除好友"${escapeHtml(peerName)}"吗？删除后将无法互发消息。</p></div>
                <div class="modal-buttons">
                    <button class="modal-btn cancel" onclick="closeModal()">取消</button>
                    <button class="modal-btn confirm" onclick="doDeleteFriend('${peerName}')" style="background:#fa5151;color:#fff;">删除</button>
                </div>`;
            showModal(html);
        }
        async function doDeleteFriend(peerName) {
            try {
                await fetch('/api/friends/delete?from=' + encodeURIComponent(myName) + '&to=' + encodeURIComponent(peerName), { method: 'DELETE' });
                showToast('已删除好友', 'info');
                closeModal();
                closePrivateChat();
                loadFriendsList();
            } catch(e) { showToast('删除失败', 'error'); }
        }
        async function startCallWithFriend(peerName, callType) {
            closeModal();
            callType = callType || 'voice';
            // 禁言/禁用会议检查：被禁言或禁用会议功能的用户不能发起私聊通话
            if (bannedFromChat) { showToast('你已被禁言，无法发起通话', 'error'); return; }
            if (bannedFromMeeting) { showToast('你已被禁用会议功能，无法发起通话', 'error'); return; }
            // 复用现有的通话流程：把 peerName 当作在线成员呼叫
            // 检查在线状态
            const f = myFriends.find(f => f.name === peerName);
            if (!f || !f.online) { showToast('对方不在线', 'error'); return; }
            // 标记为私聊通话，通话结束后写入私聊消息（而非公用聊天室）
            localStorage.setItem('privateCallPeer', peerName);
            // 直接对好友发起呼叫（不走选择用户弹窗），传 isPrivateCall=true 防止 inviteCall 清除 privateCallPeer
            if (f.socketId) {
                inviteCall({ socketId: f.socketId, name: peerName, avatar: f.avatar, color: getUserColorByName(peerName) }, callType, true);
            } else {
                // 通过 online-users API 拿 socketId
                try {
                    const res = await fetch('/api/chat/online-users');
                    const data = await res.json();
                    const u = (data.users || []).find(u => u.name === peerName);
                    if (u) inviteCall(u, callType, true);
                    else showToast('对方不在线', 'error');
                } catch(e) { showToast('获取在线信息失败', 'error'); }
            }
        }

        // 工具函数
        function formatTimeShort(ts) {
            if (!ts) return '';
            const d = new Date(ts);
            const now = new Date();
            if (d.toDateString() === now.toDateString()) {
                return d.toTimeString().slice(0,5);
            }
            return (d.getMonth()+1) + '/' + d.getDate();
        }
        function escapeHtml(s) {
            if (!s) return '';
            return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        }
        // 简化版 showModal（如果不存在）
        function showModal(html) {
            let mask = document.getElementById('modalMask');
            if (!mask) {
                mask = document.createElement('div');
                mask.id = 'modalMask';
                mask.className = 'modal-mask';
                document.body.appendChild(mask);
                // 点击遮罩层空白处关闭（模拟微信侧滑返回）
                mask.addEventListener('click', (e) => {
                    if (e.target === mask) closeModal();
                });
            }
            mask.innerHTML = `<div class="modal-box">${html}</div>`;
            mask.classList.add('show');
            mask.style.display = 'flex';
            // 推入历史栈，让 Android 返回键能关闭弹窗（避免直接退出 App）
            if (!history.state || history.state.view !== 'modal') {
                history.pushState({ view: 'modal' }, '');
            }
        }
        function closeModal() {
            const mask = document.getElementById('modalMask');
            if (mask) {
                mask.classList.remove('show');
                mask.style.display = 'none';
            }
            // 如果当前历史栈是 modal，回退一格保持栈一致
            if (history.state && history.state.view === 'modal') {
                history.back();
            }
        }
        // 仅隐藏弹窗不回退历史栈：用于弹窗切换场景（如三个点菜单 → 聊天背景页），
        // 避免 closeModal 的 history.back() 触发迟到的 popstate 把新打开的页面关掉
        function hideModalMask() {
            const mask = document.getElementById('modalMask');
            if (mask) {
                mask.classList.remove('show');
                mask.style.display = 'none';
            }
        }

        // ===== Android 返回键处理（popstate）=====
        // 按返回键时根据当前栈状态关闭对应 UI，而不是直接退出 App
        window.addEventListener('popstate', () => {
            // 图片预览关闭引起的历史返回：不关闭底层页面（预览已在前面的监听中关闭）
            if (popstateGuard) { popstateGuard = false; return; }
            const state = history.state || {};
            const mask = document.getElementById('modalMask');
            const imgPreviewMask = document.getElementById('imagePreview');
            const publicWrap = document.getElementById('publicChatWrap');
            const privateWrap = document.getElementById('privateChatWrap');
            const bgPicker = document.getElementById('chatBgPickerOverlay');
            // 优先级：图片预览 > 弹窗 > 背景选择页 > 私聊 > 公用聊天室
            if (imgPreviewMask && imgPreviewMask.classList.contains('show')) {
                imgPreviewMask.classList.remove('show');
                resetPreviewTransform();
                return;
            }
            if (mask && mask.classList.contains('show')) {
                mask.classList.remove('show');
                mask.style.display = 'none';
            } else if (bgPicker && bgPicker.classList.contains('show')) {
                bgPicker.classList.remove('show');
                bgPicker.classList.add('closing');
                const done = () => {
                    bgPicker.style.display = 'none';
                    bgPicker.classList.remove('closing');
                    bgPicker.removeEventListener('transitionend', done);
                };
                bgPicker.addEventListener('transitionend', done);
                setTimeout(() => { if (bgPicker.classList.contains('closing')) { bgPicker.style.display = 'none'; bgPicker.classList.remove('closing'); } }, 500);
                bgPickerPeer = null;
                bgPickerFullData = null;
            } else if (privateWrap && privateWrap.classList.contains('show')) {
                // 触发退出动画
                privateWrap.classList.remove('show');
                privateWrap.classList.add('closing');
                const done = () => {
                    privateWrap.style.display = 'none';
                    privateWrap.classList.remove('closing');
                    privateWrap.removeEventListener('transitionend', done);
                };
                privateWrap.addEventListener('transitionend', done);
                setTimeout(() => { if (privateWrap.classList.contains('closing')) { privateWrap.style.display = 'none'; privateWrap.classList.remove('closing'); } }, 500);
                currentPrivatePeer = null;
            } else if (publicWrap && publicWrap.style.display !== 'none') {
                publicWrap.style.display = 'none';
                // 关闭可能打开的加号/表情面板，避免侧滑返回后残留
                closePlusPanel();
                closeEmojiPanel();
            }
        });
        // 预览图片（私聊）
        function previewPrivateImage(msgId) {
            // 简化版预览
            const body = document.getElementById('privateChatBody');
            if (!body) return;
            const item = body.querySelector(`img[data-msg-id="${msgId}"]`) || body.querySelector(`[data-msg-id="${msgId}"] img`);
            if (item) {
                const mask = document.getElementById('imagePreview');
                if (mask) {
                    // 复用公用聊天室的预览组件（含侧滑返回关闭支持）
                    document.getElementById('previewImg').src = item.src;
                    showImagePreview();
                } else {
                    const w = window.open('', '_blank');
                    if (w) w.document.write(`<img src="${item.src}" style="max-width:100%;">`);
                }
            }
        }

        // 修改头像/名字（设置页）
        function changeAvatar() { document.getElementById('avatarInput') && document.getElementById('avatarInput').click(); }
        function changeName() { 
            const newName = prompt('请输入新名字', myName);
            if (newName && newName.trim() && newName !== myName) {
                // 复用现有的改名逻辑
                if (typeof renameUser === 'function') renameUser(newName.trim());
                else { localStorage.setItem('userName', newName.trim()); location.reload(); }
            }
        }
    </script>
</body>

</html>
