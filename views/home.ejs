        });
        socket.on('reconnect', () => {
            console.log('Socket 已重连');
            mySocketId = socket.id;
            if (myName) socket.emit('chat-login', { name: myName, userId: myUserId });
            // 重连后立即增量同步一次，确保不漏消息
            loadServerMessagesIncremental();
        });

        // ===== HTTP 持续轮询兜底机制 =====
        // 不依赖 disconnect 事件：无论 socket 状态如何，持续每 2 秒通过 HTTP 增量同步消息
        // 这样即使 socket 看似连接但推送丢失，也能通过 HTTP 获取新消息
        function startHttpPolling() {
            if (httpPollingTimer) return;  // 已在轮询中
            // 每 2 秒轮询一次（接近实时体验，外网 socket 推送不可靠时由 HTTP 兜底）
            httpPollingTimer = setInterval(pollLatestMessages, 2000);
            console.log('[HTTP轮询] 持续轮询已启动，每 2 秒同步一次');
            // 1 秒后首次执行（等待页面初始化完成）
            setTimeout(pollLatestMessages, 1000);
        }

        // 停止轮询（页面卸载时）
        function stopHttpPolling() {
            if (httpPollingTimer) {
                clearInterval(httpPollingTimer);
                httpPollingTimer = null;
                console.log('[HTTP轮询] 已停止');
            }
        }

        // 通过 HTTP fetch 增量同步最新消息（只获取 lastReceivedMsgTimestamp 之后的消息）
        async function pollLatestMessages() {
            if (isHttpPolling) return;  // 防止重叠请求
            isHttpPolling = true;
            try {
                // 并行获取最新消息和待处理来电
                const [msgRes, callRes] = await Promise.all([
                    fetch('/api/chat/history?limit=500&after=' + lastReceivedMsgTimestamp),
                    myName ? fetch('/api/call/pending?userName=' + encodeURIComponent(myName)) : null
                ]);
                // 处理消息
                if (msgRes && msgRes.ok) {
                    const data = await msgRes.json();
                    if (data.messages && data.messages.length > 0) {
                        syncMessages(data.messages);
                        for (const m of data.messages) {
                            if (m.timestamp > lastReceivedMsgTimestamp) {
                                lastReceivedMsgTimestamp = m.timestamp;
                            }
                        }
                        console.log('[HTTP轮询] 同步到 ' + data.messages.length + ' 条新消息');
                    }
                }
                // 处理待处理来电
                if (callRes && callRes.ok) {
                    const callData = await callRes.json();
                    if (callData.invites && callData.invites.length > 0) {
                        callData.invites.forEach(invite => {
                            // 只处理当前未显示通话弹窗的来电
                            if (!currentCall || currentCall.callId !== invite.callId) {
                                console.log('[HTTP轮询] 收到来电: ' + invite.fromName);
                                // 更新在线用户信息（来电方可能不在本地列表中）
                                if (invite.from && invite.from !== 'http-fallback') {
                                    onlineUsers[invite.from] = {
                                        socketId: invite.from,
                                        name: invite.fromName,
                                        avatar: avatarByName[invite.fromName] || null
                                    };
                                } else {
                                    // HTTP 兜底场景下来电方 socketId 未知，用 fromName 作为临时标识
                                    onlineUsers[invite.fromName] = {
                                        socketId: invite.fromName,
                                        name: invite.fromName,
                                        avatar: avatarByName[invite.fromName] || null
                                    };
                                }
                                showIncomingCall(invite);
                            }
                        });
                    }
                }
            } catch (e) {
                console.error('[HTTP轮询] 失败', e.message);
            } finally {
                isHttpPolling = false;
            }
        }

        // 增量加载服务端消息（重连后立即调用）
        async function loadServerMessagesIncremental() {
            try {
                const url = '/api/chat/history?limit=500&after=' + lastReceivedMsgTimestamp;
                const res = await fetch(url);
                if (!res.ok) return;
                const data = await res.json();
                if (data.messages && data.messages.length > 0) {
                    syncMessages(data.messages);
                    for (const m of data.messages) {
                        if (m.timestamp > lastReceivedMsgTimestamp) {
                            lastReceivedMsgTimestamp = m.timestamp;
                        }
                    }
                }
            } catch (e) {
                console.error('增量加载失败', e);
            }
        }

        socket.on('chat-history', (data) => {
            // 增量同步：不清空列表，只追加新消息并同步撤回状态
            syncMessages(data.messages || []);
            // 检查是否有未完成的通话总结
            checkPendingCallSummary();
            // 检测是否有进行中的通话（用户从 room 页返回聊天页）
            checkActiveCall();
        });

        socket.on('chat-message', (msg) => {
            appendMessage(msg);
            // 更新最新消息时间戳（用于 HTTP 轮询兜底的增量同步）
            if (msg.timestamp && msg.timestamp > lastReceivedMsgTimestamp) {
                lastReceivedMsgTimestamp = msg.timestamp;
            }
        });

        socket.on('chat-online-users', (data) => {
            onlineUsers = {};
            data.users.forEach(u => {
                onlineUsers[u.socketId] = u;
                if (u.name && u.avatar) avatarByName[u.name] = u.avatar;  // 填充头像缓存
                if (u.socketId === mySocketId) {
                    myColor = u.color;
                    if (u.avatar) { myAvatar = u.avatar; updateNavAvatar(); }
