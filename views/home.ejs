        let nameProtectCheckTimer = null;
        function debounceNameProtectCheck() {
            if (nameProtectCheckTimer) clearTimeout(nameProtectCheckTimer);
            nameProtectCheckTimer = setTimeout(async () => {
                const name = document.getElementById('nameInput').value.trim();
                const pwInput = document.getElementById('namePasswordInput');
                if (!name) { pwInput.style.display = 'none'; return; }
                const protectedName = await checkNameProtected(name);
                // 输入可能已变化，重新比对
