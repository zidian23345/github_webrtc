        <div class="nav-right">
            <!-- 加好友按钮（联系人页才显示） -->
            <i class="fa fa-user-plus nav-members-btn" id="navAddFriendBtn" style="display:none" onclick="showAddFriendModal()"></i>
            <!-- 当前用户头像，点击查看主页 -->
            <div class="nav-avatar" id="navAvatar" onclick="viewMyProfile()" title="点击查看我的主页"></div>
        </div>
    </div>

    <!-- ===== 页面：消息（含公用聊天室入口 + 好友会话列表）===== -->
    <div class="page-container" id="pageChat">
        <!-- 进入公用聊天室按钮 -->
        <div class="chat-room-entry" onclick="enterPublicChatRoom()">
            <div class="entry-avatar"><i class="fa fa-comments"></i></div>
            <div class="entry-info">
                <div class="entry-name">公用聊天室</div>
                <div class="entry-desc" id="chatRoomDesc">点击进入群聊</div>
            </div>
            <i class="fa fa-angle-right entry-arrow"></i>
        </div>
        <!-- 好友会话列表 -->
        <div class="friend-sessions" id="friendSessions">
            <!-- 动态渲染好友会话 -->
        </div>
    </div>

    <!-- ===== 页面：联系人 ===== -->
    <div class="page-container" id="pageFriends" style="display:none">
        <!-- 联系人页顶部入口：添加好友 / 好友请求 -->
