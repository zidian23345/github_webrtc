                pendingLoginPassword = inputPassword || '';  // 校验通过后本机记住
                socket.emit('chat-login', { name: newName, password: inputPassword });
                closeNameModal();
                showToast('名称已设置');
                return;
            }
            try {
                const res = await fetch('/api/chat/rename', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ newName, socketId: mySocketId })
                });
                const data = await res.json();
                if (data.success) {
                    myName = newName;
                    nameLockedUntil = data.nameLockedUntil;
