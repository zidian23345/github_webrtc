    </div>

    <!-- 左侧成员抽屉遮罩 -->
    <div class="drawer-overlay" id="drawerOverlay" onclick="closeMembersDrawer()"></div>
    <!-- 左侧成员抽屉 -->
    <div class="members-drawer" id="membersDrawer">
        <div class="drawer-header">
            <div>
                <div class="drawer-title">聊天成员</div>
                <div class="drawer-summary" id="drawerSummary">在线 0 人 / 共 0 人</div>
            </div>
            <i class="fa fa-times drawer-close" onclick="closeMembersDrawer()"></i>
