        function onAppealImagesSelected(input) {
            const files = Array.from(input.files || []);
            input.value = '';
            const room = APPEAL_MAX_IMAGES - appealDraftImages.length;
            if (room <= 0) { showToast('图片最多 ' + APPEAL_MAX_IMAGES + ' 张', 'error'); return; }
            const take = files.slice(0, room);
            if (files.length > room) showToast('图片最多 ' + APPEAL_MAX_IMAGES + ' 张，已忽略多余图片', 'error');
            take.forEach(f => {
                if (!f.type.startsWith('image/')) return;
                const reader = new FileReader();
                reader.onload = async (e) => {
                    try {
                        const compressed = await compressImageForAppeal(e.target.result);
                        appealDraftImages.push(compressed);
