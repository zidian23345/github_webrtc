        // ===== 账号密码：登录被拒（名称受保护） =====
        // 未输入密码：重置名称并弹回名称弹窗（密码框会自动显示）
        socket.on('login-password-required', (data) => {
            handleLoginPasswordRejected(data && data.userName, '该名称已设置密码，请输入密码或换个名称');
        });
        // 密码错误：同样重置，提示密码错误
        socket.on('login-password-wrong', (data) => {
            handleLoginPasswordRejected(data && data.userName, '密码错误，请重新输入或换个名称');
        });
        // 密码校验通过：本机记住密码，刷新/重连免重输
        socket.on('login-password-ok', (data) => {
            if (data && data.userName && data.userName === myName && pendingLoginPassword) {
                localStorage.setItem('meetingUserPassword', pendingLoginPassword);
                pendingLoginPassword = '';
                updatePasswordStatusLabel();
            }
        });
        let pendingLoginPassword = '';
        function handleLoginPasswordRejected(userName, tipMsg) {
            // 仅处理当前登录名称（防止过期事件误伤）
            if (userName && myName && userName !== myName) return;
            // 回滚本地名称，回到注册状态
            myName = null;
            localStorage.removeItem('meetingUserName');
            localStorage.removeItem('meetingUserPassword');
            showToast(tipMsg || '该名称需要密码验证', 'error');
            setTimeout(() => openNameModal(), 400);
        }

        // ===== HTTP 持续轮询兜底机制 =====
        // 不依赖 disconnect 事件：无论 socket 状态如何，持续每 2 秒通过 HTTP 增量同步消息
        // 这样即使 socket 看似连接但推送丢失，也能通过 HTTP 获取新消息
        function startHttpPolling() {
            if (httpPollingTimer) return;  // 已在轮询中
            // 每 2 秒轮询一次（接近实时体验，外网 socket 推送不可靠时由 HTTP 兜底）
            httpPollingTimer = setInterval(pollLatestMessages, 2000);
            console.log('[HTTP轮询] 持续轮询已启动，每 2 秒同步一次');
            // 1 秒后首次执行（等待页面初始化完成）
            setTimeout(pollLatestMessages, 1000);
        }

        // 停止轮询（页面卸载时）
        function stopHttpPolling() {
            if (httpPollingTimer) {
                clearInterval(httpPollingTimer);
                httpPollingTimer = null;
                console.log('[HTTP轮询] 已停止');
            }
        }

        // 通过 HTTP fetch 增量同步最新消息（只获取 lastReceivedMsgTimestamp 之后的消息）
        async function pollLatestMessages() {
            if (isHttpPolling) return;  // 防止重叠请求
            isHttpPolling = true;
            try {
                // 并行获取最新消息和待处理来电
                const [msgRes, callRes] = await Promise.all([
                    fetch('/api/chat/history?limit=500&after=' + lastReceivedMsgTimestamp),
                    myName ? fetch('/api/call/pending?userName=' + encodeURIComponent(myName)) : null
                ]);
                // 处理消息
                if (msgRes && msgRes.ok) {
                    const data = await msgRes.json();
                    if (data.messages && data.messages.length > 0) {
                        syncMessages(data.messages);
                        for (const m of data.messages) {
                            if (m.timestamp > lastReceivedMsgTimestamp) {
                                lastReceivedMsgTimestamp = m.timestamp;
                            }
                        }
                        console.log('[HTTP轮询] 同步到 ' + data.messages.length + ' 条新消息');
                    }
                }
                // 处理待处理来电
                if (callRes && callRes.ok) {
                    const callData = await callRes.json();
                    if (callData.invites && callData.invites.length > 0) {
                        callData.invites.forEach(invite => {
                            // 只处理当前未显示通话弹窗的来电
                            if (!currentCall || currentCall.callId !== invite.callId) {
                                console.log('[HTTP轮询] 收到来电: ' + invite.fromName);
                                // 更新在线用户信息（来电方可能不在本地列表中）
                                if (invite.from && invite.from !== 'http-fallback') {
                                    onlineUsers[invite.from] = {
                                        socketId: invite.from,
                                        name: invite.fromName,
                                        avatar: avatarByName[invite.fromName] || null
                                    };
                                } else {
                                    // HTTP 兜底场景下来电方 socketId 未知，用 fromName 作为临时标识
                                    onlineUsers[invite.fromName] = {
                                        socketId: invite.fromName,
                                        name: invite.fromName,
                                        avatar: avatarByName[invite.fromName] || null
                                    };
                                }
                                showIncomingCall(invite);
                            }
                        });
                    }
                }
            } catch (e) {
                console.error('[HTTP轮询] 失败', e.message);
            } finally {
                isHttpPolling = false;
            }
        }

        // 增量加载服务端消息（重连后立即调用）
        async function loadServerMessagesIncremental() {
            try {
                const url = '/api/chat/history?limit=500&after=' + lastReceivedMsgTimestamp;
                const res = await fetch(url);
                if (!res.ok) return;
                const data = await res.json();
                if (data.messages && data.messages.length > 0) {
                    syncMessages(data.messages);
                    for (const m of data.messages) {
                        if (m.timestamp > lastReceivedMsgTimestamp) {
                            lastReceivedMsgTimestamp = m.timestamp;
                        }
                    }
                }
            } catch (e) {
                console.error('增量加载失败', e);
            }
        }

        socket.on('chat-history', (data) => {
            // 增量同步：不清空列表，只追加新消息并同步撤回状态
            syncMessages(data.messages || []);
            // 检查是否有未完成的通话总结
            checkPendingCallSummary();
            // 检测是否有进行中的通话（用户从 room 页返回聊天页）
            checkActiveCall();
        });

        socket.on('chat-message', (msg) => {
            appendMessage(msg);
            // 更新最新消息时间戳（用于 HTTP 轮询兜底的增量同步）
            if (msg.timestamp && msg.timestamp > lastReceivedMsgTimestamp) {
                lastReceivedMsgTimestamp = msg.timestamp;
            }
        });

        socket.on('chat-online-users', (data) => {
            onlineUsers = {};
            data.users.forEach(u => {
                onlineUsers[u.socketId] = u;
                if (u.name && u.avatar) avatarByName[u.name] = u.avatar;  // 填充头像缓存
                if (u.socketId === mySocketId) {
                    myColor = u.color;
                    if (u.avatar) { myAvatar = u.avatar; updateNavAvatar(); }
                }
            });
            updateOnlineCount(data.count);
            // 如果抽屉打开则刷新
            if (isMembersDrawerOpen()) renderMembersList();
        });

        socket.on('chat-user-joined', (data) => {
            onlineUsers[data.socketId] = data;
            if (data.name && data.avatar) avatarByName[data.name] = data.avatar;  // 填充头像缓存
            // 从离线缓存中移除（如果存在）
            offlineUsers.delete(data.socketId);
            updateOnlineCount(Object.keys(onlineUsers).length);
            if (isMembersDrawerOpen()) renderMembersList();
        });

        socket.on('chat-user-left', (data) => {
            // 移入离线缓存
            const u = onlineUsers[data.socketId];
            if (u) {
                offlineUsers.set(data.socketId, Object.assign({}, u, { leftAt: Date.now() }));
                // 限制离线用户数量
                if (offlineUsers.size > MAX_OFFLINE_USERS) {
                    const firstKey = offlineUsers.keys().next().value;
                    offlineUsers.delete(firstKey);
                }
            }
            delete onlineUsers[data.socketId];
            updateOnlineCount(Object.keys(onlineUsers).length);
            if (isMembersDrawerOpen()) renderMembersList();
        });

        // 在线成员更新（用户加入/离开时服务器广播，快速重连时只发这个事件）
        socket.on('online-members-update', (data) => {
            const prevIds = new Set(Object.keys(onlineUsers));
            const newIds = new Set(data.users.map(u => u.socketId));
            const newNames = new Set(data.users.map(u => u.name).filter(Boolean));
            // 把离开的移入离线缓存（仅当该用户名不在新在线列表中时才保留）
            prevIds.forEach(id => {
                if (!newIds.has(id) && onlineUsers[id]) {
                    const u = onlineUsers[id];
                    // 如果该用户名已在新在线列表中（说明是快速重连/刷新），不要把旧的移入离线
                    if (u.name && newNames.has(u.name)) return;
                    offlineUsers.set(id, Object.assign({}, u, { leftAt: Date.now() }));
                }
            });
            // 清理离线缓存中与新在线用户同名的条目（避免重复显示）
            for (const [id, u] of offlineUsers.entries()) {
                if (u.name && newNames.has(u.name)) {
                    offlineUsers.delete(id);
                }
            }
            // 限制离线缓存数量
            while (offlineUsers.size > MAX_OFFLINE_USERS) {
                const firstKey = offlineUsers.keys().next().value;
                offlineUsers.delete(firstKey);
            }
            // 重建在线列表
            onlineUsers = {};
            data.users.forEach(u => {
                onlineUsers[u.socketId] = u;
                if (u.name && u.avatar) avatarByName[u.name] = u.avatar;  // 填充头像缓存
                // 重新加入的从离线缓存中移除
                offlineUsers.delete(u.socketId);
                if (u.socketId === mySocketId) {
                    myColor = u.color;
                    if (u.avatar) { myAvatar = u.avatar; updateNavAvatar(); }
                }
            });
            updateOnlineCount(data.count);
            if (isMembersDrawerOpen()) renderMembersList();
        });

        socket.on('chat-user-renamed', (data) => {
            if (onlineUsers[data.socketId]) onlineUsers[data.socketId].name = data.newName;
            if (isMembersDrawerOpen()) renderMembersList();
        });

        // 头像变更通知
        socket.on('user-avatar-changed', (data) => {
            if (onlineUsers[data.socketId]) {
                onlineUsers[data.socketId].avatar = data.avatar;
                // 更新头像缓存（按 userName 索引）
                const u = onlineUsers[data.socketId];
                if (u.name && data.avatar) avatarByName[u.name] = data.avatar;
            }
            if (data.socketId === mySocketId) {
                myAvatar = data.avatar;
                updateNavAvatar();
            }
            // 更新该用户所有历史消息的头像
            updateMessagesAvatar(data.socketId, data.avatar);
            if (isMembersDrawerOpen()) renderMembersList();
        });

        // ===== 更新某用户所有历史消息的头像 =====
        function updateMessagesAvatar(socketId, avatar) {
            const owner = onlineUsers[socketId];
            const ownerName = owner ? owner.name : null;
            if (ownerName && avatar) avatarByName[ownerName] = avatar;  // 更新头像缓存
            const list = document.getElementById('chatList');
            // 遍历所有消息项，匹配 socketId 或 senderName
            list.querySelectorAll('.msg-item').forEach(item => {
                const msgId = item.dataset.msgId;
                if (!msgId) return;
                const msg = messagesMap[msgId];
                if (!msg) return;
                const isMatch = msg.socketId === socketId
                    || (ownerName && msg.senderName === ownerName)
                    || (ownerName && msg.name === ownerName);
                if (!isMatch) return;
                // 只更新 DOM，不更新 msg.avatar（消息不再存 avatar）
                const avatarEl = item.querySelector('.msg-avatar');
                if (!avatarEl) return;
                const color = msg.color || (msg.socketId === mySocketId ? myColor : '#5765ec');
                const initial = (msg.name || '?')[0].toUpperCase();
                if (avatar) {
                    avatarEl.style.background = color;
                    avatarEl.innerHTML = `<img src="${avatar}">`;
                } else {
                    avatarEl.style.background = color;
                    avatarEl.innerHTML = initial;
                }
            });
        }

        // 头像被禁用（普通提示）
        socket.on('avatar-blocked', (data) => {
            showToast(data && data.reason ? data.reason : '头像功能被禁用', 'error');
        });

        // 头像被管理员禁用
        socket.on('avatar-banned', () => {
            avatarBanned = true;
            showToast('你已被禁用换头像功能', 'error');
        });

        // 头像被解禁
        socket.on('avatar-unbanned', () => {
            avatarBanned = false;
            showToast('已解禁换头像功能');
        });

        // 聊天背景被管理员撤回（重置为默认）
        socket.on('chat-bg-reset-by-admin', (data) => {
            const peer = data && data.peer;
            if (!peer) return;
            localStorage.removeItem('chatBg_' + peer);
            localStorage.removeItem('chatBgInviteFull_' + peer);
            setChatBackground(peer, null);
            // 重新从服务端拉取私聊消息（含 bgRevoked 撤回标记和管理员重置系统消息）
            loadPrivateMessagesFromServer(peer).finally(() => {
                if (currentPrivatePeer === peer) {
                    showToast('管理员已重置你的聊天背景', 'info');
                    renderPrivateMessages(peer);
                }
            });
        });

        // 用户主页数据返回
        socket.on('profile-data', (data) => {
            showProfileModal(data);
        });

        // ===== 视频通话相关事件 =====
        // 收到来电
        socket.on('call-incoming', (data) => {
            // 被禁言用户收到通话邀请时自动拒绝（禁言期间不能参与通话）
            if (bannedFromChat) {
                socket.emit('call-reject', { callId: data.callId, reason: 'banned' });
                return;
            }
            showIncomingCall(data);
        });

        // 主叫收到被叫接听
        socket.on('call-accepted', (data) => {
            if (!currentCall || currentCall.callId !== data.callId) return;
            showToast(`${currentCall.name} 已接听`);
            // 记录通话开始时间到 localStorage，供 room 页面使用
            localStorage.setItem('callStartTime', String(Date.now()));
            localStorage.setItem('callPeerName', currentCall.name || '');
            localStorage.setItem('callType', currentCall.callType || 'voice');
            // 保存通话房间信息，供返回聊天页时显示通话状态横条
            localStorage.setItem('activeCallRoomId', currentCall.roomId || '');
            localStorage.setItem('activeCallPeerName', currentCall.name || '');
            localStorage.setItem('activeCallType', currentCall.callType || 'voice');
            // 私聊通话：主叫方在通话被接听时也补设 privateCallPeer（防止 inviteCall 后被其他逻辑清除）
            if (currentCall.isPrivateCall) {
                localStorage.setItem('privateCallPeer', currentCall.name || '');
                localStorage.setItem('callRole', 'caller');
            } else {
                localStorage.removeItem('privateCallPeer');
                localStorage.removeItem('callRole');
            }
            const roomId = currentCall.roomId;
            closeCallModal();
            // 通话开始：显示屏幕共享按钮
            nativeSetShareButtonVisible(true);
            // 跳转到房间
            window.location.href = `/room/${roomId}`;
        });

        // 主叫收到被叫拒绝
        socket.on('call-rejected', (data) => {
            if (!currentCall || currentCall.callId !== data.callId) {
                console.log('[通话] 收到拒绝但 callId 不匹配', data.callId, '当前:', currentCall?.callId);
                return;
            }
            const reason = data.reason || '对方已拒绝';
            const rejectedCallId = data.callId;
            console.log('[通话] 被拒绝:', reason);
            showToast(reason, 'error');
            document.getElementById('callStatus').textContent = reason;
            // 私聊通话被拒：生成"通话被拒绝"记录（主叫方生成，被叫方等推送）
            if (currentCall.isPrivateCall) {
                generatePrivateCallRecord(currentCall.toUserName, currentCall.callType, 0, 'rejected');
            }
            // 1.5 秒后关闭界面（校验 callId，避免误关新发起的通话）
            setTimeout(() => {
                if (!currentCall || currentCall.callId === rejectedCallId) {
                    closeCallModal();
                }
            }, 1500);
            currentCall = null;
            nativeSetShareButtonVisible(false);
        });

        // 通话被对方结束
        socket.on('call-ended', (data) => {
            if (!currentCall || currentCall.callId !== data.callId) return;
            const dur = data.duration || 0;
            const endedCallId = data.callId;
            showToast(`通话已结束，时长 ${dur} 秒`);
            document.getElementById('callStatus').textContent = `通话结束 · ${dur} 秒`;
            setTimeout(() => {
                if (!currentCall || currentCall.callId === endedCallId) {
                    closeCallModal();
                }
            }, 1500);
            currentCall = null;
            nativeSetShareButtonVisible(false);
        });

        // 被叫收到主叫取消
        socket.on('call-cancelled', (data) => {
            if (!currentCall || currentCall.callId !== data.callId) return;
            showToast('对方已取消呼叫');
            closeCallModal('cancel');  // 缩放淡出动画
            // 私聊通话：被叫方不生成记录（主叫方 cancelOutgoingCall 已生成并推送，避免重复）
            currentCall = null;
            nativeSetShareButtonVisible(false);
        });

        // 通话错误
        socket.on('call-error', (data) => {
            showToast(data.message || '通话出错', 'error');
            closeCallModal('cancel');  // 缩放淡出动画
            currentCall = null;
            nativeSetShareButtonVisible(false);
        });

        // 消息被撤回
        socket.on('message-recalled', (data) => {
            if (messagesMap[data.msgId]) messagesMap[data.msgId].recalled = true;
            updateLocalMessageField(data.msgId, 'recalled', true);
            updateMessageRecalled(data.msgId);
        });

        // 消息被隐藏
        socket.on('message-hidden', (data) => {
            updateMessageHidden(data.msgId, true);
            if (messagesMap[data.msgId]) messagesMap[data.msgId].hidden = true;
            updateLocalMessageField(data.msgId, 'hidden', true);
        });

        // 管理员删除单条消息
        socket.on('message-deleted', (data) => {
            const div = document.querySelector(`[data-msg-id="${data.msgId}"]`);
            if (div) div.remove();
            delete messagesMap[data.msgId];
            removeLocalMessage(data.msgId);
        });

        // 管理员清空所有消息
        socket.on('messages-cleared', () => {
            document.getElementById('chatList').innerHTML = '';
            messagesMap = {};
            clearLocalMessagesCache();
            showToast('管理员已清空所有消息');
        });

        // 消息恢复显示
        socket.on('message-shown', (data) => {
            updateMessageHidden(data.msgId, false);
            if (messagesMap[data.msgId]) messagesMap[data.msgId].hidden = false;
            updateLocalMessageField(data.msgId, 'hidden', false);
        });

        // 消息被拦截（违禁词/禁言）
        socket.on('message-blocked', (data) => {
            showToast(data.reason, 'error');
        });

        // 被封禁
        socket.on('user-banned', (banInfo) => {
            showBanBanner(banInfo);
            showToast(`你已被${banInfo.bannedFromChat ? '禁言' : ''}${banInfo.bannedFromMeeting ? '禁用会议功能' : ''}：${banInfo.reason}`, 'error');
        });

        // 被解封
        socket.on('user-unbanned', (data) => {
            hideBanBanner();
            showToast(`已解封：${data.reason}`);
        });

        // ===== 系统通知 =====
        let notificationsData = [];
        function getReadNotifIds() {
            try { return JSON.parse(localStorage.getItem('notifReadIds') || '[]'); }
            catch (e) { return []; }
        }
        function updateNotifBadge() {
            const readIds = new Set(getReadNotifIds());
            const unread = notificationsData.filter(n => !readIds.has(n.id)).length;
            const dot = document.getElementById('notifBadgeDot');
            if (dot) dot.classList.toggle('show', unread > 0);
        }
        function renderNotifList() {
            const list = document.getElementById('notifList');
            if (!notificationsData.length) {
                list.innerHTML = '<div class="notif-empty"><i class="fa fa-bell-slash-o"></i>暂无系统通知</div>';
                document.getElementById('notifSummary').textContent = '暂无通知';
                return;
            }
            const readIds = new Set(getReadNotifIds());
            const unread = notificationsData.filter(n => !readIds.has(n.id)).length;
            document.getElementById('notifSummary').textContent = `共 ${notificationsData.length} 条${unread > 0 ? ' · ' + unread + ' 条未读' : ''}`;
            list.innerHTML = notificationsData.map(n => {
                const isUnread = !readIds.has(n.id);
                const isBan = (n.title || '').includes('封禁');
                const icon = isBan ? 'fa-ban' : (n.target === 'all' ? 'fa-bullhorn' : 'fa-envelope');
                const tag = n.target === 'all' ? '<span class="notif-target-tag">全体</span>' : '<span class="notif-target-tag" style="color:#fa5151;background:rgba(250,81,81,0.1);">仅我</span>';
                return `<div class="notif-item${isUnread ? ' unread' : ''}${isBan ? ' ban-type' : ''}" onclick="showNotifDetail('${n.id}')">
                    <div class="notif-icon"><i class="fa ${icon}"></i></div>
                    <div class="notif-body">
                        <div class="notif-title">${escapeHtml(n.title || '系统通知')}${tag}</div>
                        <div class="notif-content">${escapeHtml(n.content || '')}</div>
                        <div class="notif-time">${formatNotifTime(n.createdAt)}</div>
                    </div>
                    <i class="fa fa-angle-right notif-arrow"></i>
                </div>`;
            }).join('');
        }
        // 通知详情弹窗：展示结构化详情（封禁生效/结束时间等）
        let currentNotifDetailId = null; // 当前详情弹窗展示的通知（用于实时刷新）
        function showNotifDetail(id) {
            const n = notificationsData.find(x => x.id === id);
            if (!n) return;
            currentNotifDetailId = id;
            const rows = [];
            const pushRow = (label, value, cls) => {
                if (value === undefined || value === null || value === '') return;
                rows.push(`<div class="notif-detail-row${cls ? ' ' + cls : ''}">
                    <div class="notif-detail-label">${label}</div>
                    <div class="notif-detail-value">${value}</div>
                </div>`);
            };
            const isBan = (n.title || '').includes('封禁');
            const m = n.meta || {};
            // 封禁类通知：展示封禁详情
            if (m.type === 'ban' || isBan) {
                const types = [m.bannedFromChat ? '禁言（不能发消息）' : null, m.bannedFromMeeting ? '禁用会议功能' : null].filter(Boolean).join(' + ') || '封禁';
                pushRow('封禁类型', escapeHtml(types));
                if (m.reason !== undefined) pushRow('封禁理由', escapeHtml(m.reason || '未提供'));
                if (m.bannedAt) pushRow('生效时间', formatNotifFullTime(m.bannedAt));
                if (m.expireAt) {
                    pushRow('结束时间', formatNotifFullTime(m.expireAt));
                } else {
                    pushRow('结束时间', '永久', 'warn');
                }
                // 当前状态：申诉通过/管理员解封/到期/封禁中
                if (m.unbannedByAppeal) {
                    pushRow('当前状态', '已解除（申诉通过）', 'ok');
                    if (m.unbannedAt) pushRow('解除时间', formatNotifFullTime(m.unbannedAt));
                } else if (m.unbannedByAdmin) {
                    pushRow('当前状态', '已解除（管理员解封）', 'ok');
                    if (m.unbannedAt) pushRow('解除时间', formatNotifFullTime(m.unbannedAt));
                } else if (m.expireAt) {
                    const left = m.expireAt - Date.now();
                    pushRow('当前状态', left <= 0 ? '已到期（自动解封）' : '封禁中 · 剩余 ' + formatRemainingText(left), left <= 0 ? 'ok' : 'warn');
                } else {
                    pushRow('当前状态', '永久封禁中', 'warn');
                }
            } else if (m.type === 'unban') {
                if (m.reason) pushRow('解封理由', escapeHtml(m.reason));
                if (m.unbannedAt) pushRow('解封时间', formatNotifFullTime(m.unbannedAt));
            } else if (m.type === 'appeal-result') {
                pushRow('申诉结果', m.result === 'approved' ? '已通过（封禁已解除）' : '已驳回', m.result === 'approved' ? 'ok' : 'warn');
                if (m.comment) pushRow('管理员意见', escapeHtml(m.comment));
            }
            pushRow('发送对象', n.target === 'all' ? '全体用户' : '仅我（' + escapeHtml(n.target) + '）');
            pushRow('发送时间', formatNotifFullTime(n.createdAt));
            document.getElementById('notifDetailTitle').textContent = n.title || '系统通知';
            document.getElementById('notifDetailContent').textContent = n.content || '';
            document.getElementById('notifDetailRows').innerHTML = rows.join('');
            // 封禁类通知：显示申诉按钮（有申诉记录时无论是否已解封都显示"查看我的申诉"；未申诉且封禁中才可提交）
