        // 进入公用聊天室
        function enterPublicChatRoom() {
            document.getElementById('publicChatWrap').style.display = 'flex';
            // 推入历史栈，让 Android 返回键先退出聊天室而不是退出 App
            if (!history.state || history.state.view !== 'publicChat') {
                history.pushState({ view: 'publicChat' }, '');
