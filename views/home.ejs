    </div>

    <!-- 用户主页弹窗 -->
    <div class="modal-mask" id="profileModal">
        <div class="modal-box">
            <div class="modal-title">用户主页</div>
            <div class="modal-content">
                <div class="profile-modal-content" id="profileContent"></div>
            </div>
