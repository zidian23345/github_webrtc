            requestAnimationFrame(() => wrap.classList.add('show'));
            // 推入历史栈，让 Android 返回键先退出私聊而不是退出 App
            if (!history.state || history.state.view !== 'privateChat') {
                history.pushState({ view: 'privateChat', peer: peerName }, '');
            }
            // 加载消息历史（先本地缓存，再服务端拉取最新）
            await loadPrivateMessagesFromServer(peerName);
