        // ===== 生成私聊通话记录（支持成功/被拒/取消三种状态）=====
        // outcome: 'completed' 已接通挂断 / 'rejected' 被拒绝 / 'cancelled' 已取消
        function generatePrivateCallRecord(peerName, callType, durationSec, outcome) {
            if (!peerName) return;
            const typeLabel = callType === 'video' ? '视频通话' : '语音通话';
            let content;
            if (outcome === 'rejected') {
                content = `${typeLabel} · 通话被拒绝`;
            } else if (outcome === 'cancelled') {
                content = `${typeLabel} · 通话已取消`;
            } else {
                content = `${typeLabel} ${formatCallDuration(durationSec)}`;
            }
            // 本地显示
            if (!privateMsgsCache[peerName]) privateMsgsCache[peerName] = [];
            const msg = {
                id: crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2),
                type: 'call', sender: myName, content,
                duration: outcome === 'completed' ? durationSec : 0,
                callType, callOutcome: outcome,  // callOutcome 标记通话结果
                timestamp: Date.now()
            };
            // 去重：同一秒内不重复添加相同 outcome 的记录
            if (privateMsgsCache[peerName].some(m => m.type === 'call' && m.callOutcome === outcome && Math.abs(m.timestamp - msg.timestamp) < 1500)) {
                return;
            }
            privateMsgsCache[peerName].push(msg);
            savePrivateMsgsCache();
            if (currentPrivatePeer === peerName) renderPrivateMessages(peerName);
            // 推送到服务端
            fetch('/api/friends/message', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    from: myName, to: peerName, type: 'call', content,
                    duration: msg.duration, callType,
                    callOutcome: outcome,  // 透传通话结果
                    id: msg.id, timestamp: msg.timestamp
                })
            }).catch(e => console.error('发送私聊通话记录失败', e));
        }

        // ===== 检查是否有未完成的通话总结 =====
        // 从 room 页面返回时，若 callEnded=1 则发送通话记录消息（微信风格）
        function checkPendingCallSummary() {
            const ended = localStorage.getItem('callEnded');
            if (ended !== '1') return;
            localStorage.removeItem('callEnded');
            const startTimeStr = localStorage.getItem('callStartTime');
            if (!startTimeStr) return;
            const startMs = parseInt(startTimeStr);
            localStorage.removeItem('callStartTime');
            const peerName = localStorage.getItem('callPeerName') || '';
            localStorage.removeItem('callPeerName');
            const callType = localStorage.getItem('callType') || 'voice';
            localStorage.removeItem('callType');
            // 检查是否为私聊通话
            const privatePeer = localStorage.getItem('privateCallPeer');
            const callRole = localStorage.getItem('callRole') || '';
            localStorage.removeItem('privateCallPeer');
            localStorage.removeItem('callRole');
            // 以当前时间作为通话结束时间
            const durationSec = Math.floor((Date.now() - startMs) / 1000);
            if (durationSec < 3) return;  // 太短忽略
            // 私聊通话：发送到私聊会话（仅主叫方生成记录，被叫方等推送避免重复）
            if (privatePeer && privatePeer !== '') {
                if (callRole === 'callee') {
                    // 被叫方：不生成记录，等待主叫方通过 /api/friends/message 推送
                    return;
                }
                // 使用统一的通话记录生成函数（标记为已完成）
                generatePrivateCallRecord(privatePeer, callType, durationSec, 'completed');
                return;
            }
            // 公用聊天室通话：发送 call 类型消息到服务器（像普通消息一样广播+持久化）
            socket.emit('chat-send-message', {
                type: 'call',
                content: '',
                callType,
                peerName,
                callDuration: durationSec
            });
        }

        // 格式化通话时长为 HH:MM:SS
        function formatCallDuration(seconds) {
            const h = String(Math.floor(seconds / 3600)).padStart(2, '0');
            const m = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
            const s = String(seconds % 60).padStart(2, '0');
            return `${h}:${m}:${s}`;
        }

