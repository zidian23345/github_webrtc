        // ===== 私聊版发送媒体（图片/视频）=====
        async function sendPrivateMediaMessage(input) {
            const files = input.files;
            if (!files || !files.length) { closePrivatePlusPanel(); return; }
            closePrivatePlusPanel();
            openMediaPicker(files, 'private');
            input.value = '';
        }

        async function sendPrivateMessageOfType(type, content) {
            if (!currentPrivatePeer) return;
            // 禁言检查：所有私聊消息（含图片/视频/语音/通话记录/背景邀请等）都受禁言限制
            if (bannedFromChat) { showToast('你已被禁言，无法发送消息', 'error'); return; }
            const peer = currentPrivatePeer;
            const msg = {
                id: crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2),
                type, sender: myName, content, duration: 0, timestamp: Date.now()
            };
            if (!privateMsgsCache[peer]) privateMsgsCache[peer] = [];
            privateMsgsCache[peer].push(msg);
            savePrivateMsgsCache();
            renderPrivateMessages(peer);
            try {
                await fetch('/api/friends/message', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ from: myName, to: peer, type, content, id: msg.id, timestamp: msg.timestamp })
                });
            } catch(e) { showToast('发送失败', 'error'); }
        }

        // 渲染私聊消息
        function renderPrivateMessages(peerName) {
            const body = document.getElementById('privateChatBody');
            if (!body) return;
            const msgs = privateMsgsCache[peerName] || [];
            // 渲染私聊消息，并按 5 分钟间隔插入时间分隔符（与公用聊天室一致）
            let lastPrivateTs = null;
            const htmlParts = [];
            msgs.forEach(m => {
                // 时间分隔符：首条消息 或 距上一条超过 5 分钟
                if (!lastPrivateTs || (m.timestamp - lastPrivateTs) >= TIME_GAP_MS) {
                    htmlParts.push(`<div class="time-divider"><span>${formatTimeDivider(m.timestamp)}</span></div>`);
                }
                lastPrivateTs = m.timestamp;
                // 管理员重置背景：居中灰色小方块提示（时间分割线样式，无头像无气泡）
                if (m.type === 'bg-reset-by-admin') {
                    htmlParts.push(`<div class="system-msg"><span><i class="fa fa-shield"></i> 管理员已重置你们的聊天背景</span></div>`);
                    return;
                }
                const isSelf = (m.sender === myName);
                const color = getUserColorByName(m.sender);
                // 头像：优先用 avatarByName 缓存的真实头像，其次用好友列表中的头像，最后用首字母
                const avatarSrc = avatarByName[m.sender] || (myFriends.find(f => f.name === m.sender) || {}).avatar || null;
                let avatarHtml;
                if (avatarSrc) {
                    avatarHtml = `<div class="msg-avatar" style="background:${color}"><img src="${avatarSrc}"></div>`;
                } else {
                    avatarHtml = `<div class="msg-avatar" style="background:${color}">${escapeHtml(m.sender.charAt(0))}</div>`;
                }
                // 管理员隐藏的消息：显示红色"已被撤回"提示（与公用聊天室一致）
                if (m.adminHidden) {
                    htmlParts.push(`<div class="msg-item ${isSelf ? 'self' : ''}">
                        ${avatarHtml}
                        <div class="msg-content-wrap">
                            <div class="msg-name">${escapeHtml(m.sender)}</div>
                            <div class="msg-bubble hidden-msg" data-msg-id="${m.id}"><span style="color:#c62828;font-style:italic;">消息不符合规定已被撤回</span></div>
                            <div class="msg-time">${formatTimeShort(m.timestamp)}</div>
                        </div>
                    </div>`);
                    return;
                }
                let contentHtml;
                if (m.type === 'image') {
                    contentHtml = `<img src="${m.content}" data-msg-id="${m.id}" style="max-width:180px;max-height:180px;border-radius:4px;cursor:pointer;" onclick="previewPrivateImage('${m.id}')">`;
                } else if (m.type === 'voice') {
                    contentHtml = `<div class="voice-msg" onclick="playPrivateVoice('${m.id}','${peerName}')"><i class="fa fa-play-circle voice-icon"></i><span class="voice-duration">${m.duration || 0}"</span></div>`;
                } else if (m.type === 'video') {
                    contentHtml = `<a href="${m.content}" target="_blank" style="color:#5765ec;"><i class="fa fa-play-circle"></i> [视频消息]</a>`;
                } else if (m.type === 'call') {
                    // 通话记录消息：复用公用聊天室 .call-msg 样式
                    // 支持 callOutcome: 'completed' 已完成 / 'rejected' 被拒绝 / 'cancelled' 已取消
                    const isVideo = m.callType === 'video';
                    const typeLabel = isVideo ? '视频通话' : '语音通话';
                    const peer = escapeHtml(peerName);
                    const outcome = m.callOutcome || (m.duration ? 'completed' : 'completed');
                    let iconClass, bgClass, statusText, durationHtml;
                    if (outcome === 'rejected') {
                        iconClass = 'fa fa-phone';
                        bgClass = 'voice';
                        statusText = '通话被拒绝';
                        durationHtml = '';
                    } else if (outcome === 'cancelled') {
                        iconClass = 'fa fa-phone';
                        bgClass = 'voice';
                        statusText = '通话已取消';
                        durationHtml = '';
                    } else {
                        iconClass = isVideo ? 'fa fa-video-camera' : 'fa fa-phone';
                        bgClass = isVideo ? 'video' : 'voice';
                        statusText = typeLabel;
                        const duration = m.duration ? formatCallDuration(m.duration) : '';
                        durationHtml = duration ? `<div class="call-duration">时长 ${duration}</div>` : '';
                    }
                    contentHtml = `<div class="call-msg">
                        <div class="call-icon ${bgClass}"><i class="${iconClass}"></i></div>
                        <div class="call-text">
                            <div>${isSelf ? '与 ' + peer + ' ' + statusText : peer + ' ' + statusText}</div>
                            ${durationHtml}
                        </div>
                    </div>`;
                } else if (m.type === 'bg-invite') {
                    // 背景邀请消息：显示缩略图 + 同意/拒绝按钮
                    // 被管理员撤回后：显示灰色斜体提示（与撤回消息样式一致）
                    if (m.bgRevoked) {
                        contentHtml = `<span style="color:#999;font-style:italic;"><i class="fa fa-ban"></i> 背景邀请已被管理员撤回</span>`;
                        const revokeBubbleStyle = ' style="background:transparent;"';
                        htmlParts.push(`<div class="msg-item ${isSelf ? 'self' : ''}">
                            ${avatarHtml}
                            <div class="msg-content-wrap">
                                <div class="msg-name">${escapeHtml(m.sender)}</div>
                                <div class="msg-bubble" data-msg-id="${m.id}"${revokeBubbleStyle}>${contentHtml}</div>
                                <div class="msg-time">${formatTimeShort(m.timestamp)}</div>
                            </div>
                        </div>`);
                        return;
                    }
                    let bgData = {};
                    try { bgData = JSON.parse(m.content); } catch(e) {}
                    const thumb = bgData.thumb || '';
                    const status = m.bgStatus || 'pending';
                    if (isSelf) {
                        // 自己发出的邀请
                        if (status === 'accepted') {
                            contentHtml = `<div class="bg-invite-card"><div class="bg-invite-text">邀请对方一起更换背景</div>${thumb ? `<img class="bg-invite-thumb" src="${thumb}" onclick="previewBgThumb('${m.id}')">` : ''}<div class="bg-invite-status accepted"><i class="fa fa-check"></i> 对方已接受</div></div>`;
                        } else if (status === 'rejected') {
                            contentHtml = `<div class="bg-invite-card"><div class="bg-invite-text">邀请对方一起更换背景</div>${thumb ? `<img class="bg-invite-thumb" src="${thumb}" onclick="previewBgThumb('${m.id}')">` : ''}<div class="bg-invite-status rejected"><i class="fa fa-times"></i> 对方已拒绝</div></div>`;
                        } else {
                            contentHtml = `<div class="bg-invite-card"><div class="bg-invite-text">邀请对方一起更换背景</div>${thumb ? `<img class="bg-invite-thumb" src="${thumb}" onclick="previewBgThumb('${m.id}')">` : ''}<div class="bg-invite-status">等待对方确认...</div></div>`;
                        }
                    } else {
                        // 对方发来的邀请
                        if (status === 'accepted') {
                            contentHtml = `<div class="bg-invite-card"><div class="bg-invite-text">邀请你一起更换聊天背景</div>${thumb ? `<img class="bg-invite-thumb" src="${thumb}" onclick="previewBgThumb('${m.id}')">` : ''}<div class="bg-invite-status accepted"><i class="fa fa-check"></i> 已接受</div></div>`;
                        } else if (status === 'rejected') {
                            contentHtml = `<div class="bg-invite-card"><div class="bg-invite-text">邀请你一起更换聊天背景</div>${thumb ? `<img class="bg-invite-thumb" src="${thumb}" onclick="previewBgThumb('${m.id}')">` : ''}<div class="bg-invite-status rejected"><i class="fa fa-times"></i> 已拒绝</div></div>`;
                        } else {
                            contentHtml = `<div class="bg-invite-card"><div class="bg-invite-text">邀请你一起更换聊天背景</div>${thumb ? `<img class="bg-invite-thumb" src="${thumb}" onclick="previewBgThumb('${m.id}')">` : ''}<div class="bg-invite-actions"><button class="bg-invite-btn accept" onclick="acceptChatBgInvite('${m.id}','${peerName}')">接受</button><button class="bg-invite-btn reject" onclick="rejectChatBgInvite('${m.id}','${peerName}')">拒绝</button></div></div>`;
                        }
                    }
                } else if (m.type === 'bg-accepted') {
                    contentHtml = `<div class="bg-invite-card"><div class="bg-invite-status accepted"><i class="fa fa-check"></i> ${isSelf ? '对方已接受背景邀请' : '已接受背景邀请'}</div></div>`;
                } else if (m.type === 'bg-rejected') {
                    contentHtml = `<div class="bg-invite-card"><div class="bg-invite-status rejected"><i class="fa fa-times"></i> ${isSelf ? '对方已拒绝更换背景' : '已拒绝背景邀请'}</div></div>`;
                } else if (m.type === 'bg-reset') {
                    contentHtml = `<div class="bg-invite-card"><div class="bg-invite-status"><i class="fa fa-refresh"></i> ${isSelf ? '已恢复默认背景（双方）' : '对方已恢复默认背景'}</div></div>`;
                } else if (m.type === 'bg-reset-by-admin') {
                    contentHtml = `<div class="bg-invite-card"><div class="bg-invite-status rejected"><i class="fa fa-shield"></i> 管理员已重置你的聊天背景</div></div>`;
                } else {
                    contentHtml = escapeHtml(m.content || '');
                }
                // 撤回消息：居中浅灰色小方框提示（类似时间分隔线，无头像无气泡）
                if (m.recalled) {
                    const recallText = isSelf ? '你撤回了一条消息' : '对方撤回了一条消息';
                    htmlParts.push(`<div class="msg-item recall-item"><div class="recall-tip"><span>${recallText}</span></div></div>`);
                    return;
                }
                // 引用消息：在气泡顶部显示引用预览
                let quoteHtml = '';
                if (m.quote && m.quote.content) {
                    const qName = escapeHtml(m.quote.name || '匿名');
                    const qContent = escapeHtml(m.quote.content);
                    quoteHtml = `<div class="msg-quote" onclick="scrollToPrivateMsg('${m.quote.id}','${peerName}')">
                        <span class="quote-name">${qName}：</span>${qContent}
                    </div>`;
                }
                // 通话消息气泡使用和公用聊天室一致的白色背景样式（微信风格）
                const isCallMsg = m.type === 'call';
                const bubbleStyle = isCallMsg ? ' style="background:#fff;color:#888;min-width:180px;"' : '';
                const bubbleClass = isCallMsg ? 'msg-bubble call-bubble' : 'msg-bubble';
                htmlParts.push(`<div class="msg-item ${isSelf ? 'self' : ''}">
                    ${avatarHtml}
                    <div class="msg-content-wrap">
                        <div class="msg-name">${escapeHtml(m.sender)}</div>
                        <div class="${bubbleClass}"${bubbleStyle} data-msg-id="${m.id}">${quoteHtml}${contentHtml}</div>
                        <div class="msg-time">${formatTimeShort(m.timestamp)}</div>
                    </div>
                </div>`);
            });
            body.innerHTML = htmlParts.join('');
            // 绑定长按/右键菜单（排除 bg-invite 卡片内的按钮，避免冲突）
            body.querySelectorAll('.msg-bubble[data-msg-id]').forEach(bubble => {
                const msgId = bubble.getAttribute('data-msg-id');
                // 右键菜单（电脑端）
                bubble.addEventListener('contextmenu', (e) => {
                    e.preventDefault();
                    showPrivateContextMenu(e.clientX, e.clientY, msgId, peerName);
                });
                // 长按菜单（手机端）
                let touchTimer = null;
                bubble.addEventListener('touchstart', (e) => {
                    touchTimer = setTimeout(() => {
                        if (touchTimer) {
                            const touch = e.touches[0];
                            showPrivateContextMenu(touch.clientX, touch.clientY, msgId, peerName);
                            touchTimer = null;
                        }
                    }, 500);
                }, { passive: true });
                bubble.addEventListener('touchend', () => { if (touchTimer) { clearTimeout(touchTimer); touchTimer = null; } });
                bubble.addEventListener('touchmove', () => { if (touchTimer) { clearTimeout(touchTimer); touchTimer = null; } });
            });
            body.scrollTop = body.scrollHeight;
        }

        // 播放私聊语音消息
        function playPrivateVoice(msgId, peerName) {
            const msgs = privateMsgsCache[peerName] || [];
            const msg = msgs.find(m => m.id === msgId);
            if (!msg || !msg.content) { showToast('语音消息不存在', 'error'); return; }
            // 在私聊体内查找包含该 msgId 的语音元素
            const allVoice = document.querySelectorAll('#privateChatBody .voice-msg');
            let targetDiv = null;
            allVoice.forEach(el => {
                if (el.getAttribute('onclick') && el.getAttribute('onclick').indexOf(msgId) >= 0) {
                    targetDiv = el;
                }
            });
            const icon = targetDiv && targetDiv.querySelector('.voice-icon');
            // 点击的是当前消息：切换播放/暂停
            if (currentVoiceMsgId === msgId && currentVoiceAudio) {
                if (currentVoiceAudio.paused) {
                    currentVoiceAudio.play();
                    if (icon) icon.className = 'fa fa-pause-circle voice-icon';
                    if (targetDiv) targetDiv.classList.add('playing');
                } else {
                    currentVoiceAudio.pause();
                    if (icon) icon.className = 'fa fa-play-circle voice-icon';
                    if (targetDiv) targetDiv.classList.remove('playing');
                }
                return;
            }
            // 切换到新消息，先停止旧的
            stopCurrentVoice();
            const audio = new Audio(msg.content);
            if (icon) icon.className = 'fa fa-pause-circle voice-icon';
            if (targetDiv) targetDiv.classList.add('playing');
            currentVoiceAudio = audio;
            currentVoiceMsgId = msgId;
            audio.play().catch(() => {
                resetVoiceUi(msgId);
                showToast('语音播放失败', 'error');
                currentVoiceAudio = null;
                currentVoiceMsgId = null;
            });
            audio.onended = () => {
                resetVoiceUi(msgId);
                currentVoiceAudio = null;
                currentVoiceMsgId = null;
            };
            audio.onerror = () => {
                resetVoiceUi(msgId);
                showToast('语音播放失败', 'error');
                currentVoiceAudio = null;
                currentVoiceMsgId = null;
            };
        }

        // 发送私聊消息
        async function sendPrivateMessage() {
            if (!currentPrivatePeer) return;
            if (bannedFromChat) { showToast('你已被禁言，无法发送消息', 'error'); return; }
            const input = document.getElementById('privateMsgInput');
            const text = input.value.trim();
            if (!text) return;
            const peer = currentPrivatePeer;
            const msg = {
                id: crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2),
                type: 'text',
                sender: myName,
                content: text,
                duration: 0,
                timestamp: Date.now()
            };
            // 如果有引用消息，附加 quote 字段
            if (quotingPrivateMsg) {
                msg.quote = { id: quotingPrivateMsg.id, name: quotingPrivateMsg.name, content: quotingPrivateMsg.content };
                cancelPrivateQuote();
            }
            // 先本地显示
            if (!privateMsgsCache[peer]) privateMsgsCache[peer] = [];
            privateMsgsCache[peer].push(msg);
            savePrivateMsgsCache();
            renderPrivateMessages(peer);
            input.value = '';
            input.style.height = 'auto';
            input.style.height = Math.min(input.scrollHeight, 100) + 'px';
            // 触发 input 事件：清空后自动隐藏发送按钮，显示加号
            input.dispatchEvent(new Event('input'));
            input.focus();
            // 发送到服务端
            try {
                const resp = await fetch('/api/friends/message', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ from: myName, to: peer, type: 'text', content: text, id: msg.id, timestamp: msg.timestamp, quote: msg.quote || null })
                });
                if (!resp.ok) {
                    // 发送被拒绝（违禁词/禁言等），从本地缓存和界面移除该消息
                    const errData = await resp.json().catch(() => ({}));
                    const reason = errData.error || '发送失败';
                    privateMsgsCache[peer] = (privateMsgsCache[peer] || []).filter(m => m.id !== msg.id);
                    savePrivateMsgsCache();
                    renderPrivateMessages(peer);
                    showToast(reason, 'error');
                }
            } catch(e) { console.error('发送私聊失败', e); showToast('发送失败', 'error'); }
        }

        // 处理收到的私聊消息
        function handleIncomingPrivateMessage(data) {
            const peer = data.from || data.sender;
            if (!peer) return;
            if (!privateMsgsCache[peer]) privateMsgsCache[peer] = [];
            // 去重
            if (privateMsgsCache[peer].some(m => m.id === data.id)) return;
            privateMsgsCache[peer].push(data);
            // 注意：bg-accepted/bg-rejected 已改为通过 /api/friends/bg-reply 更新原邀请消息状态，
            // 不再产生新的 private-message，此处无需处理
            // 处理"恢复默认"消息：对方发起的 bg-reset，本地直接清除背景（无需确认）
            if (data.type === 'bg-reset') {
                localStorage.removeItem('chatBg_' + peer);
                localStorage.removeItem('chatBgInviteFull_' + peer);
                setChatBackground(peer, null);
                if (currentPrivatePeer === peer) {
                    showToast('对方已恢复默认背景', 'info');
                }
            }
            savePrivateMsgsCache();
            // 如果当前正在和对方聊天，直接渲染
            if (currentPrivatePeer === peer) {
                renderPrivateMessages(peer);
            } else {
                // 否则增加未读
                friendUnread[peer] = (friendUnread[peer] || 0) + 1;
                // 更新消息页 badge
                const totalUnread = Object.values(friendUnread).reduce((a,b) => a+b, 0);
                const badge = document.getElementById('chatBadge');
                if (totalUnread > 0) {
                    badge.textContent = totalUnread > 99 ? '99+' : totalUnread;
                    badge.style.display = 'flex';
                } else { badge.style.display = 'none'; }
                // 如果在消息页，刷新会话列表
                if (document.getElementById('pageChat').style.display === 'block') renderFriendSessions();
            }
            // 刷新好友列表的最后消息
            loadFriendsList();
        }

        // 轮询拉取私聊消息（兜底外网 socket 不稳定）
        async function pollPrivateMessages() {
            if (!myName || myFriends.length === 0) return;
            for (const f of myFriends) {
                try {
                    const res = await fetch('/api/friends/messages?userName=' + encodeURIComponent(myName) + '&peerName=' + encodeURIComponent(f.name));
                    if (!res.ok) continue;
                    const data = await res.json();
                    const serverMsgs = data.messages || [];
                    const localMsgs = privateMsgsCache[f.name] || [];
                    const localIds = new Set(localMsgs.map(m => m.id));
                    const newMsgs = serverMsgs.filter(m => !localIds.has(m.id));
                    if (newMsgs.length > 0) {
                        if (!privateMsgsCache[f.name]) privateMsgsCache[f.name] = [];
                        // 记录是否有真正需要计数的新消息
                        let hasNewUnread = false;
                        newMsgs.forEach(m => {
                            // 缓存所有消息（含自己发的），避免下次轮询重复当作 newMsgs
                            privateMsgsCache[f.name].push(m);
                            // 只对对方发的、且时间晚于已读时间戳的消息计数（避免已读消息重复+1）
                            if (m.sender !== myName && currentPrivatePeer !== f.name) {
                                const readTs = lastReadTs[f.name] || 0;
                                if (m.timestamp > readTs) {
                                    friendUnread[f.name] = (friendUnread[f.name] || 0) + 1;
                                    hasNewUnread = true;
                                }
                            }
                        });
                        savePrivateMsgsCache();
                        if (currentPrivatePeer === f.name) renderPrivateMessages(f.name);
                        if (hasNewUnread || currentPrivatePeer !== f.name) {
                            // 更新未读 badge
                            const totalUnread = Object.values(friendUnread).reduce((a,b) => a+b, 0);
                            const badge = document.getElementById('chatBadge');
                            if (totalUnread > 0) {
                                badge.textContent = totalUnread > 99 ? '99+' : totalUnread;
                                badge.style.display = 'flex';
                            } else {
                                badge.style.display = 'none';
                            }
                        }
                    }
                } catch(e) {}
            }
        }

        // 从服务端加载私聊消息（打开私聊时）
        async function loadPrivateMessagesFromServer(peerName) {
            try {
                const res = await fetch('/api/friends/messages?userName=' + encodeURIComponent(myName) + '&peerName=' + encodeURIComponent(peerName));
                if (!res.ok) return;
                const data = await res.json();
                const serverMsgs = data.messages || [];
                // 服务端是权威源：以服务端消息为主，合并本地"自己刚发送但服务端尚未返回"的待确认消息
                const localMsgs = privateMsgsCache[peerName] || [];
                const serverMap = new Map(serverMsgs.map(m => [m.id, m]));
                // 服务端消息同步状态字段到本地引用，避免渲染时使用旧状态
                const mergedMap = new Map();
                serverMsgs.forEach(srvMsg => {
                    mergedMap.set(srvMsg.id, srvMsg);
                });
                // 补充本地"待确认"消息：自己发送、且 10 秒内的、且服务端没有的
                // 这是为了避免自己刚发送的消息在服务端还没持久化时被误删
                const now = Date.now();
                localMsgs.forEach(localMsg => {
                    if (localMsg.sender === myName && !serverMap.has(localMsg.id) && (now - (localMsg.timestamp || 0)) < 10000) {
                        mergedMap.set(localMsg.id, localMsg);
                    }
                });
                const allMsgs = Array.from(mergedMap.values());
                // 按时间排序
                allMsgs.sort((a,b) => a.timestamp - b.timestamp);
                privateMsgsCache[peerName] = allMsgs;
                savePrivateMsgsCache();
                // 检查是否有管理员撤回背景的系统消息（离线时也能收到）
                const adminReset = allMsgs.find(m => m.type === 'bg-reset-by-admin' && m.sender === '__system__');
                if (adminReset) {
                    localStorage.removeItem('chatBg_' + peerName);
                    localStorage.removeItem('chatBgInviteFull_' + peerName);
                    setChatBackground(peerName, null);
                }
            } catch(e) { console.error('加载私聊消息失败', e); }
        }

        // 保存私聊缓存到 localStorage（全部消息存客户端）
        function savePrivateMsgsCache() {
            try { localStorage.setItem('privateMsgsCache', JSON.stringify(privateMsgsCache)); }
            catch(e) { console.error('保存私聊缓存失败', e); }
        }

        // 好友请求 badge
