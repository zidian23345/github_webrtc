            updateOnlineCount(data.count);
            // 如果抽屉打开则刷新
            if (isMembersDrawerOpen()) renderMembersList();
        });

        socket.on('chat-user-joined', (data) => {
            onlineUsers[data.socketId] = data;
            if (data.name && data.avatar) avatarByName[data.name] = data.avatar;  // 填充头像缓存
            // 从离线缓存中移除（如果存在）
            offlineUsers.delete(data.socketId);
            updateOnlineCount(Object.keys(onlineUsers).length);
            if (isMembersDrawerOpen()) renderMembersList();
        });

        socket.on('chat-user-left', (data) => {
            // 移入离线缓存
            const u = onlineUsers[data.socketId];
            if (u) {
                offlineUsers.set(data.socketId, Object.assign({}, u, { leftAt: Date.now() }));
                // 限制离线用户数量
                if (offlineUsers.size > MAX_OFFLINE_USERS) {
                    const firstKey = offlineUsers.keys().next().value;
                    offlineUsers.delete(firstKey);
                }
            }
            delete onlineUsers[data.socketId];
            updateOnlineCount(Object.keys(onlineUsers).length);
            if (isMembersDrawerOpen()) renderMembersList();
        });

        // 在线成员更新（用户加入/离开时服务器广播，快速重连时只发这个事件）
        socket.on('online-members-update', (data) => {
            const prevIds = new Set(Object.keys(onlineUsers));
            const newIds = new Set(data.users.map(u => u.socketId));
            const newNames = new Set(data.users.map(u => u.name).filter(Boolean));
            // 把离开的移入离线缓存（仅当该用户名不在新在线列表中时才保留）
            prevIds.forEach(id => {
                if (!newIds.has(id) && onlineUsers[id]) {
                    const u = onlineUsers[id];
                    // 如果该用户名已在新在线列表中（说明是快速重连/刷新），不要把旧的移入离线
                    if (u.name && newNames.has(u.name)) return;
                    offlineUsers.set(id, Object.assign({}, u, { leftAt: Date.now() }));
                }
            });
            // 清理离线缓存中与新在线用户同名的条目（避免重复显示）
            for (const [id, u] of offlineUsers.entries()) {
                if (u.name && newNames.has(u.name)) {
                    offlineUsers.delete(id);
                }
            }
            // 限制离线缓存数量
            while (offlineUsers.size > MAX_OFFLINE_USERS) {
                const firstKey = offlineUsers.keys().next().value;
                offlineUsers.delete(firstKey);
            }
            // 重建在线列表
            onlineUsers = {};
            data.users.forEach(u => {
                onlineUsers[u.socketId] = u;
                if (u.name && u.avatar) avatarByName[u.name] = u.avatar;  // 填充头像缓存
                // 重新加入的从离线缓存中移除
                offlineUsers.delete(u.socketId);
                if (u.socketId === mySocketId) {
                    myColor = u.color;
                    if (u.avatar) { myAvatar = u.avatar; updateNavAvatar(); }
                }
            });
            updateOnlineCount(data.count);
            if (isMembersDrawerOpen()) renderMembersList();
        });

        socket.on('chat-user-renamed', (data) => {
            if (onlineUsers[data.socketId]) onlineUsers[data.socketId].name = data.newName;
            if (isMembersDrawerOpen()) renderMembersList();
        });

        // 头像变更通知
        socket.on('user-avatar-changed', (data) => {
            if (onlineUsers[data.socketId]) {
                onlineUsers[data.socketId].avatar = data.avatar;
                // 更新头像缓存（按 userName 索引）
                const u = onlineUsers[data.socketId];
                if (u.name && data.avatar) avatarByName[u.name] = data.avatar;
            }
            if (data.socketId === mySocketId) {
                myAvatar = data.avatar;
                updateNavAvatar();
            }
            // 更新该用户所有历史消息的头像
            updateMessagesAvatar(data.socketId, data.avatar);
            if (isMembersDrawerOpen()) renderMembersList();
        });

        // ===== 更新某用户所有历史消息的头像 =====
        function updateMessagesAvatar(socketId, avatar) {
            const owner = onlineUsers[socketId];
            const ownerName = owner ? owner.name : null;
            if (ownerName && avatar) avatarByName[ownerName] = avatar;  // 更新头像缓存
            const list = document.getElementById('chatList');
            // 遍历所有消息项，匹配 socketId 或 senderName
            list.querySelectorAll('.msg-item').forEach(item => {
                const msgId = item.dataset.msgId;
                if (!msgId) return;
                const msg = messagesMap[msgId];
                if (!msg) return;
                const isMatch = msg.socketId === socketId
                    || (ownerName && msg.senderName === ownerName)
                    || (ownerName && msg.name === ownerName);
                if (!isMatch) return;
                // 只更新 DOM，不更新 msg.avatar（消息不再存 avatar）
                const avatarEl = item.querySelector('.msg-avatar');
                if (!avatarEl) return;
                const color = msg.color || (msg.socketId === mySocketId ? myColor : '#5765ec');
                const initial = (msg.name || '?')[0].toUpperCase();
                if (avatar) {
                    avatarEl.style.background = color;
                    avatarEl.innerHTML = `<img src="${avatar}">`;
                } else {
                    avatarEl.style.background = color;
                    avatarEl.innerHTML = initial;
                }
            });
        }

        // 头像被禁用（普通提示）
        socket.on('avatar-blocked', (data) => {
            showToast(data && data.reason ? data.reason : '头像功能被禁用', 'error');
        });

        // 头像被管理员禁用
        socket.on('avatar-banned', () => {
            avatarBanned = true;
            showToast('你已被禁用换头像功能', 'error');
        });

        // 头像被解禁
        socket.on('avatar-unbanned', () => {
            avatarBanned = false;
            showToast('已解禁换头像功能');
        });

        // 用户主页数据返回
        socket.on('profile-data', (data) => {
            showProfileModal(data);
        });

        // ===== 视频通话相关事件 =====
        // 收到来电
        socket.on('call-incoming', (data) => {
            showIncomingCall(data);
        });

        // 主叫收到被叫接听
        socket.on('call-accepted', (data) => {
            if (!currentCall || currentCall.callId !== data.callId) return;
            showToast(`${currentCall.name} 已接听`);
            // 记录通话开始时间到 localStorage，供 room 页面使用
            localStorage.setItem('callStartTime', String(Date.now()));
            localStorage.setItem('callPeerName', currentCall.name || '');
            localStorage.setItem('callType', currentCall.callType || 'voice');
            // 保存通话房间信息，供返回聊天页时显示通话状态横条
            localStorage.setItem('activeCallRoomId', currentCall.roomId || '');
            localStorage.setItem('activeCallPeerName', currentCall.name || '');
            localStorage.setItem('activeCallType', currentCall.callType || 'voice');
            // 私聊通话：主叫方在通话被接听时也补设 privateCallPeer（防止 inviteCall 后被其他逻辑清除）
            if (currentCall.isPrivateCall) {
                localStorage.setItem('privateCallPeer', currentCall.name || '');
                localStorage.setItem('callRole', 'caller');
            } else {
                localStorage.removeItem('privateCallPeer');
                localStorage.removeItem('callRole');
            }
            const roomId = currentCall.roomId;
            closeCallModal();
            // 通话开始：显示屏幕共享按钮
            nativeSetShareButtonVisible(true);
            // 跳转到房间
            window.location.href = `/room/${roomId}`;
        });

        // 主叫收到被叫拒绝
        socket.on('call-rejected', (data) => {
            if (!currentCall || currentCall.callId !== data.callId) {
                console.log('[通话] 收到拒绝但 callId 不匹配', data.callId, '当前:', currentCall?.callId);
                return;
            }
            const reason = data.reason || '对方已拒绝';
            const rejectedCallId = data.callId;
            console.log('[通话] 被拒绝:', reason);
            showToast(reason, 'error');
            document.getElementById('callStatus').textContent = reason;
            // 私聊通话被拒：生成"通话被拒绝"记录（主叫方生成，被叫方等推送）
            if (currentCall.isPrivateCall) {
                generatePrivateCallRecord(currentCall.toUserName, currentCall.callType, 0, 'rejected');
            }
            // 1.5 秒后关闭界面（校验 callId，避免误关新发起的通话）
            setTimeout(() => {
                if (!currentCall || currentCall.callId === rejectedCallId) {
                    closeCallModal();
                }
            }, 1500);
            currentCall = null;
            nativeSetShareButtonVisible(false);
        });

        // 通话被对方结束
        socket.on('call-ended', (data) => {
            if (!currentCall || currentCall.callId !== data.callId) return;
            const dur = data.duration || 0;
            const endedCallId = data.callId;
            showToast(`通话已结束，时长 ${dur} 秒`);
            document.getElementById('callStatus').textContent = `通话结束 · ${dur} 秒`;
            setTimeout(() => {
                if (!currentCall || currentCall.callId === endedCallId) {
                    closeCallModal();
                }
            }, 1500);
            currentCall = null;
            nativeSetShareButtonVisible(false);
        });

        // 被叫收到主叫取消
        socket.on('call-cancelled', (data) => {
            if (!currentCall || currentCall.callId !== data.callId) return;
            showToast('对方已取消呼叫');
            closeCallModal('cancel');  // 缩放淡出动画
            // 私聊通话：被叫方不生成记录（主叫方 cancelOutgoingCall 已生成并推送，避免重复）
            currentCall = null;
            nativeSetShareButtonVisible(false);
        });

        // 通话错误
        socket.on('call-error', (data) => {
            showToast(data.message || '通话出错', 'error');
            closeCallModal('cancel');  // 缩放淡出动画
            currentCall = null;
            nativeSetShareButtonVisible(false);
        });

        // 消息被撤回
        socket.on('message-recalled', (data) => {
            if (messagesMap[data.msgId]) messagesMap[data.msgId].recalled = true;
            updateLocalMessageField(data.msgId, 'recalled', true);
            updateMessageRecalled(data.msgId);
        });

        // 消息被隐藏
        socket.on('message-hidden', (data) => {
            updateMessageHidden(data.msgId, true);
            if (messagesMap[data.msgId]) messagesMap[data.msgId].hidden = true;
            updateLocalMessageField(data.msgId, 'hidden', true);
        });

        // 管理员删除单条消息
        socket.on('message-deleted', (data) => {
            const div = document.querySelector(`[data-msg-id="${data.msgId}"]`);
            if (div) div.remove();
            delete messagesMap[data.msgId];
            removeLocalMessage(data.msgId);
        });

        // 管理员清空所有消息
        socket.on('messages-cleared', () => {
            document.getElementById('chatList').innerHTML = '';
            messagesMap = {};
            clearLocalMessagesCache();
            showToast('管理员已清空所有消息');
        });

        // 消息恢复显示
        socket.on('message-shown', (data) => {
            updateMessageHidden(data.msgId, false);
            if (messagesMap[data.msgId]) messagesMap[data.msgId].hidden = false;
            updateLocalMessageField(data.msgId, 'hidden', false);
        });

        // 消息被拦截（违禁词/禁言）
        socket.on('message-blocked', (data) => {
            showToast(data.reason, 'error');
        });

        // 被封禁
        socket.on('user-banned', (banInfo) => {
            showBanBanner(banInfo);
            showToast(`你已被${banInfo.bannedFromChat ? '禁言' : ''}${banInfo.bannedFromMeeting ? '禁用会议功能' : ''}：${banInfo.reason}`, 'error');
        });

        // 被解封
        socket.on('user-unbanned', (data) => {
            hideBanBanner();
            showToast(`已解封：${data.reason}`);
        });

        socket.on('connect_error', (err) => console.error('连接错误:', err));

        function updateOnlineCount(count) {
            document.getElementById('onlineCount').textContent = `(${count} 人在线)`;
        }

        window.onChatMessage = function(msg) { appendMessage(msg); };

        // ===== 生成私聊通话记录（支持成功/被拒/取消三种状态）=====
        // outcome: 'completed' 已接通挂断 / 'rejected' 被拒绝 / 'cancelled' 已取消
        function generatePrivateCallRecord(peerName, callType, durationSec, outcome) {
            if (!peerName) return;
            const typeLabel = callType === 'video' ? '视频通话' : '语音通话';
            let content;
            if (outcome === 'rejected') {
                content = `${typeLabel} · 通话被拒绝`;
            } else if (outcome === 'cancelled') {
                content = `${typeLabel} · 通话已取消`;
            } else {
                content = `${typeLabel} ${formatCallDuration(durationSec)}`;
            }
            // 本地显示
            if (!privateMsgsCache[peerName]) privateMsgsCache[peerName] = [];
            const msg = {
                id: crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2),
                type: 'call', sender: myName, content,
                duration: outcome === 'completed' ? durationSec : 0,
                callType, callOutcome: outcome,  // callOutcome 标记通话结果
                timestamp: Date.now()
            };
            // 去重：同一秒内不重复添加相同 outcome 的记录
            if (privateMsgsCache[peerName].some(m => m.type === 'call' && m.callOutcome === outcome && Math.abs(m.timestamp - msg.timestamp) < 1500)) {
                return;
            }
            privateMsgsCache[peerName].push(msg);
            savePrivateMsgsCache();
            if (currentPrivatePeer === peerName) renderPrivateMessages(peerName);
            // 推送到服务端
            fetch('/api/friends/message', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    from: myName, to: peerName, type: 'call', content,
                    duration: msg.duration, callType,
                    callOutcome: outcome,  // 透传通话结果
                    id: msg.id, timestamp: msg.timestamp
                })
            }).catch(e => console.error('发送私聊通话记录失败', e));
        }

        // ===== 检查是否有未完成的通话总结 =====
        // 从 room 页面返回时，若 callEnded=1 则发送通话记录消息（微信风格）
        function checkPendingCallSummary() {
            const ended = localStorage.getItem('callEnded');
            if (ended !== '1') return;
            localStorage.removeItem('callEnded');
            const startTimeStr = localStorage.getItem('callStartTime');
            if (!startTimeStr) return;
            const startMs = parseInt(startTimeStr);
            localStorage.removeItem('callStartTime');
            const peerName = localStorage.getItem('callPeerName') || '';
            localStorage.removeItem('callPeerName');
            const callType = localStorage.getItem('callType') || 'voice';
            localStorage.removeItem('callType');
            // 检查是否为私聊通话
            const privatePeer = localStorage.getItem('privateCallPeer');
            const callRole = localStorage.getItem('callRole') || '';
            localStorage.removeItem('privateCallPeer');
            localStorage.removeItem('callRole');
            // 以当前时间作为通话结束时间
            const durationSec = Math.floor((Date.now() - startMs) / 1000);
            if (durationSec < 3) return;  // 太短忽略
            // 私聊通话：发送到私聊会话（仅主叫方生成记录，被叫方等推送避免重复）
            if (privatePeer && privatePeer !== '') {
                if (callRole === 'callee') {
                    // 被叫方：不生成记录，等待主叫方通过 /api/friends/message 推送
                    return;
                }
                // 使用统一的通话记录生成函数（标记为已完成）
                generatePrivateCallRecord(privatePeer, callType, durationSec, 'completed');
                return;
            }
            // 公用聊天室通话：发送 call 类型消息到服务器（像普通消息一样广播+持久化）
            socket.emit('chat-send-message', {
                type: 'call',
                content: '',
                callType,
                peerName,
                callDuration: durationSec
            });
        }

        // 格式化通话时长为 HH:MM:SS
        function formatCallDuration(seconds) {
            const h = String(Math.floor(seconds / 3600)).padStart(2, '0');
            const m = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
            const s = String(seconds % 60).padStart(2, '0');
            return `${h}:${m}:${s}`;
        }

        // ===== 通话状态横条（通话进行中返回聊天页时显示）=====
        let callStatusBarTimer = null;
        let callStartTimestamp = 0;

        function checkActiveCall() {
            const roomId = localStorage.getItem('activeCallRoomId');
            if (!roomId) return;
            const peerName = localStorage.getItem('activeCallPeerName') || '对方';
            const callType = localStorage.getItem('activeCallType') || 'voice';
            const startTimeStr = localStorage.getItem('callStartTime');
            callStartTimestamp = startTimeStr ? parseInt(startTimeStr) : Date.now();
            // 显示横条
            const bar = document.getElementById('callStatusBar');
            const text = document.getElementById('callStatusText');
            const icon = bar.querySelector('.call-status-icon');
            const typeLabel = callType === 'video' ? '视频通话' : '语音通话';
            text.textContent = `正在和 ${peerName} ${typeLabel}中`;
            icon.className = callType === 'video' ? 'fa fa-video-camera call-status-icon' : 'fa fa-phone call-status-icon';
            bar.style.display = 'flex';
            // 启动计时器
            updateCallStatusBarTime();
            if (callStatusBarTimer) clearInterval(callStatusBarTimer);
            callStatusBarTimer = setInterval(updateCallStatusBarTime, 1000);
            // 调整聊天列表顶部位置，避免被横条遮挡
            const chatList = document.getElementById('chatList');
            if (chatList) chatList.style.top = '92px';
        }

        function updateCallStatusBarTime() {
            const elapsed = Math.floor((Date.now() - callStartTimestamp) / 1000);
            const h = String(Math.floor(elapsed / 3600)).padStart(2, '0');
            const m = String(Math.floor((elapsed % 3600) / 60)).padStart(2, '0');
            const s = String(elapsed % 60).padStart(2, '0');
            document.getElementById('callStatusTime').textContent = `${h}:${m}:${s}`;
        }

        function hideCallStatusBar() {
            document.getElementById('callStatusBar').style.display = 'none';
            if (callStatusBarTimer) { clearInterval(callStatusBarTimer); callStatusBarTimer = null; }
            const chatList = document.getElementById('chatList');
            if (chatList) chatList.style.top = '56px';
        }

        // 返回通话房间
        function returnToCall() {
            const roomId = localStorage.getItem('activeCallRoomId');
            if (!roomId) { hideCallStatusBar(); return; }
            window.location.href = `/room/${roomId}`;
        }

        // 从聊天页挂断通话
        function hangupCallFromChat() {
            if (!confirm('确定要挂断当前通话吗？')) return;
            // 通知服务器离开房间
            const roomId = localStorage.getItem('activeCallRoomId');
            if (roomId && socket.connected) {
                socket.emit('webrtc-leave', { roomId });
            }
            // 清除通话状态并触发总结
            localStorage.setItem('callEnded', '1');
            localStorage.removeItem('activeCallRoomId');
            localStorage.removeItem('activeCallPeerName');
            localStorage.removeItem('activeCallType');
            hideCallStatusBar();
            // 发送通话总结
            checkPendingCallSummary();
            showToast('通话已结束');
        }

        // ===== 成员抽屉相关 =====
        function isMembersDrawerOpen() {
            return document.getElementById('membersDrawer').classList.contains('show');
        }

        function openMembersDrawer() {
            document.getElementById('membersDrawer').classList.add('show');
            document.getElementById('drawerOverlay').classList.add('show');
            renderMembersList();
        }

        function closeMembersDrawer() {
            document.getElementById('membersDrawer').classList.remove('show');
            document.getElementById('drawerOverlay').classList.remove('show');
        }

        // 渲染成员列表（在线 + 离线）
        function renderMembersList() {
            const list = document.getElementById('membersList');
            const onlineArr = Object.values(onlineUsers);
            const onlineNames = new Set(onlineArr.map(u => u.name).filter(Boolean));
            // 离线用户去重：排除与在线用户同名的（避免刷新后出现重复）
            const offlineArr = Array.from(offlineUsers.values()).filter(u => {
                if (u.name && onlineNames.has(u.name)) return false;  // 在线已有同名，不显示离线条目
                return true;
            });
            // 离线用户自身也按 name 去重（保留最近离开的）
            const seenNames = new Set();
            const dedupedOffline = [];
            for (let i = offlineArr.length - 1; i >= 0; i--) {
                const u = offlineArr[i];
                const key = u.name || u.socketId;
                if (!seenNames.has(key)) {
                    seenNames.add(key);
                    dedupedOffline.unshift(u);
                }
            }
            const totalCount = onlineArr.length + dedupedOffline.length;
            document.getElementById('drawerSummary').textContent =
                `在线 ${onlineArr.length} 人 / 共 ${totalCount} 人`;
            list.innerHTML = '';

            // 自己排第一
            onlineArr.sort((a, b) => {
                if (a.socketId === mySocketId) return -1;
                if (b.socketId === mySocketId) return 1;
                return (a.name || '').localeCompare(b.name || '');
            });
            dedupedOffline.sort((a, b) => (a.name || '').localeCompare(b.name || ''));

            // 在线成员
            onlineArr.forEach(u => list.appendChild(buildMemberItem(u, true)));
            // 离线成员
            dedupedOffline.forEach(u => list.appendChild(buildMemberItem(u, false)));
        }

        // 构建单个成员项
        function buildMemberItem(u, isOnline) {
            const item = document.createElement('div');
            item.className = 'member-item';
            item.onclick = () => viewUserProfile(u.socketId);
            const color = u.color || '#5765ec';
            const initial = (u.name || '?')[0].toUpperCase();
            const avatarInner = u.avatar
                ? `<img src="${u.avatar}">`
                : `${initial}`;
            const selfClass = u.socketId === mySocketId ? ' self' : '';
            const meta = isOnline
                ? `加入于 ${formatTime(u.joinedAt || Date.now())}`
                : `离线`;
            item.innerHTML = `
                <div class="member-avatar" style="background:${color}">
                    ${avatarInner}
                    <div class="member-status-dot ${isOnline ? 'online' : ''}"></div>
                </div>
                <div class="member-info">
                    <div class="member-name${selfClass}">${escapeHtml(u.name || '匿名')}</div>
                    <div class="member-meta">${meta}</div>
                </div>
            `;
            return item;
        }

        // 简单的 HTML 转义
        function escapeHtml(s) {
            return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        // 按 userName 生成稳定的头像背景色（与 server.js colorPalette 一致）
        const USER_COLOR_PALETTE = ['#07c160', '#5765ec', '#fa5151', '#ff9c19', '#00ae9d', '#8b5cf6', '#ec4899', '#14b8a6', '#f97316', '#6366f1'];
        const _userColorCache = {};
        function getUserColorByName(name) {
            if (!name) return USER_COLOR_PALETTE[0];
            if (_userColorCache[name]) return _userColorCache[name];
            let hash = 0;
            for (let i = 0; i < name.length; i++) hash = (hash * 31 + name.charCodeAt(i)) | 0;
            const color = USER_COLOR_PALETTE[Math.abs(hash) % USER_COLOR_PALETTE.length];
            _userColorCache[name] = color;
            return color;
        }

        // ===== 用户主页 =====
        function viewUserProfile(socketId) {
            if (!socketId) return;
            socket.emit('get-profile', { socketId });
            showToast('正在加载用户主页...');
        }

        // 查看自己的主页
        function viewMyProfile() {
            if (mySocketId) viewUserProfile(mySocketId);
            else openNameModal();
        }

        function showProfileModal(data) {
            const content = document.getElementById('profileContent');
            const isSelf = data.socketId === mySocketId;
            const color = (onlineUsers[data.socketId] || {}).color || '#5765ec';
            const initial = (data.name || '?')[0].toUpperCase();
            const avatarInner = data.avatar
                ? `<img src="${data.avatar}">`
                : `${initial}`;
            const statusText = data.online ? '在线' : '离线';
            const statusClass = data.online ? '' : ' offline';
            const joinedAt = data.joinedAt ? formatTime(data.joinedAt) : '未知';
            const lastSeen = data.lastSeen ? formatTime(data.lastSeen) : '—';

            let actionsHtml = '';
            if (isSelf) {
                actionsHtml = `<div class="profile-actions">
                    <button class="profile-btn" onclick="document.getElementById('avatarInput').click()">修改头像</button>
                    <button class="profile-btn" onclick="closeProfileModal(); setTimeout(openNameModal, 200);">修改名称</button>
                </div>`;
            }

            content.innerHTML = `
                <div class="profile-avatar-large" style="background:${color}">
                    ${avatarInner}
                    <div class="member-status-dot ${data.online ? 'online' : ''}"></div>
                </div>
                <div class="profile-name">${escapeHtml(data.name || '匿名')}</div>
                <div class="profile-status${statusClass}">${statusText}</div>
                <div class="profile-row"><span>加入时间</span><span>${joinedAt}</span></div>
                <div class="profile-row"><span>最后在线</span><span>${lastSeen}</span></div>
                ${data.avatarBanned ? '<div class="profile-row"><span style="color:#fa5151;">头像功能</span><span style="color:#fa5151;">已被禁用</span></div>' : ''}
                ${actionsHtml}
            `;
            document.getElementById('profileModal').classList.add('show');
        }

        function closeProfileModal() {
            document.getElementById('profileModal').classList.remove('show');
        }

        // 选择头像文件后的回调
        function onAvatarSelected(input) {
            const file = input.files[0];
            if (!file) return;
            if (avatarBanned) { showToast('你已被禁用换头像功能', 'error'); input.value = ''; return; }
            if (file.size > 2 * 1024 * 1024) { showToast('头像不能超过 2MB', 'error'); input.value = ''; return; }
            const reader = new FileReader();
            reader.onload = function(e) {
                socket.emit('set-avatar', { avatar: e.target.result });
                showToast('头像已上传');
                // 本地立即更新
                myAvatar = e.target.result;
                updateNavAvatar();
                if (onlineUsers[mySocketId]) onlineUsers[mySocketId].avatar = myAvatar;
                // 刷新主页弹窗
                const profileBox = document.getElementById('profileModal');
                if (profileBox.classList.contains('show')) {
                    showProfileModal({
                        socketId: mySocketId, name: myName, avatar: myAvatar,
                        avatarBanned: avatarBanned, online: true,
                        joinedAt: (onlineUsers[mySocketId] || {}).joinedAt,
                        lastSeen: null
                    });
                }
            };
            reader.onerror = function() { showToast('头像读取失败', 'error'); };
            reader.readAsDataURL(file);
            input.value = '';
        }

        // 更新导航栏头像
        function updateNavAvatar() {
            const el = document.getElementById('navAvatar');
            if (!el) return;
            if (myAvatar) {
                el.innerHTML = `<img src="${myAvatar}">`;
            } else {
                const initial = (myName || '?')[0].toUpperCase();
                el.textContent = initial;
                el.style.background = myColor;
            }
        }

        // ===== 视频通话 =====
        // 生成 UUID（用于 callId）
        function generateCallId() {
            if (window.crypto && window.crypto.randomUUID) return window.crypto.randomUUID();
            return 'c-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10);
        }

        // 发起通话：弹出选择在线成员
        async function startCall(callType) {
            if (bannedFromMeeting) { showToast('你已被禁用会议功能', 'error'); return; }
            closePlusPanel();
            // 始终通过 HTTP 获取最新在线用户列表（socket 事件可能不完整，导致列表缺失成员）
            let onlineArr = [];
            try {
                const res = await fetch('/api/chat/online-users');
                if (res.ok) {
                    const data = await res.json();
                    const httpUsers = (data.users || []).filter(u => u.socketId !== mySocketId);
                    // 合并到本地 onlineUsers（补充 socket 事件丢失的成员）
                    httpUsers.forEach(u => {
                        onlineUsers[u.socketId] = u;
                        if (u.name && u.avatar) avatarByName[u.name] = u.avatar;
                    });
                    onlineArr = httpUsers;
                    console.log('[通话] HTTP 获取到 ' + httpUsers.length + ' 个在线用户');
                }
            } catch (e) {
                console.error('[通话] HTTP 获取在线用户失败', e);
                // 降级：使用本地 onlineUsers
                onlineArr = Object.values(onlineUsers).filter(u => u.socketId !== mySocketId);
            }
            if (onlineArr.length === 0) {
                showToast('暂无其他在线成员可呼叫', 'error');
                return;
            }
            const titleMap = { video: '选择视频通话对象', voice: '选择语音通话对象' };
            document.getElementById('callTargetTitle').textContent = titleMap[callType] || '选择通话对象';
            const listEl = document.getElementById('callTargetList');
            listEl.innerHTML = '';
            onlineArr.forEach(u => {
                const item = document.createElement('div');
                item.className = 'call-target-item';
                item.onclick = () => {
                    closeCallTargetModal();
                    inviteCall(u, callType);
                };
                const color = u.color || '#5765ec';
                const initial = (u.name || '?')[0].toUpperCase();
                const avatarInner = u.avatar ? `<img src="${u.avatar}">` : initial;
                item.innerHTML = `
                    <div class="call-target-avatar" style="background:${color}">${avatarInner}</div>
                    <div class="call-target-name">${escapeHtml(u.name || '匿名')}</div>
                `;
                listEl.appendChild(item);
            });
            document.getElementById('callTargetModal').classList.add('show');
        }

        function closeCallTargetModal() {
            document.getElementById('callTargetModal').classList.remove('show');
        }

        // 向某成员发起通话邀请
        function inviteCall(targetUser, callType, isPrivateCall) {
            const callId = generateCallId();
            const roomId = String(Math.floor(100000 + Math.random() * 900000));
            currentCall = {
                callId,
                toSocketId: targetUser.socketId,
                toUserName: targetUser.name,  // 保存目标用户名用于 HTTP 兜底
                callType,
                isOutgoing: true,
                name: targetUser.name,
                avatar: targetUser.avatar,
                color: targetUser.color,
                roomId,
                isPrivateCall: !!isPrivateCall,  // 标记是否私聊通话
                createdAt: Date.now()  // 用于检测僵尸状态
            };
            // 公用聊天室通话：清除 privateCallPeer；私聊通话：保留
            if (!isPrivateCall) {
                localStorage.removeItem('privateCallPeer');
                localStorage.removeItem('callRole');
            } else {
                // 私聊通话：标记为主叫，只有主叫方负责生成通话记录（被叫方等待推送）
                localStorage.setItem('callRole', 'caller');
                // 标记通话处于"呼叫中"状态（用于拒绝/取消时生成对应记录）
                localStorage.setItem('callOutcome', 'calling');
            }
            // 保存通话类型和对方头像到 localStorage，供 room 页面语音通话界面使用
            localStorage.setItem('callType', callType);
            localStorage.setItem('callPeerAvatar', targetUser.avatar || '');
            localStorage.setItem('callPeerName', targetUser.name || '');
            // 优先 socket 发送，断连时走 HTTP 兜底
            if (socket.connected) {
                socket.emit('call-invite', {
                    toSocketId: targetUser.socketId,
                    callType,
                    callId,
                    roomId,
                    isPrivateCall: !!isPrivateCall
                });
            } else {
                // HTTP 兜底发起通话邀请
                fetch('/api/call/invite', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        toUserName: targetUser.name,
                        fromUserName: myName,
                        fromUserId: myUserId,
                        callType,
                        callId,
                        roomId,
                        isPrivateCall: !!isPrivateCall
                    })
                }).then(res => res.json()).then(data => {
                    if (!data.success) {
                        showToast('呼叫失败', 'error');
                        closeCallModal();
                        currentCall = null;
                    } else if (!data.targetOnline) {
                        showToast('对方可能不在线，等待对方上线...', 'info');
                    }
                }).catch(e => {
                    console.error('[HTTP通话邀请] 失败', e);
                    showToast('呼叫失败，请检查网络', 'error');
                    closeCallModal();
                    currentCall = null;
                });
            }
            // 显示呼叫中界面
            showOutgoingCallUI(targetUser, callType);
        }

        // 显示主叫呼叫中界面
        function showOutgoingCallUI(targetUser, callType) {
            const modal = document.getElementById('callModal');
            const statusEl = document.getElementById('callStatus');
            // 完全重置弹窗动画状态，避免上次通话的 closing/rejected 残留导致异常
            modal.classList.remove('incoming', 'closing', 'rejected');
            statusEl.textContent = '正在呼叫...';
            statusEl.classList.remove('calling');
            void statusEl.offsetWidth;  // 强制 reflow，重置 calling 动画
            statusEl.classList.add('calling');
            const avatarEl = document.getElementById('callAvatar');
            const color = targetUser.color || '#5765ec';
            const initial = (targetUser.name || '?')[0].toUpperCase();
            avatarEl.style.background = color;
            avatarEl.innerHTML = targetUser.avatar ? `<img src="${targetUser.avatar}">` : initial;
            document.getElementById('callName').textContent = targetUser.name || '匿名';
            document.getElementById('callTypeLabel').textContent =
                callType === 'video' ? '视频通话' : '语音通话';
            // 只显示取消按钮
            document.getElementById('callActions').innerHTML = `
                <div class="call-btn-wrap">
                    <button class="call-btn reject" onclick="cancelOutgoingCall()"><i class="fa fa-phone"></i></button>
                    <div class="call-btn-label">取消</div>
                </div>
            `;
            modal.classList.remove('incoming');  // 主叫方不响铃/不震动
            modal.classList.add('show');
            // 主叫方不播放铃声（用户没要求），仅靠动画提示
        }

        // 主叫取消呼叫
        function cancelOutgoingCall() {
            if (!currentCall) return;
            // 私聊通话主叫主动取消：生成"通话已取消"记录
            const isPrivate = currentCall.isPrivateCall;
            const peerName = currentCall.toUserName || currentCall.name;
            const callType = currentCall.callType;
            if (socket.connected) {
                socket.emit('call-caller-cancel', {
                    callId: currentCall.callId,
                    toSocketId: currentCall.toSocketId
                });
            } else if (currentCall.toUserName) {
                // HTTP 兜底取消
                fetch('/api/call/cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ callId: currentCall.callId, toUserName: currentCall.toUserName })
                }).catch(e => console.error('[HTTP取消通话] 失败', e));
            }
            closeCallModal('cancel');  // 取消动画：缩放淡出
            currentCall = null;
            if (isPrivate && peerName) {
                generatePrivateCallRecord(peerName, callType, 0, 'cancelled');
            }
        }

        // 显示来电界面
        function showIncomingCall(data) {
            // 已知来电 callId 去重（socket + HTTP 轮询可能重复触发）
            if (currentCall && currentCall.callId === data.callId) {
                console.log('[通话] 来电 callId 已存在，跳过', data.callId);
                return;
            }
            // 僵尸状态检测：currentCall 残留超过 15 秒（接听后跳转失败/页面异常等），清理后处理新来电
            // 避免残留的 accepted=true 状态导致所有新来电被自动拒绝（"一直显示被叫拒绝"的根因）
            if (currentCall && currentCall.createdAt && (Date.now() - currentCall.createdAt > 15000)) {
                console.log('[通话] 检测到僵尸通话状态，清理后处理新来电', currentCall.callId, '->', data.callId);
                closeCallModal();
                stopCallRingAndVibrate();
                currentCall = null;
            }
            // 如果已在通话中（已接听），才拒绝并发来电
            if (currentCall && currentCall.accepted === true && currentCall.callId !== data.callId) {
                console.log('[通话] 正在通话中，拒绝并发来电', data.callId);
                if (socket.connected) {
                    socket.emit('call-reject', { callId: data.callId, toSocketId: data.from });
                }
                return;
            }
            // currentCall 存在但未接听（待接听/呼叫中），直接覆盖，允许新来电
            if (currentCall && !currentCall.accepted) {
                console.log('[通话] 覆盖未接听的旧来电', currentCall.callId, '->', data.callId);
                closeCallModal();
                stopCallRingAndVibrate();
                currentCall = null;
            }
            const caller = onlineUsers[data.from] || {};
            currentCall = {
                callId: data.callId,
                toSocketId: data.from,
                fromSocketId: data.from,
                fromUserName: data.fromName || caller.name || '未知',  // 保存主叫用户名用于 HTTP 兜底
                callType: data.callType,
                isOutgoing: false,
                isPrivateCall: !!data.isPrivateCall,  // 标记是否私聊通话（由主叫透传）
                name: data.fromName || caller.name || '未知',
                avatar: caller.avatar,
                color: caller.color,
                roomId: data.roomId,
                createdAt: Date.now()  // 用于检测僵尸状态
            };
            // 保存通话类型和对方头像到 localStorage，供 room 页面语音通话界面使用
            localStorage.setItem('callType', data.callType);
            localStorage.setItem('callPeerAvatar', caller.avatar || '');
            localStorage.setItem('callPeerName', data.fromName || caller.name || '');
            const modal = document.getElementById('callModal');
            document.getElementById('callStatus').textContent = '来电...';
            const avatarEl = document.getElementById('callAvatar');
            const color = caller.color || '#5765ec';
            const initial = (data.fromName || '?')[0].toUpperCase();
            avatarEl.style.background = color;
            avatarEl.innerHTML = caller.avatar ? `<img src="${caller.avatar}">` : initial;
            document.getElementById('callName').textContent = data.fromName || '未知';
            document.getElementById('callTypeLabel').textContent =
                data.callType === 'video' ? '视频通话' : '语音通话';
            // 显示接听和拒绝按钮
            document.getElementById('callActions').innerHTML = `
                <div class="call-btn-wrap">
                    <button class="call-btn reject" onclick="rejectIncomingCall()"><i class="fa fa-phone"></i></button>
                    <div class="call-btn-label">拒绝</div>
                </div>
                <div class="call-btn-wrap">
                    <button class="call-btn accept" onclick="acceptIncomingCall()"><i class="fa fa-phone"></i></button>
                    <div class="call-btn-label">接听</div>
                </div>
            `;
            // 来电样式 + 启动铃声 + 震动
            modal.classList.add('show', 'incoming');
            startCallRingAndVibrate();
        }

        // 接听来电
        function acceptIncomingCall() {
            if (!currentCall) return;
            // 清除来电系统通知（Android）
            try { if (window.AndroidApp && window.AndroidApp.dismissCallNotification) window.AndroidApp.dismissCallNotification(); } catch(e) {}
            // 标记为已接听（用于 showIncomingCall 判断是否拒绝并发来电）
            currentCall.accepted = true;
            // 超时清理：接听后应在 180ms 跳转房间，若 5 秒后仍未跳转（WebView 异常/跳转被拦截），清理 currentCall 避免残留导致后续来电被自动拒绝
            const acceptedCallId = currentCall.callId;
            setTimeout(() => {
                if (currentCall && currentCall.callId === acceptedCallId && currentCall.accepted === true) {
                    console.log('[通话] 接听后跳转超时，清理 currentCall 避免残留', acceptedCallId);
                    currentCall = null;
                    closeCallModal();
                }
            }, 5000);
            if (socket.connected) {
                socket.emit('call-accept', { callId: currentCall.callId, toSocketId: currentCall.toSocketId });
            } else if (currentCall.fromUserName) {
                // HTTP 兜底接受
                fetch('/api/call/respond', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        callId: currentCall.callId,
                        toUserName: currentCall.fromUserName,
                        fromUserName: myName,
                        action: 'accept'
                    })
                }).catch(e => console.error('[HTTP接受通话] 失败', e));
            }
            // 记录通话开始时间到 localStorage
            localStorage.setItem('callStartTime', String(Date.now()));
            localStorage.setItem('callPeerName', currentCall.name || '');
            localStorage.setItem('callType', currentCall.callType || 'voice');
            // 保存通话房间信息，供返回聊天页时显示通话状态横条
            localStorage.setItem('activeCallRoomId', currentCall.roomId || '');
            localStorage.setItem('activeCallPeerName', currentCall.name || '');
            localStorage.setItem('activeCallType', currentCall.callType || 'voice');
            // 私聊通话：被叫方也设置 privateCallPeer，防止通话记录被误发到公用聊天室
            if (currentCall.isPrivateCall) {
                localStorage.setItem('privateCallPeer', currentCall.name || '');
                // 标记为被叫，被叫方不生成通话记录（等主叫方推送）
                localStorage.setItem('callRole', 'callee');
            } else {
                localStorage.removeItem('privateCallPeer');
                localStorage.removeItem('callRole');
            }
            const roomId = currentCall.roomId;
            closeCallModal('accept');  // 接听动画：缩放淡出
            // 通话开始：显示屏幕共享按钮
            nativeSetShareButtonVisible(true);
            // 跳转到房间（稍微延迟，让接听动画播一下）
            setTimeout(() => { window.location.href = `/room/${roomId}`; }, 180);
        }

        // 拒绝来电
        function rejectIncomingCall() {
            if (!currentCall) return;
            // 清除来电系统通知（Android）
            try { if (window.AndroidApp && window.AndroidApp.dismissCallNotification) window.AndroidApp.dismissCallNotification(); } catch(e) {}
            // 私聊通话：被叫方不生成记录（主叫方收到 call-rejected 后会生成并推送，避免重复）
            if (socket.connected) {
                socket.emit('call-reject', { callId: currentCall.callId, toSocketId: currentCall.toSocketId });
            } else if (currentCall.fromUserName) {
                // HTTP 兜底拒绝
                fetch('/api/call/respond', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        callId: currentCall.callId,
                        toUserName: currentCall.fromUserName,
                        fromUserName: myName,
                        action: 'reject'
                    })
                }).catch(e => console.error('[HTTP拒绝通话] 失败', e));
            }
            closeCallModal('reject');  // 拒绝动画：左右抖动后淡出
            currentCall = null;
        }

        // 关闭通话弹窗（带动画效果）
        // type: 'accept' 接听（缩放淡出） / 'reject' 拒绝（左右抖动后淡出） / 'cancel' 取消（缩放淡出） / 默认 立即关闭
        function closeCallModal(type) {
            const modal = document.getElementById('callModal');
            // 立即停止铃声 + 震动
            stopCallRingAndVibrate();
            // 清除 calling 状态文字脉冲动画
            document.getElementById('callStatus').classList.remove('calling');
            if (!modal.classList.contains('show')) {
                modal.classList.remove('incoming', 'closing', 'rejected');
                return;
            }
            if (type === 'reject') {
                // 拒绝：左右抖动后淡出
                modal.classList.add('rejected');
                setTimeout(() => {
                    modal.classList.remove('show', 'incoming', 'closing', 'rejected');
                }, 400);
            } else if (type === 'accept' || type === 'cancel') {
                // 接听/取消：缩放淡出
                modal.classList.add('closing');
                setTimeout(() => {
                    modal.classList.remove('show', 'incoming', 'closing', 'rejected');
                }, 200);
            } else {
                modal.classList.remove('show', 'incoming', 'closing', 'rejected');
            }
        }

        // 页面加载完成后初始化导航栏头像
        (function initNavAvatar() {
            updateNavAvatar();
            // 先加载本地缓存（避免空白等待服务端）
            loadLocalMessages();
            // 再请求服务端最新消息，用服务端数据覆盖本地缓存
            loadServerMessages();
            // 启动 HTTP 持续轮询兜底（外网 socket 推送不可靠，用 HTTP 轮询确保消息实时性）
            startHttpPolling();
            // 通过 HTTP 兜底加载自己头像（socket chat-online-users 事件可能丢失）
            if (myName) {
                fetch('/api/user/avatar-by-name/' + encodeURIComponent(myName))
                    .then(r => r.json())
                    .then(data => {
                        if (data.avatar && !myAvatar) {
                            myAvatar = data.avatar;
                            updateNavAvatar();
                            avatarByName[myName] = data.avatar;
                        }
                    }).catch(e => console.error('加载自己头像失败', e));
            }
            // 检查是否有未完成的通话总结（即使没收到 chat-history）
            setTimeout(checkPendingCallSummary, 500);
            // ===== 好友系统初始化 =====
            initFriendsSystem();
        })();

        // ===== 好友系统逻辑 =====
        let myFriends = [];          // 缓存好友列表
        let friendUnread = {};        // 每个好友的未读消息数（按 peerName 索引）
        let currentPrivatePeer = null;  // 当前打开的私聊对方名称
        let privateMsgsCache = {};   // 每个好友的本地消息缓存（按 peerName 索引，全部消息）

        // Tab 切换
        function switchTab(tab) {
            document.querySelectorAll('.tab-item').forEach(el => el.classList.remove('active'));
            document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add('active');
            document.getElementById('pageChat').style.display = tab === 'chat' ? 'block' : 'none';
            document.getElementById('pageFriends').style.display = tab === 'friends' ? 'block' : 'none';
            document.getElementById('pageSettings').style.display = tab === 'settings' ? 'block' : 'none';
            // 顶部导航
            const navTitle = document.getElementById('navTitle');
            const navMembersBtn = document.getElementById('navMembersBtn');
            const navAddFriendBtn = document.getElementById('navAddFriendBtn');
            const onlineCount = document.getElementById('onlineCount');
            if (tab === 'chat') {
                navTitle.textContent = '消息';
                navMembersBtn.style.display = 'block';
                navAddFriendBtn.style.display = 'none';
                onlineCount.style.display = 'inline';
                // 进入消息 tab 清零未读
                document.getElementById('chatBadge').style.display = 'none';
                document.getElementById('chatBadge').textContent = '0';
            } else if (tab === 'friends') {
                navTitle.textContent = '联系人';
                navMembersBtn.style.display = 'none';
                navAddFriendBtn.style.display = 'block';
                onlineCount.style.display = 'none';
                loadFriendsList();
            } else if (tab === 'settings') {
                navTitle.textContent = '设置';
                navMembersBtn.style.display = 'none';
                navAddFriendBtn.style.display = 'none';
                onlineCount.style.display = 'none';
                loadFriendRequestsBadge();
            }
        }

        // 进入公用聊天室
        function enterPublicChatRoom() {
            document.getElementById('publicChatWrap').style.display = 'flex';
            // 推入历史栈，让 Android 返回键先退出聊天室而不是退出 App
            if (!history.state || history.state.view !== 'publicChat') {
                history.pushState({ view: 'publicChat' }, '');
            }
        }
        function exitPublicChatRoom() {
            document.getElementById('publicChatWrap').style.display = 'none';
            // 关闭可能打开的加号/表情面板，避免返回后残留
            closePlusPanel();
            closeEmojiPanel();
            // 如果当前历史栈是 publicChat，回退一格让栈保持一致
            if (history.state && history.state.view === 'publicChat') {
                history.back();
            }
        }

        // 好友系统初始化
        function initFriendsSystem() {
            // 加载本地缓存的私聊消息
            try {
                const raw = localStorage.getItem('privateMsgsCache');
                if (raw) privateMsgsCache = JSON.parse(raw) || {};
            } catch(e) { console.error('加载私聊缓存失败', e); }
            // 加载好友列表
            loadFriendsList();
            // 加载好友请求
            loadFriendRequestsBadge();
            // 注册 socket 事件
            if (typeof socket !== 'undefined') {
                socket.on('friend-request-incoming', (data) => {
                    showToast(`收到来自 ${data.fromName} 的好友请求`, 'info');
                    loadFriendRequestsBadge();
                });
                socket.on('friend-request-accepted', (data) => {
                    showToast(`${data.friendName} 接受了你的好友请求`, 'success');
                    loadFriendsList();
                });
                socket.on('friend-removed', (data) => {
                    showToast(`${data.by} 将你从好友中删除`, 'info');
                    loadFriendsList();
                });
                socket.on('private-message', (data) => {
                    handleIncomingPrivateMessage(data);
                });
                socket.on('friend-status-change', (data) => {
                    // 好友上线/下线状态变化
                    if (data.friendName) {
                        // 更新本地好友列表的在线状态
                        const f = myFriends.find(f => f.name === data.friendName);
                        if (f) f.online = data.online;
                        // 如果当前在联系人页或消息页，刷新列表
                        const cur = document.getElementById('pageFriends').style.display;
                        if (cur === 'block') loadFriendsList();
                        if (document.getElementById('pageChat').style.display === 'block') renderFriendSessions();
                    }
                });
            }
            // 轮询拉取好友系统更新（外网 socket 不稳定的兜底，每 10 秒拉一次）
            setInterval(() => {
                loadFriendsList();
                loadFriendRequestsBadge();
                pollPrivateMessages();
            }, 10000);
        }

        // 加载好友列表（含在线状态、头像、最后消息）
        async function loadFriendsList() {
            if (!myName) return;
            try {
                const res = await fetch('/api/friends/list?userName=' + encodeURIComponent(myName));
                if (!res.ok) return;
                const data = await res.json();
                myFriends = data.friends || [];
                renderFriendSessions();
                renderFriendsList();
            } catch(e) { console.error('加载好友列表失败', e); }
        }

        // 渲染消息页的好友会话列表
        function renderFriendSessions() {
            const container = document.getElementById('friendSessions');
            if (!container) return;
            if (myFriends.length === 0) {
                container.innerHTML = '<div style="text-align:center;color:#999;padding:40px 20px;font-size:13px;">还没有好友，去联系人页添加好友吧</div>';
                return;
            }
            container.innerHTML = myFriends.map(f => {
                const lastMsg = f.lastMessage;
                let lastText = '点击开始聊天';
                let lastTime = '';
                if (lastMsg) {
                    lastText = lastMsg.content || lastText;
                    lastTime = formatTimeShort(lastMsg.timestamp);
                }
                const unread = friendUnread[f.name] || 0;
                const avatarHtml = f.avatar
                    ? `<img src="${f.avatar}">`
                    : f.name.charAt(0);
                return `<div class="friend-session" onclick="openPrivateChat('${f.name}')">
                    <div class="fs-avatar" style="background:${getUserColorByName(f.name)}">${avatarHtml}${f.online ? '<div class="online-dot"></div>' : ''}</div>
                    <div class="fs-info">
                        <div class="fs-name">${escapeHtml(f.name)}</div>
                        <div class="fs-last">${escapeHtml(lastText)}</div>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;">
                        <span class="fs-time">${lastTime}</span>
                        ${unread > 0 ? `<span class="fs-unread">${unread}</span>` : ''}
                    </div>
                </div>`;
            }).join('');
        }

        // 渲染联系人页的好友列表
        function renderFriendsList() {
            const container = document.getElementById('friendsList');
            if (!container) return;
            if (myFriends.length === 0) {
                container.innerHTML = '<div style="text-align:center;color:#999;padding:40px 20px;font-size:13px;">还没有好友，点击右上角加好友</div>';
                return;
            }
            // 在线优先排序
            const sorted = [...myFriends].sort((a, b) => {
                if (a.online !== b.online) return a.online ? -1 : 1;
                return a.name.localeCompare(b.name);
            });
            container.innerHTML = sorted.map(f => {
                const avatarHtml = f.avatar ? `<img src="${f.avatar}">` : f.name.charAt(0);
                return `<div class="friend-item" onclick="openPrivateChat('${f.name}')">
                    <div class="fs-avatar" style="background:${getUserColorByName(f.name)}">${avatarHtml}${f.online ? '<div class="online-dot"></div>' : ''}</div>
                    <div class="friend-info">
                        <div class="friend-name">${escapeHtml(f.name)}</div>
                        <div class="friend-status ${f.online ? 'online' : ''}">${f.online ? '在线' : '离线'}</div>
                    </div>
                </div>`;
            }).join('');
        }

        // 打开私聊页
        async function openPrivateChat(peerName) {
            currentPrivatePeer = peerName;
            // 清零未读
            friendUnread[peerName] = 0;
            // 创建私聊 UI（覆盖层）
            let wrap = document.getElementById('privateChatWrap');
            if (!wrap) {
                wrap = document.createElement('div');
                wrap.id = 'privateChatWrap';
                wrap.className = 'private-chat-wrap';
                document.body.appendChild(wrap);
            }
            const f = myFriends.find(f => f.name === peerName);
            const avatarHtml = (f && f.avatar) ? `<img src="${f.avatar}">` : peerName.charAt(0);
            wrap.innerHTML = `
                <div class="private-chat-header">
                    <i class="fa fa-angle-left back-btn" onclick="closePrivateChat()"></i>
                    <span class="pc-name">${escapeHtml(peerName)}</span>
                    <div class="pc-actions">
                        <i class="fa fa-ellipsis-v" onclick="showPrivateChatMenu('${peerName}')"></i>
                    </div>
                </div>
                <div class="private-chat-body" id="privateChatBody"></div>
                <div class="private-chat-input">
                    <i class="fa fa-microphone input-voice-btn" id="privateVoiceBtn" onclick="togglePrivateVoiceMode()"></i>
                    <textarea class="input-text" id="privateMsgInput" placeholder="说点什么..." rows="1" style="flex:1;height:40px;max-height:100px;border:1px solid #d9d9d9;border-radius:6px;padding:8px 10px;font-size:16px;background:#fff;outline:none;resize:none;overflow-y:auto;"></textarea>
                    <button class="voice-record-btn" id="privateVoiceRecordBtn" style="display:none;" ontouchstart="startPrivateRecording(event)" ontouchend="stopPrivateRecording(event)" onmousedown="startPrivateRecording(event)" onmouseup="stopPrivateRecording(event)">按住说话</button>
                    <i class="fa fa-smile-o input-emoji-btn" onclick="togglePrivateEmojiPanel()"></i>
                    <i class="fa fa-plus-circle input-plus-btn" id="privatePlusBtn" onclick="togglePrivatePlusPanel()"></i>
                    <button class="input-send-btn" id="privateSendBtn" style="display:none;" onclick="sendPrivateMessage()">发送</button>
                </div>
                <div class="emoji-panel" id="privateEmojiPanel" style="position:absolute;bottom:60px;left:0;right:0;z-index:160;">
                    <div class="emoji-grid" id="privateEmojiGrid"></div>
                </div>
                <div class="plus-panel" id="privatePlusPanel" style="position:absolute;bottom:60px;left:0;right:0;z-index:160;">
                    <div class="plus-item" onclick="document.getElementById('privateMediaInput').click()">
                        <div class="plus-icon" style="background:#fa7268;"><i class="fa fa-photo"></i></div>
                        <span class="plus-label">发送媒体</span>
                    </div>
                    <div class="plus-item" onclick="takePhotoAndSend('private')">
                        <div class="plus-icon" style="background:#5765ec;"><i class="fa fa-camera"></i></div>
                        <span class="plus-label">拍摄</span>
                    </div>
                    <div class="plus-item" onclick="startCallWithFriend('${peerName}', 'video')">
                        <div class="plus-icon" style="background:#5765ec;"><i class="fa fa-phone"></i></div>
                        <span class="plus-label">视频通话</span>
                    </div>
                    <div class="plus-item" onclick="startCallWithFriend('${peerName}', 'voice')">
                        <div class="plus-icon" style="background:#00ae9d;"><i class="fa fa-microphone"></i></div>
                        <span class="plus-label">语音通话</span>
                    </div>
                    <div class="plus-item" onclick="openQualityModal()">
                        <div class="plus-icon" style="background:#ff9c19;"><i class="fa fa-cog"></i></div>
                        <span class="plus-label">画质设置</span>
                    </div>
                </div>
                <input type="file" id="privateMediaInput" accept="image/*,video/*" style="display:none" onchange="sendPrivateMediaMessage(this)">
            `;
            wrap.style.display = 'flex';
            // 触发进入动画（从右滑入）
            wrap.classList.remove('show', 'closing');
            // 强制重排以应用 translateX(100%) 初始状态
            void wrap.offsetWidth;
            requestAnimationFrame(() => wrap.classList.add('show'));
            // 推入历史栈，让 Android 返回键先退出私聊而不是退出 App
            if (!history.state || history.state.view !== 'privateChat') {
                history.pushState({ view: 'privateChat', peer: peerName }, '');
            }
            // 加载消息历史（先本地缓存，再服务端拉取最新）
            await loadPrivateMessagesFromServer(peerName);
            renderPrivateMessages(peerName);
            // 绑定回车发送、输入自动高度、显示/隐藏发送按钮
            const pInput = document.getElementById('privateMsgInput');
            pInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendPrivateMessage(); }
            });
            pInput.addEventListener('input', () => {
                pInput.style.height = 'auto';
                pInput.style.height = Math.min(pInput.scrollHeight, 100) + 'px';
                const sendBtn = document.getElementById('privateSendBtn');
                const plusBtn = document.getElementById('privatePlusBtn');
                const emojiBtn = pInput.parentElement.querySelector('.input-emoji-btn');
                const voiceBtn = document.getElementById('privateVoiceBtn');
                const hasText = pInput.value.trim().length > 0;
                sendBtn.style.display = hasText ? 'block' : 'none';
                plusBtn.style.display = hasText ? 'none' : 'block';
                if (emojiBtn) emojiBtn.style.display = hasText ? 'none' : 'block';
            });
            // 填充表情
            const pGrid = document.getElementById('privateEmojiGrid');
            if (pGrid && pGrid.children.length === 0) {
                EMOJIS.forEach(emoji => {
                    const item = document.createElement('div');
                    item.className = 'emoji-item';
                    item.textContent = emoji;
                    item.onclick = function() { insertPrivateEmoji(emoji); };
                    pGrid.appendChild(item);
                });
            }
        }

        function closePrivateChat() {
            const wrap = document.getElementById('privateChatWrap');
            if (wrap && wrap.classList.contains('show')) {
                // 先播放退出动画，结束后再隐藏
                wrap.classList.remove('show');
                wrap.classList.add('closing');
                const done = () => {
                    wrap.style.display = 'none';
                    wrap.classList.remove('closing');
                    wrap.removeEventListener('transitionend', done);
                };
                wrap.addEventListener('transitionend', done);
                // 兜底：500ms 后强制隐藏
                setTimeout(() => { if (wrap.classList.contains('closing')) { wrap.style.display = 'none'; wrap.classList.remove('closing'); } }, 500);
            } else if (wrap) {
                wrap.style.display = 'none';
            }
            currentPrivatePeer = null;
            // 如果当前历史栈是 privateChat，回退一格让栈保持一致
            if (history.state && history.state.view === 'privateChat') {
                history.back();
            }
        }

        // ===== 私聊版输入栏辅助函数 =====
        let privateVoiceMode = false;
        let privateIsRecording = false;
        let privateMediaRecorder = null;
        let privateVoiceChunks = [];
        let privateRecordStartTime = 0;

        function togglePrivateVoiceMode() {
            privateVoiceMode = !privateVoiceMode;
            const textInput = document.getElementById('privateMsgInput');
            const recordBtn = document.getElementById('privateVoiceRecordBtn');
            const voiceIcon = document.getElementById('privateVoiceBtn');
            if (!textInput || !recordBtn || !voiceIcon) return;
            if (privateVoiceMode) {
                textInput.style.display = 'none';
                recordBtn.style.display = 'block';
                voiceIcon.className = 'fa fa-keyboard input-voice-btn';
            } else {
                textInput.style.display = 'block';
                recordBtn.style.display = 'none';
                voiceIcon.className = 'fa fa-microphone input-voice-btn';
            }
        }

        async function startPrivateRecording(e) {
            e.preventDefault();
            if (privateIsRecording) return;
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                privateMediaRecorder = new MediaRecorder(stream);
                privateVoiceChunks = [];
                privateMediaRecorder.ondataavailable = (ev) => { if (ev.data.size > 0) privateVoiceChunks.push(ev.data); };
                privateMediaRecorder.onstop = () => {
                    const blob = new Blob(privateVoiceChunks, { type: 'audio/webm' });
                    const reader = new FileReader();
                    reader.onloadend = () => {
                        const duration = Math.ceil((Date.now() - privateRecordStartTime) / 1000);
                        if (duration < 1) { showToast('录音太短', 'error'); return; }
                        sendPrivateVoiceMessage(reader.result, duration);
                    };
                    reader.readAsDataURL(blob);
                    stream.getTracks().forEach(t => t.stop());
                };
                privateMediaRecorder.start();
                privateIsRecording = true;
                privateRecordStartTime = Date.now();
                const btn = document.getElementById('privateVoiceRecordBtn');
                btn.classList.add('recording');
                btn.textContent = '松开发送';
            } catch (err) {
                showToast('无法访问麦克风', 'error');
                console.error(err);
            }
        }

        function stopPrivateRecording(e) {
            if (!privateIsRecording) return;
            e.preventDefault();
            privateIsRecording = false;
            if (privateMediaRecorder && privateMediaRecorder.state !== 'inactive') {
                privateMediaRecorder.stop();
            }
            const btn = document.getElementById('privateVoiceRecordBtn');
            btn.classList.remove('recording');
            btn.textContent = '按住说话';
        }

        async function sendPrivateVoiceMessage(content, duration) {
            if (!currentPrivatePeer) return;
            const peer = currentPrivatePeer;
            const msg = {
                id: crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2),
                type: 'voice', sender: myName, content, duration, timestamp: Date.now()
            };
            if (!privateMsgsCache[peer]) privateMsgsCache[peer] = [];
            privateMsgsCache[peer].push(msg);
            savePrivateMsgsCache();
            renderPrivateMessages(peer);
            try {
                await fetch('/api/friends/message', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ from: myName, to: peer, type: 'voice', content, duration, id: msg.id, timestamp: msg.timestamp })
                });
            } catch(e) { showToast('语音发送失败', 'error'); }
        }

        // ===== 私聊版表情/加号面板 =====
        function togglePrivateEmojiPanel() {
            const panel = document.getElementById('privateEmojiPanel');
            if (!panel) return;
            const isOpen = panel.classList.contains('show');
            if (isOpen) closePrivateEmojiPanel();
            else { closePrivatePlusPanel(); panel.classList.add('show'); }
        }
        function closePrivateEmojiPanel() {
            const panel = document.getElementById('privateEmojiPanel');
            if (panel) panel.classList.remove('show');
        }
        function insertPrivateEmoji(emoji) {
            const input = document.getElementById('privateMsgInput');
            if (!input) return;
            const start = input.selectionStart || input.value.length;
            const end = input.selectionEnd || input.value.length;
            input.value = input.value.substring(0, start) + emoji + input.value.substring(end);
            input.focus();
            input.setSelectionRange(start + emoji.length, start + emoji.length);
            input.dispatchEvent(new Event('input'));
        }
        function togglePrivatePlusPanel() {
            const panel = document.getElementById('privatePlusPanel');
            if (!panel) return;
            panel.classList.toggle('show');
            closePrivateEmojiPanel();
        }
        function closePrivatePlusPanel() {
            const panel = document.getElementById('privatePlusPanel');
            if (panel) panel.classList.remove('show');
        }

        // ===== 私聊版发送媒体（图片/视频）=====
        async function sendPrivateMediaMessage(input) {
            const file = input.files[0];
            if (!file) { closePrivatePlusPanel(); return; }
            closePrivatePlusPanel();
            if (file.type.startsWith('image/')) {
                const dataUrl = await compressImage(file, 1280, 0.8);
                if (!dataUrl) { showToast('图片处理失败', 'error'); input.value = ''; return; }
                await sendPrivateMessageOfType('image', dataUrl);
            } else if (file.type.startsWith('video/')) {
                const supportedTypes = ['video/mp4', 'video/webm', 'video/3gpp', 'video/quicktime', 'video/x-matroska'];
                const ext = file.name.split('.').pop().toLowerCase();
                const supportedExts = ['mp4', 'webm', '3gp', 'mov', 'mkv'];
                if (!supportedTypes.includes(file.type) && !supportedExts.includes(ext)) {
                    showToast('不支持的视频格式', 'error'); input.value = ''; return;
                }
                if (file.size > 30 * 1024 * 1024) {
                    showToast('视频不能超过 30MB', 'error'); input.value = ''; return;
                }
                showToast('视频上传中...', 'info');
                const formData = new FormData();
                formData.append('file', file);
                try {
                    const res = await fetch('/api/chat/upload-video', { method: 'POST', body: formData });
                    const data = await res.json();
                    if (data.url) await sendPrivateMessageOfType('video', data.url);
                    else showToast('视频上传失败', 'error');
                } catch(e) { showToast('视频上传失败', 'error'); }
            } else {
                showToast('仅支持图片或视频文件', 'error');
            }
            input.value = '';
        }

        async function sendPrivateMessageOfType(type, content) {
            if (!currentPrivatePeer) return;
            const peer = currentPrivatePeer;
            const msg = {
                id: crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2),
                type, sender: myName, content, duration: 0, timestamp: Date.now()
            };
            if (!privateMsgsCache[peer]) privateMsgsCache[peer] = [];
            privateMsgsCache[peer].push(msg);
            savePrivateMsgsCache();
            renderPrivateMessages(peer);
            try {
                await fetch('/api/friends/message', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ from: myName, to: peer, type, content, id: msg.id, timestamp: msg.timestamp })
                });
            } catch(e) { showToast('发送失败', 'error'); }
        }

        // 渲染私聊消息
        function renderPrivateMessages(peerName) {
            const body = document.getElementById('privateChatBody');
            if (!body) return;
            const msgs = privateMsgsCache[peerName] || [];
            // 渲染私聊消息，并按 5 分钟间隔插入时间分隔符（与公用聊天室一致）
            let lastPrivateTs = null;
            const htmlParts = [];
            msgs.forEach(m => {
                // 时间分隔符：首条消息 或 距上一条超过 5 分钟
                if (!lastPrivateTs || (m.timestamp - lastPrivateTs) >= TIME_GAP_MS) {
                    htmlParts.push(`<div class="time-divider"><span>${formatTimeDivider(m.timestamp)}</span></div>`);
                }
                lastPrivateTs = m.timestamp;
                const isSelf = (m.sender === myName);
                const color = getUserColorByName(m.sender);
                // 头像：优先用 avatarByName 缓存的真实头像，其次用好友列表中的头像，最后用首字母
                const avatarSrc = avatarByName[m.sender] || (myFriends.find(f => f.name === m.sender) || {}).avatar || null;
                let avatarHtml;
                if (avatarSrc) {
                    avatarHtml = `<div class="msg-avatar" style="background:${color}"><img src="${avatarSrc}"></div>`;
                } else {
                    avatarHtml = `<div class="msg-avatar" style="background:${color}">${escapeHtml(m.sender.charAt(0))}</div>`;
                }
                let contentHtml;
                if (m.type === 'image') {
                    contentHtml = `<img src="${m.content}" data-msg-id="${m.id}" style="max-width:180px;max-height:180px;border-radius:4px;cursor:pointer;" onclick="previewPrivateImage('${m.id}')">`;
                } else if (m.type === 'voice') {
                    contentHtml = `<div class="voice-msg" onclick="playPrivateVoice('${m.id}','${peerName}')"><i class="fa fa-play-circle voice-icon"></i><span class="voice-duration">${m.duration || 0}"</span></div>`;
                } else if (m.type === 'video') {
                    contentHtml = `<a href="${m.content}" target="_blank" style="color:#5765ec;"><i class="fa fa-play-circle"></i> [视频消息]</a>`;
                } else if (m.type === 'call') {
                    // 通话记录消息：复用公用聊天室 .call-msg 样式
                    // 支持 callOutcome: 'completed' 已完成 / 'rejected' 被拒绝 / 'cancelled' 已取消
                    const isVideo = m.callType === 'video';
                    const typeLabel = isVideo ? '视频通话' : '语音通话';
                    const peer = escapeHtml(peerName);
                    const outcome = m.callOutcome || (m.duration ? 'completed' : 'completed');
                    let iconClass, bgClass, statusText, durationHtml;
                    if (outcome === 'rejected') {
                        iconClass = 'fa fa-phone';
                        bgClass = 'voice';
                        statusText = '通话被拒绝';
                        durationHtml = '';
                    } else if (outcome === 'cancelled') {
                        iconClass = 'fa fa-phone';
                        bgClass = 'voice';
                        statusText = '通话已取消';
                        durationHtml = '';
                    } else {
                        iconClass = isVideo ? 'fa fa-video-camera' : 'fa fa-phone';
                        bgClass = isVideo ? 'video' : 'voice';
                        statusText = typeLabel;
                        const duration = m.duration ? formatCallDuration(m.duration) : '';
                        durationHtml = duration ? `<div class="call-duration">时长 ${duration}</div>` : '';
                    }
                    contentHtml = `<div class="call-msg">
                        <div class="call-icon ${bgClass}"><i class="${iconClass}"></i></div>
                        <div class="call-text">
                            <div>${isSelf ? '与 ' + peer + ' ' + statusText : peer + ' ' + statusText}</div>
                            ${durationHtml}
                        </div>
                    </div>`;
                } else {
                    contentHtml = escapeHtml(m.content || '');
                }
                // 通话消息气泡使用和公用聊天室一致的白色背景样式（微信风格）
                const isCallMsg = m.type === 'call';
                const bubbleStyle = isCallMsg ? ' style="background:#fff;color:#888;min-width:180px;"' : '';
                const bubbleClass = isCallMsg ? 'msg-bubble call-bubble' : 'msg-bubble';
                htmlParts.push(`<div class="msg-item ${isSelf ? 'self' : ''}">
                    ${avatarHtml}
                    <div class="msg-content-wrap">
                        <div class="msg-name">${escapeHtml(m.sender)}</div>
                        <div class="${bubbleClass}"${bubbleStyle}>${contentHtml}</div>
                        <div class="msg-time">${formatTimeShort(m.timestamp)}</div>
                    </div>
                </div>`);
            });
            body.innerHTML = htmlParts.join('');
            body.scrollTop = body.scrollHeight;
        }

        // 播放私聊语音消息
        function playPrivateVoice(msgId, peerName) {
            const msgs = privateMsgsCache[peerName] || [];
            const msg = msgs.find(m => m.id === msgId);
            if (!msg || !msg.content) { showToast('语音消息不存在', 'error'); return; }
            const audio = new Audio(msg.content);
            const div = document.querySelector(`#privateChatBody .voice-msg`);
            // 更精确：在私聊体内查找包含该 msgId 的语音元素
            const allVoice = document.querySelectorAll('#privateChatBody .voice-msg');
            let targetDiv = null;
            allVoice.forEach(el => {
                if (el.getAttribute('onclick') && el.getAttribute('onclick').indexOf(msgId) >= 0) {
                    targetDiv = el;
                }
            });
            if (targetDiv) targetDiv.classList.add('playing');
            audio.play();
            audio.onended = () => { if (targetDiv) targetDiv.classList.remove('playing'); };
            audio.onerror = () => {
                if (targetDiv) targetDiv.classList.remove('playing');
                showToast('语音播放失败', 'error');
            };
        }

        // 发送私聊消息
        async function sendPrivateMessage() {
            if (!currentPrivatePeer) return;
            const input = document.getElementById('privateMsgInput');
            const text = input.value.trim();
            if (!text) return;
            const peer = currentPrivatePeer;
            const msg = {
                id: crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2),
                type: 'text',
                sender: myName,
                content: text,
                duration: 0,
                timestamp: Date.now()
            };
            // 先本地显示
            if (!privateMsgsCache[peer]) privateMsgsCache[peer] = [];
            privateMsgsCache[peer].push(msg);
            savePrivateMsgsCache();
            renderPrivateMessages(peer);
            input.value = '';
            input.style.height = 'auto';
            input.style.height = Math.min(input.scrollHeight, 100) + 'px';
            // 触发 input 事件：清空后自动隐藏发送按钮，显示加号
            input.dispatchEvent(new Event('input'));
            input.focus();
            // 发送到服务端
            try {
                await fetch('/api/friends/message', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ from: myName, to: peer, type: 'text', content: text, id: msg.id, timestamp: msg.timestamp })
                });
            } catch(e) { console.error('发送私聊失败', e); showToast('发送失败', 'error'); }
        }

        // 处理收到的私聊消息
        function handleIncomingPrivateMessage(data) {
            const peer = data.from || data.sender;
            if (!peer) return;
            if (!privateMsgsCache[peer]) privateMsgsCache[peer] = [];
            // 去重
            if (privateMsgsCache[peer].some(m => m.id === data.id)) return;
            privateMsgsCache[peer].push(data);
            savePrivateMsgsCache();
            // 如果当前正在和对方聊天，直接渲染
            if (currentPrivatePeer === peer) {
                renderPrivateMessages(peer);
            } else {
                // 否则增加未读
                friendUnread[peer] = (friendUnread[peer] || 0) + 1;
                // 更新消息页 badge
                const totalUnread = Object.values(friendUnread).reduce((a,b) => a+b, 0);
                const badge = document.getElementById('chatBadge');
                if (totalUnread > 0) {
                    badge.textContent = totalUnread > 99 ? '99+' : totalUnread;
                    badge.style.display = 'flex';
                } else { badge.style.display = 'none'; }
                // 如果在消息页，刷新会话列表
                if (document.getElementById('pageChat').style.display === 'block') renderFriendSessions();
            }
            // 刷新好友列表的最后消息
            loadFriendsList();
        }

        // 轮询拉取私聊消息（兜底外网 socket 不稳定）
        async function pollPrivateMessages() {
            if (!myName || myFriends.length === 0) return;
            for (const f of myFriends) {
                try {
                    const res = await fetch('/api/friends/messages?userName=' + encodeURIComponent(myName) + '&peerName=' + encodeURIComponent(f.name));
                    if (!res.ok) continue;
                    const data = await res.json();
                    const serverMsgs = data.messages || [];
                    const localMsgs = privateMsgsCache[f.name] || [];
                    const localIds = new Set(localMsgs.map(m => m.id));
                    const newMsgs = serverMsgs.filter(m => !localIds.has(m.id));
                    if (newMsgs.length > 0) {
                        if (!privateMsgsCache[f.name]) privateMsgsCache[f.name] = [];
                        newMsgs.forEach(m => {
                            // 只缓存对方发的消息（自己发的已本地缓存）
                            if (m.sender !== myName) {
                                privateMsgsCache[f.name].push(m);
                                if (currentPrivatePeer !== f.name) {
                                    friendUnread[f.name] = (friendUnread[f.name] || 0) + 1;
                                }
                            }
                        });
                        savePrivateMsgsCache();
                        if (currentPrivatePeer === f.name) renderPrivateMessages(f.name);
                        else {
                            // 更新未读 badge
                            const totalUnread = Object.values(friendUnread).reduce((a,b) => a+b, 0);
                            const badge = document.getElementById('chatBadge');
                            if (totalUnread > 0) {
                                badge.textContent = totalUnread > 99 ? '99+' : totalUnread;
                                badge.style.display = 'flex';
                            }
                        }
                    }
                } catch(e) {}
            }
        }

        // 从服务端加载私聊消息（打开私聊时）
        async function loadPrivateMessagesFromServer(peerName) {
            try {
                const res = await fetch('/api/friends/messages?userName=' + encodeURIComponent(myName) + '&peerName=' + encodeURIComponent(peerName));
                if (!res.ok) return;
                const data = await res.json();
                const serverMsgs = data.messages || [];
                // 合并：本地缓存 + 服务端消息，去重
                const localMsgs = privateMsgsCache[peerName] || [];
                const allMsgs = [...localMsgs];
                const localIds = new Set(localMsgs.map(m => m.id));
                serverMsgs.forEach(m => { if (!localIds.has(m.id)) allMsgs.push(m); });
                // 按时间排序
                allMsgs.sort((a,b) => a.timestamp - b.timestamp);
                privateMsgsCache[peerName] = allMsgs;
                savePrivateMsgsCache();
            } catch(e) { console.error('加载私聊消息失败', e); }
        }

        // 保存私聊缓存到 localStorage（全部消息存客户端）
        function savePrivateMsgsCache() {
            try { localStorage.setItem('privateMsgsCache', JSON.stringify(privateMsgsCache)); }
            catch(e) { console.error('保存私聊缓存失败', e); }
        }

        // 好友请求 badge
        async function loadFriendRequestsBadge() {
            if (!myName) return;
            try {
                const res = await fetch('/api/friends/requests?userName=' + encodeURIComponent(myName));
                if (!res.ok) return;
                const data = await res.json();
                const count = (data.requests || []).length;
                const badge = document.getElementById('friendReqBadge');
                if (count > 0) { badge.textContent = count; badge.style.display = 'flex'; }
                else { badge.style.display = 'none'; }
            } catch(e) {}
        }

        // 加好友 modal
        function showAddFriendModal() {
            // 微信风格：顶部返回栏 + 搜索输入框 + 搜索按钮
            const html = `
                <div style="display:flex;align-items:center;padding:12px;gap:8px;border-bottom:1px solid #e0e0e0;">
                    <i class="fa fa-angle-left" style="font-size:24px;color:#181818;cursor:pointer;padding:4px;" onclick="closeModal()"></i>
                    <span style="font-size:16px;font-weight:500;flex:1;">添加好友</span>
                </div>
                <div style="padding:12px;">
                    <div style="display:flex;gap:8px;">
                        <input type="text" id="addFriendInput" placeholder="输入对方名字" style="flex:1;height:40px;border:1px solid #d9d9d9;border-radius:6px;padding:0 12px;font-size:15px;outline:none;" onkeydown="if(event.key==='Enter'){searchUsers(document.getElementById('addFriendInput').value.trim());}">
                        <button onclick="searchUsers(document.getElementById('addFriendInput').value.trim())" style="background:#07c160;color:#fff;border:none;padding:0 16px;border-radius:6px;font-size:14px;">搜索</button>
                    </div>
                    <div id="searchResults" style="margin-top:12px;max-height:50vh;overflow-y:auto;"></div>
                </div>
                <div style="padding:0 12px 12px;text-align:center;">
                    <button class="modal-btn cancel" onclick="closeModal()" style="width:100%;height:40px;background:#f0f0f0;color:#666;border:none;border-radius:6px;font-size:14px;">关闭</button>
                </div>`;
            showModal(html);
            const input = document.getElementById('addFriendInput');
            input.focus();
            let timer;
            input.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(() => searchUsers(input.value.trim()), 500);
            });
        }

        async function searchUsers(q) {
            const results = document.getElementById('searchResults');
            if (!q) { results.innerHTML = ''; return; }
            try {
                const res = await fetch('/api/friends/search?q=' + encodeURIComponent(q) + '&myName=' + encodeURIComponent(myName));
                if (!res.ok) return;
                const data = await res.json();
                const users = data.users || [];
                if (users.length === 0) {
                    results.innerHTML = '<div style="text-align:center;color:#999;padding:20px;font-size:13px;">未找到用户</div>';
                    return;
                }
                results.innerHTML = users.map(u => {
                    const avatarHtml = u.avatar ? `<img src="${u.avatar}" style="width:36px;height:36px;border-radius:6px;object-fit:cover;">` : `<div style="width:36px;height:36px;border-radius:6px;background:${getUserColorByName(u.name)};color:#fff;display:flex;align-items:center;justify-content:center;">${u.name.charAt(0)}</div>`;
                    let btnHtml;
                    if (u.isFriend) {
                        btnHtml = '<span style="color:#07c160;font-size:13px;">已是好友</span>';
                    } else {
                        btnHtml = `<button onclick="sendFriendRequest('${u.name}')" style="background:#07c160;color:#fff;border:none;padding:6px 12px;border-radius:4px;font-size:13px;">加好友</button>`;
                    }
                    return `<div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #f0f0f0;">
                        ${avatarHtml}
                        <div style="flex:1;">
                            <div style="font-size:14px;color:#181818;">${escapeHtml(u.name)}</div>
                            <div style="font-size:11px;color:${u.online ? '#07c160' : '#999'};">${u.online ? '在线' : '离线'}</div>
                        </div>
                        ${btnHtml}
                    </div>`;
                }).join('');
            } catch(e) { console.error('搜索失败', e); }
        }

        async function sendFriendRequest(toName) {
            try {
                const res = await fetch('/api/friends/request', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ from: myName, to: toName, message: '我是 ' + myName })
                });
                const data = await res.json();
                if (data.alreadyFriend) showToast('你们已经是好友了', 'info');
                else if (data.pending) showToast('已发送过请求，等待对方同意', 'info');
                else showToast('好友请求已发送', 'success');
            } catch(e) { showToast('发送失败', 'error'); }
        }

        // 显示好友请求列表
        async function showFriendRequests() {
            try {
                const res = await fetch('/api/friends/requests?userName=' + encodeURIComponent(myName));
                if (!res.ok) return;
                const data = await res.json();
                const reqs = data.requests || [];
                let html = `<div class="modal-title">好友请求</div><div class="modal-content">`;
                if (reqs.length === 0) {
                    html += '<div style="text-align:center;color:#999;padding:40px 0;font-size:13px;">暂无好友请求</div>';
                } else {
                    html += reqs.map(r => {
                        const avatarHtml = r.avatar ? `<img src="${r.avatar}" style="width:40px;height:40px;border-radius:6px;object-fit:cover;">` : `<div style="width:40px;height:40px;border-radius:6px;background:${getUserColorByName(r.from)};color:#fff;display:flex;align-items:center;justify-content:center;">${r.from.charAt(0)}</div>`;
                        return `<div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #f0f0f0;">
                            ${avatarHtml}
                            <div style="flex:1;">
                                <div style="font-size:14px;color:#181818;">${escapeHtml(r.from)}</div>
                                <div style="font-size:12px;color:#999;">${escapeHtml(r.message || '')}</div>
                            </div>
                            <button onclick="acceptFriendRequest('${r.from}')" style="background:#07c160;color:#fff;border:none;padding:6px 12px;border-radius:4px;font-size:13px;">接受</button>
                            <button onclick="rejectFriendRequest('${r.from}')" style="background:#fa5151;color:#fff;border:none;padding:6px 12px;border-radius:4px;font-size:13px;">拒绝</button>
                        </div>`;
                    }).join('');
                }
                html += `</div><div class="modal-buttons"><button class="modal-btn cancel" onclick="closeModal()">关闭</button></div>`;
                showModal(html);
            } catch(e) { showToast('加载失败', 'error'); }
        }

        async function acceptFriendRequest(fromName) {
            try {
                await fetch('/api/friends/accept', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ from: fromName, to: myName })
                });
                showToast('已添加为好友', 'success');
                closeModal();
                loadFriendsList();
                loadFriendRequestsBadge();
            } catch(e) { showToast('操作失败', 'error'); }
        }
        async function rejectFriendRequest(fromName) {
            try {
                await fetch('/api/friends/reject', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ from: fromName, to: myName })
                });
                closeModal();
                loadFriendRequestsBadge();
            } catch(e) { showToast('操作失败', 'error'); }
        }

        // 私聊页右上角菜单（删除好友）
        function showPrivateChatMenu(peerName) {
            const html = `
                <div class="modal-title">${escapeHtml(peerName)}</div>
                <div class="modal-content">
                    <button onclick="confirmDeleteFriend('${peerName}')" style="width:100%;height:44px;background:#fa5151;color:#fff;border:none;border-radius:6px;font-size:15px;margin-bottom:8px;">删除好友</button>
                    <button onclick="startCallWithFriend('${peerName}')" style="width:100%;height:44px;background:#07c160;color:#fff;border:none;border-radius:6px;font-size:15px;">语音通话</button>
                </div>
                <div class="modal-buttons"><button class="modal-btn cancel" onclick="closeModal()">取消</button></div>`;
            showModal(html);
        }
        function confirmDeleteFriend(peerName) {
            const html = `<div class="modal-title">删除好友</div>
                <div class="modal-content"><p style="text-align:center;color:#666;">确定删除好友"${escapeHtml(peerName)}"吗？删除后将无法互发消息。</p></div>
                <div class="modal-buttons">
                    <button class="modal-btn cancel" onclick="closeModal()">取消</button>
                    <button class="modal-btn confirm" onclick="doDeleteFriend('${peerName}')" style="background:#fa5151;color:#fff;">删除</button>
                </div>`;
            showModal(html);
        }
        async function doDeleteFriend(peerName) {
            try {
                await fetch('/api/friends/delete?from=' + encodeURIComponent(myName) + '&to=' + encodeURIComponent(peerName), { method: 'DELETE' });
                showToast('已删除好友', 'info');
                closeModal();
                closePrivateChat();
                loadFriendsList();
            } catch(e) { showToast('删除失败', 'error'); }
        }
        async function startCallWithFriend(peerName, callType) {
            closeModal();
            callType = callType || 'voice';
            // 复用现有的通话流程：把 peerName 当作在线成员呼叫
            // 检查在线状态
            const f = myFriends.find(f => f.name === peerName);
            if (!f || !f.online) { showToast('对方不在线', 'error'); return; }
            // 标记为私聊通话，通话结束后写入私聊消息（而非公用聊天室）
            localStorage.setItem('privateCallPeer', peerName);
            // 直接对好友发起呼叫（不走选择用户弹窗），传 isPrivateCall=true 防止 inviteCall 清除 privateCallPeer
            if (f.socketId) {
                inviteCall({ socketId: f.socketId, name: peerName, avatar: f.avatar, color: getUserColorByName(peerName) }, callType, true);
            } else {
                // 通过 online-users API 拿 socketId
                try {
                    const res = await fetch('/api/chat/online-users');
                    const data = await res.json();
                    const u = (data.users || []).find(u => u.name === peerName);
                    if (u) inviteCall(u, callType, true);
                    else showToast('对方不在线', 'error');
                } catch(e) { showToast('获取在线信息失败', 'error'); }
            }
        }

        // 工具函数
        function formatTimeShort(ts) {
            if (!ts) return '';
            const d = new Date(ts);
            const now = new Date();
            if (d.toDateString() === now.toDateString()) {
                return d.toTimeString().slice(0,5);
            }
            return (d.getMonth()+1) + '/' + d.getDate();
        }
        function escapeHtml(s) {
            if (!s) return '';
            return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        }
        // 简化版 showModal（如果不存在）
        function showModal(html) {
            let mask = document.getElementById('modalMask');
            if (!mask) {
                mask = document.createElement('div');
                mask.id = 'modalMask';
                mask.className = 'modal-mask';
                document.body.appendChild(mask);
                // 点击遮罩层空白处关闭（模拟微信侧滑返回）
                mask.addEventListener('click', (e) => {
                    if (e.target === mask) closeModal();
                });
            }
            mask.innerHTML = `<div class="modal-box">${html}</div>`;
            mask.classList.add('show');
            mask.style.display = 'flex';
            // 推入历史栈，让 Android 返回键能关闭弹窗（避免直接退出 App）
            if (!history.state || history.state.view !== 'modal') {
                history.pushState({ view: 'modal' }, '');
            }
        }
        function closeModal() {
            const mask = document.getElementById('modalMask');
            if (mask) {
                mask.classList.remove('show');
                mask.style.display = 'none';
            }
            // 如果当前历史栈是 modal，回退一格保持栈一致
            if (history.state && history.state.view === 'modal') {
                history.back();
            }
        }

        // ===== Android 返回键处理（popstate）=====
        // 按返回键时根据当前栈状态关闭对应 UI，而不是直接退出 App
        window.addEventListener('popstate', () => {
            const state = history.state || {};
            const mask = document.getElementById('modalMask');
            const publicWrap = document.getElementById('publicChatWrap');
            const privateWrap = document.getElementById('privateChatWrap');
            // 优先级：弹窗 > 私聊 > 公用聊天室
            if (mask && mask.classList.contains('show')) {
                mask.classList.remove('show');
                mask.style.display = 'none';
            } else if (privateWrap && privateWrap.classList.contains('show')) {
                // 触发退出动画
                privateWrap.classList.remove('show');
                privateWrap.classList.add('closing');
                const done = () => {
                    privateWrap.style.display = 'none';
                    privateWrap.classList.remove('closing');
                    privateWrap.removeEventListener('transitionend', done);
                };
                privateWrap.addEventListener('transitionend', done);
                setTimeout(() => { if (privateWrap.classList.contains('closing')) { privateWrap.style.display = 'none'; privateWrap.classList.remove('closing'); } }, 500);
                currentPrivatePeer = null;
            } else if (publicWrap && publicWrap.style.display !== 'none') {
                publicWrap.style.display = 'none';
                // 关闭可能打开的加号/表情面板，避免侧滑返回后残留
                closePlusPanel();
                closeEmojiPanel();
            }
        });
        // 预览图片（私聊）
        function previewPrivateImage(msgId) {
            // 简化版预览
            const body = document.getElementById('privateChatBody');
            if (!body) return;
            const item = body.querySelector(`img[data-msg-id="${msgId}"]`) || body.querySelector(`[data-msg-id="${msgId}"] img`);
            if (item) {
                const mask = document.getElementById('imagePreview');
                if (mask) {
                    // 复用公用聊天室的预览组件
                    document.getElementById('previewImg').src = item.src;
                    mask.classList.add('show');
                } else {
                    const w = window.open('', '_blank');
                    if (w) w.document.write(`<img src="${item.src}" style="max-width:100%;">`);
                }
            }
        }

        // 修改头像/名字（设置页）
        function changeAvatar() { document.getElementById('avatarInput') && document.getElementById('avatarInput').click(); }
        function changeName() { 
            const newName = prompt('请输入新名字', myName);
            if (newName && newName.trim() && newName !== myName) {
                // 复用现有的改名逻辑
                if (typeof renameUser === 'function') renameUser(newName.trim());
                else { localStorage.setItem('userName', newName.trim()); location.reload(); }
            }
        }
    </script>
</body>

