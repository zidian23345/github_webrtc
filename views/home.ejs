        // Android WebView 不支持 <input capture>，通过 JS bridge 调用原生相机
        window.__photoCallbacks = {};
        window.__takePhotoResult = function(callbackId, dataUrl) {
            if (window.__photoCallbacks[callbackId]) {
                const cb = window.__photoCallbacks[callbackId];
                delete window.__photoCallbacks[callbackId];
                cb(dataUrl || null);
            }
        };
        // 调用原生相机拍照，返回 dataUrl 或 null
        function nativeTakePhoto() {
            if (!window.AndroidApp || typeof window.AndroidApp.takePhoto !== 'function') return Promise.resolve(null);
            const callbackId = 'photo_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6);
            return new Promise(resolve => {
                window.__photoCallbacks[callbackId] = resolve;
                try { window.AndroidApp.takePhoto(callbackId); } catch(e) { delete window.__photoCallbacks[callbackId]; resolve(null); }
                // 60 秒超时
                setTimeout(() => { if (window.__photoCallbacks[callbackId]) { delete window.__photoCallbacks[callbackId]; resolve(null); } }, 60000);
            });
        }
