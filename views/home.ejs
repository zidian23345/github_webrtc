        async function saveName() {
            const newName = document.getElementById('nameInput').value.trim();
            const pwInput = document.getElementById('namePasswordInput');
            if (!newName) { showToast('请输入名称', 'error'); return; }
            if (newName === myName) { closeNameModal(); return; }
            if (!myName) {
                const inputPassword = pwInput.value;
                // 密码框已显示（名称受保护）但未输入密码
                if (pwInput.style.display !== 'none' && !inputPassword) {
                    showToast('该名称已设置密码，请输入密码或换个名称', 'error');
                    return;
