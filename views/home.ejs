    <script src="/socket.io/socket.io.js"></script>
    <script>
        // ===== Socket.IO 连接（稳定性配置）=====
        // polling 优先 + 允许升级：
        // - 内网：polling 建立后自动升级到 websocket（实时推送，毫秒级延迟）
        // - 外网：自签名证书 wss 升级失败，保持 polling（至少可用，配合 HTTP 兜底）
        const socket = io('/', {
            secure: window.location.protocol === 'https:',
            reconnection: true,
            reconnectionAttempts: Infinity,
            reconnectionDelay: 1000,
            reconnectionDelayMax: 5000,
            timeout: 20000,
            transports: ['polling', 'websocket'],  // polling 优先，可升级
            upgrade: true  // 允许 polling→websocket 升级
        });
        // 监听 transport 切换，便于诊断视频发送问题
        socket.io.on('transport', (transport) => {
            console.log('[Socket.IO] 当前传输:', transport.name);
        });
        socket.on('connect_error', (err) => {
            console.warn('[Socket.IO] 连接错误:', err.message);
        });

        // ===== 状态管理 =====
        let mySocketId = null;
        let myName = localStorage.getItem('meetingUserName') || sessionStorage.getItem('meetingUserName') || '';
        let myColor = '#07c160';
        // 头像缓存（按 userName 索引），从在线用户事件填充，避免消息中存储大 base64
        const avatarByName = {};
        // ===== 持久化用户ID（改名/刷新都不变，用于识别自己发的消息）=====
        let myUserId = localStorage.getItem('meetingUserId');
        if (!myUserId) {
            myUserId = 'u_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
            localStorage.setItem('meetingUserId', myUserId);
        }

        // ===== Android 原生界面控制 =====
        // 控制原生屏幕共享按钮显示/隐藏（仅 Android App 中有效，浏览器中无操作）
        function nativeSetShareButtonVisible(visible) {
            try {
                if (window.AndroidApp && window.AndroidApp.setScreenShareButtonVisible) {
                    window.AndroidApp.setScreenShareButtonVisible(visible);
                }
            } catch(e) { /* 浏览器环境忽略 */ }
        }
        // 页面加载时默认隐藏屏幕共享按钮（仅通话中才显示）
        nativeSetShareButtonVisible(false);
        let myAvatar = null;  // 当前用户头像 base64
        let onlineUsers = {};
        let offlineUsers = new Map();  // 离线用户缓存（socketId -> 用户信息），最多保留 50 个
        const MAX_OFFLINE_USERS = 50;
        let nameLockedUntil = parseInt(localStorage.getItem('nameLockedUntil') || '0');
        let voiceMode = false;  // 语音模式开关
        let isRecording = false;
        let mediaRecorder = null;
        let voiceChunks = [];
        let recordStartTime = 0;
        let currentContextMenuMsgId = null;
        let bannedFromChat = false;
        let bannedFromMeeting = false;
        let avatarBanned = false;  // 头像功能是否被禁用
        let messagesMap = {};  // 存储所有消息，用于查找
        let quotingMsg = null;  // 当前引用的消息对象（null 表示未引用）

        // ===== 时间分隔线追踪 =====
        // 记录上一条普通消息的时间戳，用于5分钟无消息时插入时间分隔线
        let lastMsgTimestamp = null;

        // ===== 通话铃声 + 震动控制 =====
        // 来电时循环播放铃声 + 震动；接听/拒绝/取消时停止
        // 铃声文件：public/sounds/ring.mp3（从用户下载文件夹拷贝）
        let callRingAudio = null;       // Audio 对象
        let callVibrateTimer = null;   // 震动循环定时器（navigator.vibrate 不支持无限循环，用定时器模拟）
        let callRingUnlocked = false;  // Audio 是否已 unlock（WebView 默认禁自动播放，需首次用户交互解锁）
        // 预加载铃声（避免来电时才加载导致延迟）
        (function preloadCallRing() {
            try {
                callRingAudio = new Audio('/sounds/ring.mp3');
                callRingAudio.loop = true;
                callRingAudio.preload = 'auto';
                callRingAudio.load();
            } catch(e) { console.warn('[铃声] 预加载失败', e); }
            // WebView 默认禁用音频自动播放，监听首次用户交互 unlock
            // 监听 touchstart/click 一次，调用 play() 然后 pause() 给 audio 解封
            const unlock = () => {
                if (callRingUnlocked) return;
                try {
                    if (callRingAudio) {
                        callRingAudio.play().then(() => {
                            callRingAudio.pause();
                            callRingAudio.currentTime = 0;
                            callRingUnlocked = true;
                            console.log('[铃声] Audio 已解锁');
                        }).catch(e => { /* 静默 */ });
                    }
                } catch(e) { /* 忽略 */ }
            };
            document.addEventListener('touchstart', unlock, { once: false, passive: true });
            document.addEventListener('click', unlock, { once: false, passive: true });
        })();
        // 启动来电铃声 + 震动
        function startCallRingAndVibrate() {
            // 铃声
            try {
                if (callRingAudio) {
                    callRingAudio.currentTime = 0;
                    const p = callRingAudio.play();
                    if (p && p.catch) p.catch(e => console.warn('[铃声] 播放失败（可能需要用户手势）', e.name));
                }
            } catch(e) { console.warn('[铃声] 异常', e); }
            // 震动：先调原生 bridge（Android），没有则用 navigator.vibrate（web/部分 WebView）
            try {
                if (window.AndroidApp && typeof window.AndroidApp.vibrate === 'function') {
                    window.AndroidApp.vibrate(400);  // 单次震动 400ms，靠定时器循环
                } else if (navigator.vibrate) {
                    navigator.vibrate(400);
                }
            } catch(e) { /* 忽略 */ }
            // 循环震动（每 800ms 一次：震 400ms + 停 400ms）
            if (callVibrateTimer) clearInterval(callVibrateTimer);
            callVibrateTimer = setInterval(() => {
                try {
                    if (window.AndroidApp && typeof window.AndroidApp.vibrate === 'function') {
                        window.AndroidApp.vibrate(400);
                    } else if (navigator.vibrate) {
                        navigator.vibrate(400);
                    }
                } catch(e) { /* 忽略 */ }
            }, 800);
        }
        // 停止铃声 + 震动
        function stopCallRingAndVibrate() {
            try {
                if (callRingAudio) {
                    callRingAudio.pause();
                    callRingAudio.currentTime = 0;
                }
            } catch(e) { /* 忽略 */ }
            if (callVibrateTimer) {
                clearInterval(callVibrateTimer);
                callVibrateTimer = null;
            }
            try {
                if (navigator.vibrate) navigator.vibrate(0);  // 立即停止震动
            } catch(e) { /* 忽略 */ }
        }

        // ===== HTTP 轮询兜底机制（Socket.IO 断连时使用）=====
        // 外网用户 socket 频繁断连，HTTP 走 fetch 走得通（测试 200 OK）
        // 当 socket 断连时，启动定时器每 4 秒 fetch 增量同步最新消息
        let lastReceivedMsgTimestamp = 0;  // 已接收的最新消息时间戳（用于增量同步）
        let httpPollingTimer = null;       // HTTP 轮询定时器
        let isHttpPolling = false;         // 是否正在轮询中（防止重叠请求）

        // 格式化时间分隔线（微信风格：今天显示时分；昨天显示"昨天 HH:MM"；更早显示日期）
        function formatTimeDivider(ts) {
            const d = new Date(ts);
            const now = new Date();
            const h = String(d.getHours()).padStart(2, '0');
            const m = String(d.getMinutes()).padStart(2, '0');
            const todayStr = `${h}:${m}`;

            const yesterday = new Date(now);
            yesterday.setDate(now.getDate() - 1);
            const isSameDay = (a, b) => a.toDateString() === b.toDateString();

            if (isSameDay(d, now)) return todayStr;
            if (isSameDay(d, yesterday)) return `昨天 ${todayStr}`;

            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            const year = d.getFullYear();
            if (year === now.getFullYear()) return `${month}月${day}日 ${todayStr}`;
            return `${year}/${month}/${day} ${todayStr}`;
        }

        // 判断是否需要插入时间分隔线：超过5分钟无消息则插入
        const TIME_GAP_MS = 5 * 60 * 1000;
        function maybeInsertTimeDivider(ts) {
            if (!ts) return;
            // 加载历史时不插分隔线（在批量加载结束后统一处理）
            if (isLoadingFromCache) return;
            if (lastMsgTimestamp && (ts - lastMsgTimestamp) >= TIME_GAP_MS) {
                const list = document.getElementById('chatList');
                const div = document.createElement('div');
                div.className = 'time-divider';
                div.innerHTML = `<span>${formatTimeDivider(ts)}</span>`;
                list.appendChild(div);
            }
            lastMsgTimestamp = ts;
        }

        // 历史消息加载完毕后，按时间戳重新生成时间分隔线
        function rebuildTimeDividers() {
            const list = document.getElementById('chatList');
            list.querySelectorAll('.time-divider').forEach(el => el.remove());
            lastMsgTimestamp = null;
            list.querySelectorAll('.msg-item').forEach(el => {
                const ts = parseInt(el.dataset.ts || '0', 10);
                if (ts) {
                    // 在当前消息前插入分隔线（而不是 append 到列表末尾）
                    if (lastMsgTimestamp && (ts - lastMsgTimestamp) >= TIME_GAP_MS) {
                        const div = document.createElement('div');
                        div.className = 'time-divider';
                        div.innerHTML = `<span>${formatTimeDivider(ts)}</span>`;
                        list.insertBefore(div, el);
                    }
                    lastMsgTimestamp = ts;
                }
            });
        }

        // ===== 系统消息折叠状态 =====
        // lastSystemFold 用于追踪连续的加入/离开系统消息
        // 结构: { type: 'join'|'leave', count: 0, names: [], element: HTMLElement, mainSpan: HTMLElement }
        let lastSystemFold = null;

        // ===== 通话状态 =====
        // currentCall 结构: { callId, toSocketId, fromSocketId, callType, isOutgoing, name, avatar, color }
        let currentCall = null;

        // ===== 获取用户名称（持久化到 localStorage）=====
        function getUserName() {
            // 优先使用 localStorage（用户改名后这里存的是最新名字）
            const local = localStorage.getItem('meetingUserName');
            if (local && local.trim()) return local;
            // localStorage 没有时，从 Android 端读取（首次安装时设置的名称）
            try {
                if (window.AndroidApp && window.AndroidApp.getUserName) {
                    const androidName = window.AndroidApp.getUserName();
                    if (androidName && androidName.trim()) {
                        localStorage.setItem('meetingUserName', androidName);
                        return androidName;
                    }
                }
            } catch(e) {}
            // 兼容旧版 sessionStorage
            const session = sessionStorage.getItem('meetingUserName');
            if (session) {
                localStorage.setItem('meetingUserName', session);
                return session;
            }
            return '';
        }

        // ===== 同步名称到 Android 端（改名时调用，避免刷新后恢复旧名）=====
        function syncNameToAndroid(name) {
            try {
                if (window.AndroidApp && window.AndroidApp.setUserName) {
                    window.AndroidApp.setUserName(name);
                }
            } catch(e) {}
        }

        // ===== 按服务器 IP 找回最近使用的名称（清缓存后自动恢复）=====
        async function recoverNameFromServer() {
            try {
                const res = await fetch('/api/chat/name-by-ip');
                if (!res.ok) return null;
                const data = await res.json();
                const name = data && data.name;
                return (name && String(name).trim()) ? String(name).trim() : null;
            } catch (e) {
                return null;
            }
        }

        let toastTimer = null;
        function showToast(msg, type) {
            const toast = document.getElementById('toast');
            // 清除上一次的定时器，避免连续提示时前一条提前关闭后一条
            if (toastTimer) clearTimeout(toastTimer);
            toast.textContent = msg;
            toast.className = 'toast show' + (type ? ' ' + type : '');
            toastTimer = setTimeout(() => {
                toast.className = 'toast';
                toastTimer = null;
            }, 2500);
        }

        function formatTime(ts) {
            const d = new Date(ts);
            const now = new Date();
            const h = String(d.getHours()).padStart(2, '0');
            const m = String(d.getMinutes()).padStart(2, '0');
            if (d.toDateString() === now.toDateString()) return `${h}:${m}`;
            return `${d.getMonth()+1}/${d.getDate()} ${h}:${m}`;
        }

        // ===== localStorage 缓存聊天记录 =====
        let isLoadingFromCache = false;
        // 骨架屏控制：首次加载历史消息时显示
        let isFirstLoadDone = false;
        function showChatSkeleton() {
            const sk = document.getElementById('chatSkeleton');
            if (sk) sk.style.display = 'block';
        }
        function hideChatSkeleton() {
            const sk = document.getElementById('chatSkeleton');
            if (sk) sk.style.display = 'none';
        }

        function loadLocalMessages() {
            try {
                const cache = localStorage.getItem('chatHistoryCache');
                if (!cache) return;
                let msgs = JSON.parse(cache);
                if (Array.isArray(msgs) && msgs.length > 0) {
                    // 清理旧缓存中的 avatar 字段（旧版本每条消息存了 320KB base64 头像）
                    let hasOldAvatar = false;
                    msgs = msgs.map(m => {
                        if (m && m.avatar) { hasOldAvatar = true; const { avatar, ...rest } = m; return rest; }
                        return m;
                    });
                    // 清理旧版本误发到群聊的私聊通话记录（target=private）
                    const beforeLen = msgs.length;
                    msgs = msgs.filter(m => !m || !m.target || m.target === 'group');
                    if (hasOldAvatar || msgs.length !== beforeLen) {
                        // 重写清理后的缓存
                        try { localStorage.setItem('chatHistoryCache', JSON.stringify(msgs)); } catch(e) {}
                    }
                    isLoadingFromCache = true;
                    msgs.forEach(msg => appendMessage(msg));
                    isLoadingFromCache = false;
                    // 批量加载完成后统一重建时间分隔线
                    rebuildTimeDividers();
                }
            } catch(e) { console.error('加载本地缓存失败', e); isLoadingFromCache = false; }
        }

        function saveLocalMessage(msg) {
            try {
                let cache = [];
                const raw = localStorage.getItem('chatHistoryCache');
                if (raw) cache = JSON.parse(raw) || [];
                if (!Array.isArray(cache)) cache = [];
                // 不缓存 avatar 字段（320KB base64 会导致 localStorage 溢出）
                const msgNoAvatar = msg.avatar ? Object.assign({}, msg, { avatar: null }) : msg;
                cache.push(msgNoAvatar);
                // 限制最多 1000 条，超出从头删除
                if (cache.length > 1000) {
                    cache = cache.slice(cache.length - 1000);
                }
                localStorage.setItem('chatHistoryCache', JSON.stringify(cache));
            } catch(e) { console.error('保存本地缓存失败', e); }
        }

        function updateLocalMessageField(msgId, field, value) {
            try {
                const raw = localStorage.getItem('chatHistoryCache');
                if (!raw) return;
                const cache = JSON.parse(raw);
                if (!Array.isArray(cache)) return;
                const idx = cache.findIndex(m => m.id === msgId);
                if (idx >= 0) {
                    cache[idx][field] = value;
                    localStorage.setItem('chatHistoryCache', JSON.stringify(cache));
                }
            } catch(e) { console.error('更新本地缓存失败', e); }
        }

        function clearLocalMessagesCache() {
            try { localStorage.removeItem('chatHistoryCache'); } catch(e) {}
        }

        // 从本地缓存移除单条消息
        function removeLocalMessage(msgId) {
            try {
                const cache = JSON.parse(localStorage.getItem('chatHistoryCache') || '[]');
                const idx = cache.findIndex(m => m.id === msgId);
                if (idx !== -1) {
                    cache.splice(idx, 1);
                    localStorage.setItem('chatHistoryCache', JSON.stringify(cache));
                }
            } catch(e) {}
        }

        // 请求服务端最新消息（增量更新：只追加本地没有的新消息，不清空列表）
        async function loadServerMessages() {
            // 首次加载时显示骨架屏
            if (!isFirstLoadDone) {
                showChatSkeleton();
            }
            try {
                const res = await fetch('/api/chat/history?limit=500');
                if (!res.ok) return;
                const data = await res.json();
                if (data.messages && Array.isArray(data.messages)) {
                    syncMessages(data.messages);
                    // 初始化最新消息时间戳（用于 HTTP 轮询兜底增量同步）
                    for (const m of data.messages) {
                        if (m.timestamp && m.timestamp > lastReceivedMsgTimestamp) {
                            lastReceivedMsgTimestamp = m.timestamp;
                        }
                    }
                }
            } catch(e) { console.error('加载服务端消息失败', e); }
            finally {
                // 加载完成（无论成败）隐藏骨架屏
                if (!isFirstLoadDone) {
                    isFirstLoadDone = true;
                    hideChatSkeleton();
                }
            }
        }

        // ===== 增量同步消息（不清空列表，只追加新消息，更新已有消息状态）=====
        function syncMessages(messages) {
            let newCount = 0;
            const wasLoadingFromCache = isLoadingFromCache;
            isLoadingFromCache = true;  // 渲染时避免逐条写盘
            messages.forEach(msg => {
                const existing = messagesMap[msg.id];
                if (!existing) {
                    // 新消息，追加
                    appendMessage(msg);
                    saveLocalMessage(msg);
                    newCount++;
                } else {
                    // 已存在，同步撤回状态（整条替换为居中灰色提示）
                    if (msg.recalled && !existing.recalled) {
                        existing.recalled = msg.recalled;
                        updateMessageRecalled(msg.id);
                    }
                }
            });
            isLoadingFromCache = wasLoadingFromCache;
            if (newCount > 0) rebuildTimeDividers();
        }

        // ===== 添加消息到列表 =====
        function appendMessage(msg) {
            const list = document.getElementById('chatList');
            // target 过滤：只显示发给群聊的消息（私聊消息 target='private' 不在群聊显示）
            // 兼容老消息：没有 target 字段默认视为 group
            if (msg.target && msg.target !== 'group') {
                console.log('[群聊过滤] 跳过非群聊消息', msg.id, 'target=', msg.target);
                return;
            }
            // isSelf 判断：优先用 userId（持久不变，改名/刷新都能识别）
            // 其次用 socketId（实时消息），最后用 senderName（兼容旧数据）
            const isSelf = (msg.userId && msg.userId === myUserId)
                || (msg.socketId === mySocketId)
                || (msg.type === 'self')
                || (msg.senderName && myName && msg.senderName === myName && !msg.userId);

            // 存储消息
            messagesMap[msg.id] = msg;

            if (msg.type === 'system') {
                // 检测加入/离开系统消息，支持连续折叠
                const contentStr = String(msg.content || '');
                const joinMatch = contentStr.match(/^(.+) 加入了聊天$/);
                const leaveMatch = contentStr.match(/^(.+) 离开了聊天$/);
                const foldType = joinMatch ? 'join' : (leaveMatch ? 'leave' : null);
                const foldName = joinMatch ? joinMatch[1] : (leaveMatch ? leaveMatch[1] : null);

                if (foldType) {
                    // 是加入/离开消息
                    if (lastSystemFold && lastSystemFold.type === foldType) {
                        // 与前一条同类型，合并
                        lastSystemFold.count++;
                        lastSystemFold.names.push(foldName);
                        updateFoldedSystemMsg(lastSystemFold);
                    } else {
                        // 创建新的折叠组
                        const div = document.createElement('div');
                        div.className = 'system-msg';
                        list.appendChild(div);
                        lastSystemFold = {
                            type: foldType,
                            count: 1,
                            names: [foldName],
                            element: div
                        };
                        updateFoldedSystemMsg(lastSystemFold);
                    }
                    list.scrollTop = list.scrollHeight;
                    return;
                }

                // 非加入/离开系统消息，重置折叠状态
                lastSystemFold = null;
                const div = document.createElement('div');
                div.className = 'system-msg';
                div.innerHTML = `<span>${msg.content}</span>`;
                list.appendChild(div);
            } else {
                // 普通消息重置折叠状态
                lastSystemFold = null;

                // 时间分隔线：5分钟无消息时插入（实时消息）
                const ts = msg.timestamp || Date.now();
                maybeInsertTimeDivider(ts);

                const div = document.createElement('div');
                div.className = 'msg-item' + (isSelf ? ' self' : '');
                div.dataset.msgId = msg.id;
                div.dataset.ts = String(ts);
                const color = msg.color || (isSelf ? myColor : '#5765ec');
                const initial = (msg.name || '?')[0].toUpperCase();

                // 头像 HTML：优先用 msg.avatar，其次从 avatarByName 缓存查找，最后用首字母
                // 点击他人头像可搜索与该用户的聊天记录
                const avatarSrc = msg.avatar || (msg.senderName && avatarByName[msg.senderName]) || null;
                const avatarClick = !isSelf ? ` onclick="openChatSearch('${escapeHtml(msg.name || '')}')"` : '';
                let avatarHtml;
                if (avatarSrc) {
                    avatarHtml = `<div class="msg-avatar" style="background:${color};cursor:pointer;"${avatarClick}><img src="${avatarSrc}"></div>`;
                } else {
                    avatarHtml = `<div class="msg-avatar" style="background:${color};cursor:pointer;"${avatarClick}>${initial}</div>`;
                }

                // 撤回消息：居中浅灰色小方框提示（类似时间分隔线，无头像无气泡）
                if (msg.recalled) {
                    const recallText = isSelf ? '你撤回了一条消息' : '对方撤回了一条消息';
                    div.className = 'msg-item recall-item';
                    div.innerHTML = `<div class="recall-tip"><span>${recallText}</span></div>`;
                    list.appendChild(div);
                    if (msg.type !== 'system' && !isLoadingFromCache) saveLocalMessage(msg);
                    list.scrollTop = list.scrollHeight;
                    return;
                }

                let contentHtml = '';
                if (msg.banned || msg.hidden) {
                    // 被管理员禁用的消息：显示提示（banned 字段持久化在消息对象上，刷新后仍然有效）
                    contentHtml = '<span style="color:#c62828;font-style:italic;">消息不符合规定暂不展示</span>';
                    div.querySelector && div.classList.add('hidden');
                } else if (msg.type === 'call') {
                    // 通话记录消息：显示通话图标+对方名+通话类型+时长
                    const isVideo = msg.callType === 'video';
                    const iconClass = isVideo ? 'fa fa-video-camera' : 'fa fa-phone';
                    const bgClass = isVideo ? 'video' : 'voice';
                    const typeLabel = isVideo ? '视频通话' : '语音通话';
                    const peerName = escapeHtml(msg.peerName || '未知');
                    const duration = msg.callDuration ? formatCallDuration(msg.callDuration) : '';
                    contentHtml = `<div class="call-msg">
                        <div class="call-icon ${bgClass}"><i class="${iconClass}"></i></div>
                        <div class="call-text">
                            <div>${isSelf ? '与 ' + peerName + ' ' + typeLabel : peerName + ' ' + typeLabel}</div>
                            ${duration ? `<div class="call-duration">时长 ${duration}</div>` : ''}
                        </div>
                    </div>`;
                } else if (msg.type === 'image') {
                    contentHtml = `<img src="${msg.content}" onclick="previewImage('${msg.id}')" data-msg-id="${msg.id}">`;
                } else if (msg.type === 'voice') {
                    const duration = msg.duration || 0;
                    contentHtml = `<div class="voice-msg" onclick="playVoice('${msg.id}')">
                        <i class="fa fa-play-circle voice-icon"></i>
                        <span class="voice-duration">${duration}"</span>
                    </div>`;
                } else if (msg.type === 'video') {
                    // 视频消息：显示可播放的 video 标签
                    contentHtml = `<video src="${msg.content}" controls></video>`;
                } else {
                    const escaped = msg.content.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                    contentHtml = escaped.replace(/\n/g, '<br>');
                }

                // 引用消息：在气泡顶部显示引用预览
                let quoteHtml = '';
                if (msg.quote && msg.quote.content) {
                    const qName = escapeHtml(msg.quote.name || '匿名');
                    const qContent = escapeHtml(msg.quote.content);
                    quoteHtml = `<div class="msg-quote" onclick="scrollToMsg('${msg.quote.id}')">
                        <span class="quote-name">${qName}：</span>${qContent}
                    </div>`;
                }

                // 通话消息气泡使用灰色背景（微信风格），不显示箭头
                const isCallMsg = msg.type === 'call';
                const bubbleStyle = isCallMsg ? ' style="background:#fff;color:#888;min-width:180px;"' : '';
                const bubbleClass = isCallMsg ? 'msg-bubble call-bubble' : 'msg-bubble';
                div.innerHTML = `
                    ${avatarHtml}
                    <div class="msg-content-wrap">
                        ${!isSelf ? `<div class="msg-name">${msg.name || '匿名'}</div>` : ''}
                        <div class="${bubbleClass}"${bubbleStyle}>${quoteHtml}${contentHtml}</div>
                        <div class="msg-time">${formatTime(msg.timestamp)}</div>
                    </div>
                `;

                // 长按/右键隐藏消息
                const bubble = div.querySelector('.msg-bubble');
                bubble.addEventListener('contextmenu', (e) => {
                    e.preventDefault();
                    showContextMenu(e.clientX, e.clientY, msg.id);
                });
                let touchTimer = null;
                bubble.addEventListener('touchstart', (e) => {
                    touchTimer = setTimeout(() => {
                        if (touchTimer) {
                            const touch = e.touches[0];
                            showContextMenu(touch.clientX, touch.clientY, msg.id);
                            touchTimer = null;
                        }
                    }, 600);
                });
                bubble.addEventListener('touchend', () => { if (touchTimer) { clearTimeout(touchTimer); touchTimer = null; } });
                bubble.addEventListener('touchmove', () => { if (touchTimer) { clearTimeout(touchTimer); touchTimer = null; } });

                list.appendChild(div);
            }
            // 缓存到 localStorage（系统消息不缓存，加载缓存时不重复保存）
            if (msg.type !== 'system' && !isLoadingFromCache) {
                saveLocalMessage(msg);
            }
            list.scrollTop = list.scrollHeight;
        }

        // ===== 更新折叠的系统消息显示 =====
        // 根据当前 fold 状态渲染对应的展示文本
        function updateFoldedSystemMsg(fold) {
            if (!fold || !fold.element) return;
            const action = fold.type === 'join' ? '加入' : '离开';
            const fullAction = fold.type === 'join' ? '加入了聊天' : '离开了聊天';
            const el = fold.element;
            // 转义名字防止 XSS
            const escNames = fold.names.map(n => String(n).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'));

            if (fold.count >= 3) {
                // 三条及以上：折叠为 "xxx等N人加入/离开"
                el.classList.add('folded');
                el.classList.remove('expanded');
                const detailHtml = escNames.map(n => `<div>${n}</div>`).join('');
                el.innerHTML = `<span>${escNames[0]}等${fold.count}人${action}<span class="folded-hint">点击展开</span></span><div class="system-msg-detail">${detailHtml}</div>`;
                // 点击切换展开
                el.onclick = () => { el.classList.toggle('expanded'); };
            } else if (fold.count === 2) {
                // 两人：显示 "xxx、yyy 加入了聊天"
                el.classList.remove('folded', 'expanded');
                el.innerHTML = `<span>${escNames[0]}、${escNames[1]} ${fullAction}</span>`;
                el.onclick = null;
            } else {
                // 单人：正常显示
                el.classList.remove('folded', 'expanded');
                el.innerHTML = `<span>${escNames[0]} ${fullAction}</span>`;
                el.onclick = null;
            }
        }

        // ===== 图片预览 =====
        // 统一打开/关闭入口：打开时压入一条历史记录，手机侧滑返回/返回键只关闭预览
        // 而不是后退底层页面（微信行为）
        let imgPreviewStatePushed = false;
        function showImagePreview() {
            const mask = document.getElementById('imagePreview');
            if (!mask) return;
            mask.classList.add('show');
            if (!imgPreviewStatePushed) {
                try { history.pushState({ imgPreview: true }, ''); imgPreviewStatePushed = true; } catch (e) {}
            }
        }
        function previewImage(msgId) {
            const img = document.querySelector(`img[data-msg-id="${msgId}"]`);
            if (img) {
                document.getElementById('previewImg').src = img.src;
                showImagePreview();
            }
        }
        function closeImagePreview() {
            const mask = document.getElementById('imagePreview');
            if (mask) mask.classList.remove('show');
            resetPreviewTransform();
            // 弹出打开预览时压入的历史记录（popstate 里标志已置 false，不会重复处理）
            if (imgPreviewStatePushed) {
                imgPreviewStatePushed = false;
                popstateGuard = true;  // 让安卓返回键监听跳过本次（这是预览关闭，不是返回私聊）
                try { history.back(); } catch (e) {}
            }
        }
        // 侧滑返回/浏览器返回：先关闭预览，不触碰底层页面
        // popstateGuard：预览关闭（侧滑或点×）引起的历史返回，让后面的安卓返回键监听跳过本次，
        // 否则关闭预览的同时会把私聊/聊天页也一起关掉
        let popstateGuard = false;
        window.addEventListener('popstate', () => {
            if (imgPreviewStatePushed) {
                imgPreviewStatePushed = false;
                popstateGuard = true;
                const mask = document.getElementById('imagePreview');
                if (mask) mask.classList.remove('show');
                resetPreviewTransform();
            }
        });

        // ===== 软键盘弹出时整个聊天框上浮（微信风格，visualViewport 适配）=====
        // 键盘弹出时 visualViewport 高度变小，把可见聊天容器的 bottom 抬高键盘高度，
        // 让"聊天内容 + 整个输入栏"作为整体一起上浮，而不是只有输入框局部被顶起
        (function keyboardLift() {
            if (!window.visualViewport) return;
            let lastOverlap = -1;
            const applyKeyboardOffset = () => {
                const overlap = Math.max(0, Math.round(window.innerHeight - visualViewport.height - visualViewport.offsetTop));
                // 变化小于阈值不处理（避免地址栏收起等微小抖动）
                if (Math.abs(overlap - lastOverlap) < 20) return;
                lastOverlap = overlap;
                const targets = [];
                const pub = document.getElementById('publicChatWrap');
                if (pub && pub.style.display !== 'none') targets.push(pub);
                document.querySelectorAll('.private-chat-wrap.show').forEach(w => targets.push(w));
                targets.forEach(w => {
                    if (overlap > 60) {
                        w.style.bottom = overlap + 'px';
                        // 键盘弹出后保持滚动到底部，看到最新消息
                        const body = w.querySelector('.private-chat-body') || w.querySelector('.chat-list');
                        if (body) setTimeout(() => { body.scrollTop = body.scrollHeight; }, 50);
                    } else {
                        w.style.bottom = '';
                    }
                });
            };
            visualViewport.addEventListener('resize', applyKeyboardOffset);
            visualViewport.addEventListener('scroll', applyKeyboardOffset);
        })();

        // ===== 图片预览增强：缩放（滚轮/双指）+ 拖拽 + 下载 + 分享 =====
        const previewState = { scale: 1, x: 0, y: 0, minScale: 0.5, maxScale: 8 };
        function applyPreviewTransform() {
            const img = document.getElementById('previewImg');
            if (!img) return;
            img.style.transform = `translate(${previewState.x}px, ${previewState.y}px) scale(${previewState.scale})`;
            showZoomTip();
        }
        function resetPreviewTransform() {
            previewState.scale = 1; previewState.x = 0; previewState.y = 0;
            const img = document.getElementById('previewImg');
            if (img) {
                img.classList.remove('dragging');
                img.style.transform = '';
            }
            const tip = document.getElementById('imgZoomTip');
            if (tip) tip.classList.remove('show');
        }
        // 缩放倍数提示（1.5 秒后自动隐藏）
        let zoomTipTimer = null;
        function showZoomTip() {
            const tip = document.getElementById('imgZoomTip');
            if (!tip) return;
            tip.textContent = Math.round(previewState.scale * 100) + '%';
            tip.classList.add('show');
            if (zoomTipTimer) clearTimeout(zoomTipTimer);
            zoomTipTimer = setTimeout(() => tip.classList.remove('show'), 1500);
        }
        // 以屏幕坐标 (cx, cy) 为中心缩放
        // 布局：图片经 flex 居中，最终图片中心 = 视口中心 + translate
        // 保持 (cx,cy) 对应的图片点缩放后仍在 (cx,cy)：translate' = v - ratio*(v - translate)
        function zoomPreviewAt(cx, cy, newScale) {
            newScale = Math.max(previewState.minScale, Math.min(previewState.maxScale, newScale));
            if (newScale === previewState.scale) return;
            const ratio = newScale / previewState.scale;
            const vx = cx - window.innerWidth / 2;
            const vy = cy - window.innerHeight / 2;
            previewState.x = vx - ratio * (vx - previewState.x);
            previewState.y = vy - ratio * (vy - previewState.y);
            previewState.scale = newScale;
            applyPreviewTransform();
        }
        // 电脑端：滚轮缩放（以鼠标位置为中心）
        document.getElementById('imagePreview').addEventListener('wheel', (e) => {
            e.preventDefault();
            const factor = e.deltaY < 0 ? 1.15 : 1 / 1.15;
            zoomPreviewAt(e.clientX, e.clientY, previewState.scale * factor);
        }, { passive: false });
        // 双指缩放 + 单指拖拽（移动端）+ 快速横滑关闭（微信风格）
        (function() {
            const img = document.getElementById('previewImg');
            const mask = document.getElementById('imagePreview');
            if (!img || !mask) return;
            let pinchStartDist = 0, pinchStartScale = 1;
            let pinchCenter = { x: 0, y: 0 };
            let dragStart = null;
            let touchStartTime = 0;
            mask.addEventListener('touchstart', (e) => {
                if (!mask.classList.contains('show')) return;
                touchStartTime = Date.now();
                if (e.touches.length === 1) {
                    dragStart = { x: e.touches[0].clientX, y: e.touches[0].clientY, sx: previewState.x, sy: previewState.y };
                    img.classList.add('dragging');
                } else if (e.touches.length === 2) {
                    dragStart = null;
                    const dx = e.touches[0].clientX - e.touches[1].clientX;
                    const dy = e.touches[0].clientY - e.touches[1].clientY;
                    pinchStartDist = Math.sqrt(dx * dx + dy * dy);
                    pinchStartScale = previewState.scale;
                    pinchCenter = { x: (e.touches[0].clientX + e.touches[1].clientX) / 2, y: (e.touches[0].clientY + e.touches[1].clientY) / 2 };
                    img.classList.add('dragging');
                }
            }, { passive: true });
            mask.addEventListener('touchmove', (e) => {
                if (!mask.classList.contains('show')) return;
                if (e.touches.length === 2 && pinchStartDist > 0) {
                    e.preventDefault();
                    const dx = e.touches[0].clientX - e.touches[1].clientX;
                    const dy = e.touches[0].clientY - e.touches[1].clientY;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    const newScale = pinchStartScale * (dist / pinchStartDist);
                    zoomPreviewAt(pinchCenter.x, pinchCenter.y, newScale);
                } else if (e.touches.length === 1 && dragStart && previewState.scale > 1) {
                    // 放大后才允许拖拽平移；原始大小时横滑留给"滑动关闭"手势
                    e.preventDefault();
                    previewState.x = dragStart.sx + (e.touches[0].clientX - dragStart.x);
                    previewState.y = dragStart.sy + (e.touches[0].clientY - dragStart.y);
                    applyPreviewTransform();
                }
            }, { passive: false });
            mask.addEventListener('touchend', (e) => {
                img.classList.remove('dragging');
                // 快速横滑关闭（未缩放时，微信行为）
                if (dragStart && e.changedTouches && e.changedTouches[0] && previewState.scale <= 1.01) {
                    const dx = e.changedTouches[0].clientX - dragStart.x;
                    const dy = e.changedTouches[0].clientY - dragStart.y;
                    const dt = Date.now() - touchStartTime;
                    if (Math.abs(dx) > 70 && Math.abs(dx) > Math.abs(dy) * 1.5 && dt < 500) {
                        dragStart = null; pinchStartDist = 0;
                        closeImagePreview();
                        return;
                    }
                }
                if (e.touches.length === 0) { pinchStartDist = 0; dragStart = null; }
            });
        })();
        // 电脑端：鼠标拖拽平移
        (function() {
            const img = document.getElementById('previewImg');
            const mask = document.getElementById('imagePreview');
            if (!img || !mask) return;
            let isDown = false, startX = 0, startY = 0, sx = 0, sy = 0;
            img.addEventListener('mousedown', (e) => {
                e.preventDefault();
                isDown = true; startX = e.clientX; startY = e.clientY;
                sx = previewState.x; sy = previewState.y;
                img.classList.add('dragging');
            });
            document.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                previewState.x = sx + (e.clientX - startX);
                previewState.y = sy + (e.clientY - startY);
                applyPreviewTransform();
            });
            document.addEventListener('mouseup', () => { isDown = false; img.classList.remove('dragging'); });
        })();
        // 工具栏：重置缩放
        function resetPreviewImage(e) {
            if (e) e.stopPropagation();
            resetPreviewTransform();
        }
        // 工具栏：下载图片
        function downloadPreviewImage(e) {
            if (e) e.stopPropagation();
            const img = document.getElementById('previewImg');
            if (!img || !img.src) return;
            const a = document.createElement('a');
            a.href = img.src;
            a.download = 'image_' + Date.now() + '.png';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            showToast('已开始下载', 'success');
        }
        // 工具栏：分享图片（优先系统分享，不支持时复制到剪贴板，最后兜底下载）
        async function sharePreviewImage(e) {
            if (e) e.stopPropagation();
            const img = document.getElementById('previewImg');
            if (!img || !img.src) return;
            try {
                // 将 dataURL / URL 转为 Blob
                const blob = await (await fetch(img.src)).blob();
                const file = new File([blob], 'image.png', { type: blob.type || 'image/png' });
                if (navigator.canShare && navigator.canShare({ files: [file] })) {
                    await navigator.share({ files: [file], title: '分享图片' });
                } else if (navigator.clipboard && window.ClipboardItem) {
                    // 剪贴板 API 只支持 PNG：其他格式（JPEG 等）先经 canvas 统一转 PNG
                    const pngBlob = await imgToPngBlob(img);
                    await navigator.clipboard.write([new ClipboardItem({ 'image/png': pngBlob })]);
                    showToast('图片已复制到剪贴板', 'success');
                } else {
                    showToast('当前浏览器不支持分享，已为您下载图片', 'info');
                    downloadPreviewImage();
                }
            } catch (err) {
                if (err && err.name === 'AbortError') return;  // 用户取消分享
                // 剪贴板写入失败（权限/格式问题）时兜底下载
                showToast('分享失败，已改为下载图片', 'info');
                downloadPreviewImage();
            }
        }
        // 图片元素转 PNG Blob（剪贴板只接受 image/png，JPEG 等格式需先转换）
        async function imgToPngBlob(imgEl) {
            const canvas = document.createElement('canvas');
            canvas.width = imgEl.naturalWidth || imgEl.width;
            canvas.height = imgEl.naturalHeight || imgEl.height;
            const ctx = canvas.getContext('2d');
            // 白底填充：PNG 的透明区域复制后保持透明，但 JPEG 来源无透明概念，统一处理
            ctx.fillStyle = '#fff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(imgEl, 0, 0);
            return await new Promise((resolve, reject) => {
                canvas.toBlob(b => b ? resolve(b) : reject(new Error('PNG 转换失败')), 'image/png');
            });
        }

        // ===== 长按/右键菜单 =====
        function showContextMenu(x, y, msgId) {
            const menu = document.getElementById('contextMenu');
            currentContextMenuMsgId = msgId;
            // 判断是否是自己发送的消息：是则显示"撤回"菜单项（优先用 userId）
            const msg = messagesMap[msgId];
            const isOwnMessage = msg && ((msg.userId && msg.userId === myUserId) || msg.socketId === mySocketId || (msg.senderName && myName && msg.senderName === myName && !msg.userId));
            const recallItem = document.getElementById('recallMenuItem');
            if (recallItem) recallItem.style.display = isOwnMessage ? 'block' : 'none';
            // 语音消息显示"转文字"按钮
            const transcribeItem = document.getElementById('transcribeMenuItem');
            if (transcribeItem) transcribeItem.style.display = (msg && msg.type === 'voice') ? 'block' : 'none';
            // 非自己发送的消息显示"举报"按钮
            const reportItem = document.getElementById('reportMenuItem');
            if (reportItem) reportItem.style.display = isOwnMessage ? 'none' : 'block';
            menu.style.left = Math.min(x, window.innerWidth - 160) + 'px';
            menu.style.top = Math.min(y, window.innerHeight - 80) + 'px';
            menu.classList.add('show');
        }
        function hideContextMenu() {
            document.getElementById('contextMenu').classList.remove('show');
            currentContextMenuMsgId = null;
        }
        // 点击其他地方关闭菜单
        document.addEventListener('click', () => hideContextMenu());

        // ===== 复制消息 =====
        function copyMessage() {
            if (!currentContextMenuMsgId) return;
            const msgId = currentContextMenuMsgId;
            const msg = messagesMap[msgId];
            hideContextMenu();
            if (!msg) return;
            // 获取纯文本内容用于复制
            let text = '';
            if (msg.type === 'voice') text = '[语音]';
            else if (msg.type === 'image') text = '[图片]';
            else if (msg.type === 'video') text = '[视频]';
            else if (msg.type === 'call') text = msg.content || '';
            else text = msg.content || '';
            const copyText = () => {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed'; ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); showToast('已复制'); }
                catch(e) { showToast('复制失败', 'error'); }
                document.body.removeChild(ta);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(() => showToast('已复制'))
                    .catch(() => copyText());
            } else { copyText(); }
        }

        // ===== 引用消息 =====
        function quoteMessage() {
            if (!currentContextMenuMsgId) return;
            const msgId = currentContextMenuMsgId;
            const msg = messagesMap[msgId];
            hideContextMenu();
            if (!msg) return;
            quotingMsg = { id: msg.id, name: msg.senderName || msg.name || '匿名', content: getMsgPreview(msg) };
            showQuotePreview();
            // 聚焦输入框
            const input = document.getElementById('msgInput');
            setTimeout(() => input.focus(), 100);
        }

        // 获取消息预览文本
        function getMsgPreview(msg) {
            if (!msg) return '';
            if (msg.recalled) return '[已撤回]';
            if (msg.type === 'voice') return '[语音]';
            if (msg.type === 'image') return '[图片]';
            if (msg.type === 'video') return '[视频]';
            if (msg.type === 'call') return msg.content || '';
            return String(msg.content || '').replace(/\n/g, ' ');
        }

        // 显示引用预览条
        function showQuotePreview() {
            if (!quotingMsg) {
                document.getElementById('quotePreview').style.display = 'none';
                return;
            }
            const el = document.getElementById('quotePreview');
            document.getElementById('quotePreviewContent').innerHTML =
                `<span style="color:#5765ec;">${escapeHtml(quotingMsg.name)}：</span>${escapeHtml(quotingMsg.content)}`;
            el.style.display = 'flex';
        }

        // 取消引用
        function cancelQuote() {
            quotingMsg = null;
            document.getElementById('quotePreview').style.display = 'none';
        }

        // 滚动到指定消息（点击引用时）
        function scrollToMsg(msgId) {
            const el = document.querySelector(`[data-msg-id="${msgId}"]`);
            if (!el) { showToast('原消息不在当前视图'); return; }
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            // 高亮闪烁
            const bubble = el.querySelector('.msg-bubble');
            if (bubble) {
                const orig = bubble.style.background;
                bubble.style.transition = 'background 0.3s';
                bubble.style.background = '#fff3a8';
                setTimeout(() => { bubble.style.background = orig; }, 1200);
            }
        }

        function updateMessageHidden(msgId, hidden) {
            const div = document.querySelector(`[data-msg-id="${msgId}"]`);
            if (!div) return;
            const bubble = div.querySelector('.msg-bubble');
            if (!bubble) return;
            // 同步 messagesMap 和 localStorage（banned 字段持久化）
            if (messagesMap[msgId]) {
                messagesMap[msgId].banned = hidden;
                messagesMap[msgId].hidden = hidden;
                updateLocalMessageField(msgId, 'banned', hidden);
                updateLocalMessageField(msgId, 'hidden', hidden);
            }
            if (hidden) {
                bubble.innerHTML = '<span style="color:#c62828;font-style:italic;">消息不符合规定暂不展示</span>';
                bubble.classList.add('hidden-msg');
            } else {
                const msg = messagesMap[msgId];
                if (msg) {
                    if (msg.type === 'image') {
                        bubble.innerHTML = `<img src="${msg.content}" onclick="previewImage('${msg.id}')" data-msg-id="${msg.id}">`;
                    } else if (msg.type === 'voice') {
                        const duration = msg.duration || 0;
                        bubble.innerHTML = `<div class="voice-msg" onclick="playVoice('${msg.id}')">
                            <i class="fa fa-play-circle voice-icon"></i>
                            <span class="voice-duration">${duration}"</span>
                        </div>`;
                    } else if (msg.type === 'video') {
                        // 视频消息恢复
                        bubble.innerHTML = `<video src="${msg.content}" controls playsinline webkit-playsinline></video>`;
                    } else {
                        const escaped = msg.content.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                        bubble.innerHTML = escaped.replace(/\n/g, '<br>');
                    }
                    bubble.classList.remove('hidden-msg');
                }
            }
        }

        // ===== 撤回消息 =====
        function recallMessage() {
            if (!currentContextMenuMsgId) return;
            const msgId = currentContextMenuMsgId;
            // 本地先检查时间窗口（2分钟）
            const msg = messagesMap[msgId];
            if (msg && msg.timestamp) {
                const elapsed = Date.now() - msg.timestamp;
                if (elapsed >= 2 * 60 * 1000) {
                    const mins = Math.floor(elapsed / 60000);
                    const secs = Math.floor((elapsed % 60000) / 1000);
                    showToast(`消息已发出 ${mins}分${secs}秒，超过 2 分钟无法撤回`, 'error');
                    hideContextMenu();
                    return;
                }
            }
            socket.emit('recall-message', { msgId });
            hideContextMenu();
        }

        function updateMessageRecalled(msgId) {
            const div = document.querySelector(`[data-msg-id="${msgId}"]`);
            if (!div) return;
            const msg = messagesMap[msgId];
            const isSelf = msg && ((msg.userId && msg.userId === myUserId) || msg.socketId === mySocketId || (msg.senderName && myName && msg.senderName === myName && !msg.userId));
            const recallText = isSelf ? '你撤回了一条消息' : '对方撤回了一条消息';
            // 整条消息替换为居中浅灰色提示（保留 data-ts 供时间分隔线重建）
            const tip = document.createElement('div');
            tip.className = 'msg-item recall-item';
            tip.dataset.msgId = msgId;
            tip.dataset.ts = div.dataset.ts || '';
            tip.innerHTML = `<div class="recall-tip"><span>${recallText}</span></div>`;
            div.replaceWith(tip);
        }

        // ===== 私聊长按/右键菜单 =====
        let currentPrivateMenuMsgId = null;
        let currentPrivateMenuPeer = null;
        let quotingPrivateMsg = null;  // 当前引用的私聊消息

        function showPrivateContextMenu(x, y, msgId, peerName) {
            const menu = document.getElementById('privateContextMenu');
            currentPrivateMenuMsgId = msgId;
            currentPrivateMenuPeer = peerName;
            // 判断是否是自己发送的消息
            const msgs = privateMsgsCache[peerName] || [];
            const msg = msgs.find(m => m.id === msgId);
            const isOwnMessage = msg && msg.sender === myName;
            const recallItem = document.getElementById('privateRecallMenuItem');
            if (recallItem) recallItem.style.display = isOwnMessage ? 'block' : 'none';
            // 非自己发送的消息显示"举报"按钮
            const reportItem = document.getElementById('privateReportMenuItem');
            if (reportItem) reportItem.style.display = isOwnMessage ? 'none' : 'block';
            menu.style.left = Math.min(x, window.innerWidth - 160) + 'px';
            menu.style.top = Math.min(y, window.innerHeight - 80) + 'px';
            menu.classList.add('show');
        }
        function hidePrivateContextMenu() {
            document.getElementById('privateContextMenu').classList.remove('show');
            currentPrivateMenuMsgId = null;
        }
        // 点击其他地方关闭菜单（同时关闭私聊菜单）
        document.addEventListener('click', () => hidePrivateContextMenu());

        // ===== 消息举报（群聊 + 私聊通用弹窗）=====
        let currentReportTarget = null;  // { scene, reportedUser, msgType, msgPreview }
        const REPORT_REASONS = ['垃圾广告', '辱骂攻击', '色情低俗', '违法违规', '诈骗信息', '泄露隐私', '其他'];

        // 直接举报用户（不针对具体消息）：私聊三个点菜单 / 群聊头像入口
        function openReportUser(userName, scene) {
            if (!userName || userName === myName) { showToast('不能举报自己'); return; }
            currentReportTarget = { scene: scene === 'private' ? 'private' : 'group', reportedUser: userName, msgType: 'user', msgPreview: '' };
            showReportModal();
        }

        // 群聊消息举报入口（长按菜单）
        function reportMessage() {
            if (!currentContextMenuMsgId) return;
            const msgId = currentContextMenuMsgId;
            const msg = messagesMap[msgId];
            hideContextMenu();
            if (!msg) return;
            const reportedUser = msg.senderName || msg.name || '';
            if (!reportedUser || reportedUser === myName) { showToast('不能举报自己的消息'); return; }
            currentReportTarget = { scene: 'group', reportedUser, msgType: msg.type || 'text', msgPreview: getMsgPreview(msg) };
            showReportModal();
        }
        // 私聊消息举报入口（长按菜单）
        function privateReportMessage() {
            if (!currentPrivateMenuMsgId) return;
            const msgId = currentPrivateMenuMsgId;
            const peer = currentPrivateMenuPeer;
            hidePrivateContextMenu();
            const msgs = privateMsgsCache[peer] || [];
            const msg = msgs.find(m => m.id === msgId);
            if (!msg) return;
            if (!msg.sender || msg.sender === myName) { showToast('不能举报自己的消息'); return; }
            let preview = '';
            if (msg.type === 'voice') preview = '[语音]';
            else if (msg.type === 'image') preview = '[图片]';
            else if (msg.type === 'video') preview = '[视频]';
            else preview = String(msg.content || '').replace(/\n/g, ' ');
            currentReportTarget = { scene: 'private', reportedUser: msg.sender, msgType: msg.type || 'text', msgPreview: preview };
            showReportModal();
        }
        // 举报弹窗：选择理由并提交
        function showReportModal() {
            if (!currentReportTarget) return;
            const t = currentReportTarget;
            const reasonOptions = REPORT_REASONS.map(r =>
                `<option value="${r}">${r}</option>`).join('');
            const html = `
                <div class="modal-title">举报用户</div>
                <div class="modal-content">
                    <div style="font-size:14px;color:#666;margin-bottom:10px;">
                        举报对象：<b>${escapeHtml(t.reportedUser)}</b>（${t.msgType === 'user' ? '整体举报该用户' : (t.scene === 'private' ? '私聊消息' : '群聊消息')}）<br>
                        <span style="font-size:12px;color:#999;">${t.msgType === 'user' ? '管理员将对该用户的行为进行核查' : '消息内容：' + escapeHtml(t.msgPreview.slice(0, 40) || '[非文字消息]')}</span>
                    </div>
                    <label style="display:block;font-size:13px;color:#666;margin-bottom:4px;">举报理由 *</label>
                    <select id="reportReasonSelect" class="modal-input" style="width:100%;height:40px;border:1px solid #d9d9d9;border-radius:6px;padding:0 8px;font-size:14px;background:#fff;">
                        ${reasonOptions}
                    </select>
                    <label style="display:block;font-size:13px;color:#666;margin:10px 0 4px;">补充说明（可选，最多100字）</label>
                    <textarea id="reportExtraInput" rows="3" maxlength="100" placeholder="补充举报说明" style="width:100%;border:1px solid #d9d9d9;border-radius:6px;padding:8px;font-size:14px;resize:none;"></textarea>
                </div>
                <div class="modal-buttons">
                    <button class="modal-btn cancel" onclick="closeModal()">取消</button>
                    <button class="modal-btn" style="color:#e65100;" onclick="submitReport()">提交举报</button>
                </div>`;
            showModal(html);
        }
        // 提交举报到服务器
        async function submitReport() {
            if (!currentReportTarget) return;
            const reasonSel = document.getElementById('reportReasonSelect');
            const extra = document.getElementById('reportExtraInput');
            let reason = reasonSel ? reasonSel.value : '';
            const extraText = extra ? extra.value.trim() : '';
            if (extraText) reason = reason + '：' + extraText;
            try {
                const res = await fetch('/api/report', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        reporter: myName,
                        reportedUser: currentReportTarget.reportedUser,
                        scene: currentReportTarget.scene,
                        msgType: currentReportTarget.msgType,
                        msgPreview: currentReportTarget.msgPreview,
                        reason
                    })
                });
                const data = await res.json();
                if (data.success) { closeModal(); showToast('举报已提交，管理员会尽快处理', 'success'); }
                else showToast(data.error || '举报失败', 'error');
            } catch (e) { showToast('网络错误，举报失败', 'error'); }
            currentReportTarget = null;
        }

        // ===== 消息转发（群聊/私聊消息 → 聊天室或好友，支持多选）=====
        let currentForwardMsg = null;  // 待转发的消息对象 { type, content, duration }
        const FORWARDABLE_TYPES = ['text', 'image', 'voice', 'video'];

        // 群聊消息转发入口（长按/右键菜单）
        function forwardMessage() {
            if (!currentContextMenuMsgId) return;
            const msg = messagesMap[currentContextMenuMsgId];
            hideContextMenu();
            if (!msg) return;
            startForward(msg);
        }
        // 私聊消息转发入口（长按/右键菜单）
        function privateForwardMessage() {
            if (!currentPrivateMenuMsgId) return;
            const msgId = currentPrivateMenuMsgId;
            const peer = currentPrivateMenuPeer;
            hidePrivateContextMenu();
            const msg = (privateMsgsCache[peer] || []).find(m => m.id === msgId);
            if (!msg) return;
            startForward(msg);
        }
        // 校验类型并弹出转发选择框
        function startForward(msg) {
            if (msg.recalled || msg.adminHidden || msg.banned || msg.hidden) { showToast('消息已被撤回，无法转发'); return; }
            if (!FORWARDABLE_TYPES.includes(msg.type)) { showToast('该类型消息不支持转发'); return; }
            if (bannedFromChat) { showToast('你已被禁言，无法转发消息', 'error'); return; }
            currentForwardMsg = { type: msg.type, content: msg.content, duration: msg.duration || 0 };
            showForwardModal();
        }
        // 转发选择弹窗：聊天室（单选）+ 好友（多选）
        function showForwardModal() {
            if (!currentForwardMsg) return;
            const preview = getChatRecordPreview(currentForwardMsg);
            const friendsHtml = (myFriends && myFriends.length)
                ? myFriends.map(f => `
                    <div class="forward-friend-item" onclick="toggleForwardFriend(this)">
                        <input type="checkbox" value="${escapeHtml(f.name)}" onchange="this.parentElement.classList.toggle('checked', this.checked)" onclick="event.stopPropagation()">
                        <span class="forward-friend-name">${escapeHtml(f.name)}</span>
                    </div>`).join('')
                : '<div style="text-align:center;color:#999;padding:16px 0;">暂无好友，可先添加好友</div>';
            const html = `
                <div class="modal-title"><i class="fa fa-share" style="color:#07c160;"></i> 转发消息</div>
                <div class="modal-content">
                    <div style="font-size:13px;color:#999;margin-bottom:10px;background:#f7f7f7;border-radius:8px;padding:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escapeHtml(preview)}</div>
                    <div class="forward-friend-item" id="forwardChatRoomItem" style="font-weight:bold;" onclick="toggleForwardChatRoom()">
                        <input type="checkbox" id="forwardToChatRoom" onchange="this.parentElement.classList.toggle('checked', this.checked)" onclick="event.stopPropagation()">
                        <i class="fa fa-users" style="color:#5765ec;margin-right:8px;"></i><span>聊天室（发送到公用聊天室）</span>
                    </div>
                    <div style="font-size:12px;color:#999;margin:8px 0 4px;">选择好友（可多选）：</div>
                    <div id="forwardFriendsList" style="max-height:200px;overflow-y:auto;border:1px solid #eee;border-radius:8px;padding:4px;">${friendsHtml}</div>
                </div>
                <div class="modal-buttons">
                    <button class="modal-btn cancel" onclick="closeModal()">取消</button>
                    <button class="modal-btn" style="color:#07c160;" onclick="confirmForward()">转发</button>
                </div>`;
            showModal(html);
        }
        // 勾选/取消单个好友（行点击切换内部 checkbox）
        function toggleForwardFriend(rowEl) {
            const cb = rowEl.querySelector('input[type="checkbox"]');
            if (cb) { cb.checked = !cb.checked; rowEl.classList.toggle('checked', cb.checked); }
        }
        // 勾选/取消聊天室
        function toggleForwardChatRoom() {
            const cb = document.getElementById('forwardToChatRoom');
            if (cb) {
                cb.checked = !cb.checked;
                document.getElementById('forwardChatRoomItem').classList.toggle('checked', cb.checked);
            }
        }
        // 执行转发：发到聊天室 + 逐个发给选中的好友
        async function confirmForward() {
            if (!currentForwardMsg) return;
            if (bannedFromChat) { showToast('你已被禁言，无法转发消息', 'error'); return; }
            const toChatRoom = document.getElementById('forwardToChatRoom')?.checked;
            const friendChecks = Array.from(document.querySelectorAll('#forwardFriendsList input[type="checkbox"]:checked'));
            const friendNames = friendChecks.map(cb => cb.value);
            if (!toChatRoom && !friendNames.length) { showToast('请选择转发目标'); return; }

            const { type, content, duration } = currentForwardMsg;
            let okCount = 0, failCount = 0;
            // 1) 转发到聊天室
            if (toChatRoom) {
                if (socket.connected) {
                    socket.emit('chat-send-message', { type, content, duration });
                    okCount++;
                } else {
                    try {
                        const res = await fetch('/api/chat/send', {
                            method: 'POST', headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ userName: myName, userId: myUserId, type, content, duration })
                        });
                        const data = await res.json();
                        if (data.success) { appendMessage(data.msg); okCount++; } else failCount++;
                    } catch (e) { failCount++; }
                }
            }
            // 2) 转发给好友（逐个发送私聊消息）
            for (const peer of friendNames) {
                const msgId = crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2);
                const ts = Date.now();
                try {
                    const res = await fetch('/api/friends/message', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ from: myName, to: peer, type, content, id: msgId, timestamp: ts, duration })
                    });
                    if (res.ok) {
                        // 写入本地缓存（当前正打开该私聊则立即重渲染）
                        if (!privateMsgsCache[peer]) privateMsgsCache[peer] = [];
                        privateMsgsCache[peer].push({ id: msgId, type, sender: myName, content, duration: duration || 0, timestamp: ts });
                        savePrivateMsgsCache();
                        if (currentPrivatePeer === peer) renderPrivateMessages(peer);
                        okCount++;
                    } else failCount++;
                } catch (e) { failCount++; }
            }
            closeModal();
            currentForwardMsg = null;
            if (failCount === 0) showToast(`已转发到 ${okCount} 个目标`, 'success');
            else showToast(`转发完成：成功 ${okCount} 个，失败 ${failCount} 个`, 'error');
        }

        // 私聊复制消息
        function privateCopyMessage() {
            if (!currentPrivateMenuMsgId) return;
            const msgId = currentPrivateMenuMsgId;
            const peer = currentPrivateMenuPeer;
            hidePrivateContextMenu();
            const msgs = privateMsgsCache[peer] || [];
            const msg = msgs.find(m => m.id === msgId);
            if (!msg) return;
            let text = '';
            if (msg.type === 'voice') text = '[语音]';
            else if (msg.type === 'image') text = '[图片]';
            else if (msg.type === 'video') text = '[视频]';
            else if (msg.type === 'call') text = msg.callType === 'video' ? '[视频通话]' : '[语音通话]';
            else if (msg.type === 'bg-invite') text = '[聊天背景邀请]';
            else text = msg.content || '';
            const copyText = () => {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed'; ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); showToast('已复制'); }
                catch(e) { showToast('复制失败', 'error'); }
                document.body.removeChild(ta);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(() => showToast('已复制'))
                    .catch(() => copyText());
            } else { copyText(); }
        }

        // 私聊引用消息
        function privateQuoteMessage() {
            if (!currentPrivateMenuMsgId) return;
            const msgId = currentPrivateMenuMsgId;
            const peer = currentPrivateMenuPeer;
            hidePrivateContextMenu();
            const msgs = privateMsgsCache[peer] || [];
            const msg = msgs.find(m => m.id === msgId);
            if (!msg) return;
            quotingPrivateMsg = { id: msg.id, name: msg.sender || '匿名', content: getPrivateMsgPreview(msg) };
            showPrivateQuotePreview();
            const input = document.getElementById('privateMsgInput');
            if (input) setTimeout(() => input.focus(), 100);
        }

        // 显示私聊引用预览条
        function showPrivateQuotePreview() {
            const el = document.getElementById('privateQuotePreview');
            if (!el) return;
            if (!quotingPrivateMsg) { el.style.display = 'none'; return; }
            const content = document.getElementById('privateQuotePreviewContent');
            if (content) {
                content.innerHTML =
                    `<span style="color:#5765ec;">${escapeHtml(quotingPrivateMsg.name)}：</span>${escapeHtml(quotingPrivateMsg.content)}`;
            }
            el.style.display = 'flex';
        }

        // 取消私聊引用
        function cancelPrivateQuote() {
            quotingPrivateMsg = null;
            const el = document.getElementById('privateQuotePreview');
            if (el) el.style.display = 'none';
        }

        // 滚动到私聊指定消息（点击引用时）
        function scrollToPrivateMsg(msgId, peerName) {
            const body = document.getElementById('privateChatBody');
            if (!body) return;
            const el = body.querySelector(`[data-msg-id="${msgId}"]`);
            if (!el) { showToast('原消息不在当前视图'); return; }
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.style.transition = 'background 0.3s';
            el.style.background = 'rgba(87,101,236,0.15)';
            setTimeout(() => { el.style.background = ''; }, 1500);
        }

        // 私聊撤回消息
        function privateRecallMessage() {
            if (!currentPrivateMenuMsgId) return;
            const msgId = currentPrivateMenuMsgId;
            const peer = currentPrivateMenuPeer;
            const msgs = privateMsgsCache[peer] || [];
            const msg = msgs.find(m => m.id === msgId);
            if (msg && msg.timestamp) {
                const elapsed = Date.now() - msg.timestamp;
                if (elapsed >= 2 * 60 * 1000) {
                    const mins = Math.floor(elapsed / 60000);
                    const secs = Math.floor((elapsed % 60000) / 1000);
                    showToast(`消息已发出 ${mins}分${secs}秒，超过 2 分钟无法撤回`, 'error');
                    hidePrivateContextMenu();
                    return;
                }
            }
            socket.emit('recall-private-message', { msgId, peer });
            hidePrivateContextMenu();
        }

        // 更新私聊消息撤回状态（本地 + UI）
        function updatePrivateMessageRecalled(msgId, peer) {
            const msgs = privateMsgsCache[peer];
            if (!msgs) return;
            const msg = msgs.find(m => m.id === msgId);
            if (!msg) return;
            msg.recalled = true;
            savePrivateMsgsCache();
            if (currentPrivatePeer === peer) renderPrivateMessages(peer);
        }

        function toggleVoiceMode() {
            if (bannedFromChat) { showToast('你已被禁言，无法发送语音消息', 'error'); return; }
            voiceMode = !voiceMode;
            const textInput = document.getElementById('msgInput');
            const recordBtn = document.getElementById('voiceRecordBtn');
            const voiceIcon = document.getElementById('voiceBtn');
            if (voiceMode) {
                textInput.style.display = 'none';
                recordBtn.style.display = 'block';
                voiceIcon.className = 'fa fa-keyboard input-voice-btn';
            } else {
                textInput.style.display = 'block';
                recordBtn.style.display = 'none';
                voiceIcon.className = 'fa fa-microphone input-voice-btn';
            }
        }

        // ===== 录音可视化（微信/QQ 风格：真实声波检测，Web Audio AnalyserNode）=====
        // 群聊与私聊录音共用一个浮层：波形为麦克风实时音量的滚动柱状图（非贴图）
        const voiceRec = { ctx: null, analyser: null, raf: null, bars: [], startAt: 0, discard: false, active: false, startY: 0 };
        const VOICE_REC_BAR_COUNT = 40;

        function formatVoiceRecTime(ms) {
            const s = Math.floor(ms / 1000);
            return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
        }

        // 启动可视化：接入麦克风流，实时计算音量（RMS）并绘制滚动声波
        function startVoiceVisualizer(stream, startEvent) {
            const overlay = document.getElementById('voiceRecOverlay');
            const canvas = document.getElementById('voiceRecCanvas');
            if (!overlay || !canvas) return;
            try {
                voiceRec.ctx = new (window.AudioContext || window.webkitAudioContext)();
                const source = voiceRec.ctx.createMediaStreamSource(stream);
                const analyser = voiceRec.ctx.createAnalyser();
                analyser.fftSize = 1024;
                source.connect(analyser);  // 只分析不回放，避免啸叫
                voiceRec.analyser = analyser;
            } catch (e) {
                console.warn('[录音可视化] Web Audio 不可用', e);
                voiceRec.analyser = null;
            }
            voiceRec.bars = [];
            voiceRec.startAt = Date.now();
            voiceRec.discard = false;
            voiceRec.active = true;
            voiceRec.startY = (startEvent && startEvent.touches && startEvent.touches[0]) ? startEvent.touches[0].clientY
                : (startEvent ? startEvent.clientY : 0);
            overlay.classList.add('show');
            // 强制重置取消态（不能用 setVoiceRecCancel：discard 已重置为 false，其守卫会提前返回导致红色残留）
            const card = document.getElementById('voiceRecCard');
            if (card) card.classList.remove('cancel');
            const hintEl = document.getElementById('voiceRecHint');
            if (hintEl) hintEl.textContent = '松开发送 · 上滑取消';
            const buf = new Uint8Array(1024);
            const draw = () => {
                if (!voiceRec.active) return;
                // 真实音量：时域信号 RMS（有效值）
                let vol = 0;
                if (voiceRec.analyser) {
                    voiceRec.analyser.getByteTimeDomainData(buf);
                    let sum = 0;
                    for (let i = 0; i < buf.length; i++) { const v = (buf[i] - 128) / 128; sum += v * v; }
                    vol = Math.sqrt(sum / buf.length);
                }
                voiceRec.bars.push(vol);
                if (voiceRec.bars.length > VOICE_REC_BAR_COUNT) voiceRec.bars.shift();
                drawVoiceWave(canvas);
                const timeEl = document.getElementById('voiceRecTime');
                if (timeEl) timeEl.textContent = formatVoiceRecTime(Date.now() - voiceRec.startAt);
                voiceRec.raf = requestAnimationFrame(draw);
            };
            draw();
        }

        // 绘制滚动柱状声波（居中对称，取消时变红）
        function drawVoiceWave(canvas) {
            const c2d = canvas.getContext('2d');
            const w = canvas.width, h = canvas.height;
            c2d.clearRect(0, 0, w, h);
            const bw = w / VOICE_REC_BAR_COUNT;
            for (let i = 0; i < VOICE_REC_BAR_COUNT; i++) {
                const v = voiceRec.bars[i] || 0;
                // 音量映射柱高：静音时 3px 底线，正常说话约 30-60px
                const bh = Math.max(3, Math.min(1, v * 4) * (h * 0.92));
                c2d.fillStyle = voiceRec.discard ? '#fa5151' : '#07c160';
                c2d.fillRect(i * bw + bw * 0.28, (h - bh) / 2, bw * 0.44, bh);
            }
        }

        // 上滑取消状态切换（微信风格）
        function setVoiceRecCancel(cancel) {
            if (voiceRec.discard === cancel) return;
            voiceRec.discard = cancel;
            const card = document.getElementById('voiceRecCard');
            const hint = document.getElementById('voiceRecHint');
            if (card) card.classList.toggle('cancel', cancel);
            if (hint) hint.textContent = cancel ? '松开手指，取消发送' : '松开发送 · 上滑取消';
        }

        // 录音按钮上滑检测（touchmove 时调用）
        function onVoiceRecTouchMove(e) {
            if (!voiceRec.active || !e.touches || !e.touches[0]) return;
            const dy = voiceRec.startY - e.touches[0].clientY;
            setVoiceRecCancel(dy > 80);
        }

        // 停止可视化：返回 discard（上滑取消标记），关闭 AudioContext 与浮层
        function stopVoiceVisualizer() {
            const discard = voiceRec.discard;
            voiceRec.active = false;
            if (voiceRec.raf) cancelAnimationFrame(voiceRec.raf);
            voiceRec.raf = null;
            if (voiceRec.ctx) { try { voiceRec.ctx.close(); } catch (e) {} }
            voiceRec.ctx = null;
            voiceRec.analyser = null;
            const overlay = document.getElementById('voiceRecOverlay');
            if (overlay) overlay.classList.remove('show');
            return discard;
        }
        // 息屏/切后台/锁屏时自动取消录音：否则录音会一直进行且无处停止
        // 微信同款行为：锁屏即丢弃本条语音，提示用户重录
        function cancelActiveRecordingDueToHidden() {
            if (!voiceRec.active) return;
            setVoiceRecCancel(true);  // 标记为取消
            if (typeof isRecording !== 'undefined' && isRecording) stopRecording();
            else if (typeof privateIsRecording !== 'undefined' && privateIsRecording) stopPrivateRecording();
        }
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) cancelActiveRecordingDueToHidden();
        });
        window.addEventListener('pagehide', cancelActiveRecordingDueToHidden);

        // 待丢弃标记：stopRecording 时同步写入，onstop（异步）读取
        let pendingVoiceDiscard = false;

        async function startRecording(e) {
            e.preventDefault();
            if (bannedFromChat) { showToast('你已被禁言，无法发送语音消息', 'error'); return; }
            if (isRecording) return;
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                voiceChunks = [];
                mediaRecorder.ondataavailable = (e) => { if (e.data.size > 0) voiceChunks.push(e.data); };
                mediaRecorder.onstop = () => {
                    const blob = new Blob(voiceChunks, { type: 'audio/webm' });
                    const reader = new FileReader();
                    reader.onloadend = () => {
                        if (pendingVoiceDiscard) { showToast('已取消发送', 'info'); return; }
                        const duration = Math.ceil((Date.now() - recordStartTime) / 1000);
                        if (duration < 1) { showToast('录音太短', 'error'); return; }
                        socket.emit('chat-send-message', { type: 'voice', content: reader.result, duration });
                    };
                    reader.readAsDataURL(blob);
                    stream.getTracks().forEach(t => t.stop());
                };
                mediaRecorder.start();
                isRecording = true;
                recordStartTime = Date.now();
                startVoiceVisualizer(stream, e);
                const btn = document.getElementById('voiceRecordBtn');
                btn.classList.add('recording');
                btn.textContent = '松开发送';
            } catch (err) {
                showToast('无法访问麦克风', 'error');
                console.error(err);
            }
        }

        function stopRecording(e) {
            if (!isRecording) return;
            if (e && e.preventDefault) e.preventDefault();
            isRecording = false;
            // 先同步读取取消状态并关闭浮层，再停止录音（onstop 异步触发）
            pendingVoiceDiscard = stopVoiceVisualizer();
            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                mediaRecorder.stop();
            }
            const btn = document.getElementById('voiceRecordBtn');
            btn.classList.remove('recording');
            btn.textContent = '按住说话';
        }

        // ===== 语音播放状态管理（群聊与私聊共用，同一时间只播一个）=====
        let currentVoiceAudio = null;
        let currentVoiceMsgId = null;
        // 恢复指定消息的图标和样式为"未播放"
        function resetVoiceUi(msgId) {
            const groupDiv = document.querySelector(`[data-msg-id="${msgId}"] .voice-msg`);
            const privDiv = document.querySelector(`#privateChatBody .voice-msg[onclick*="${msgId}"]`);
            const div = groupDiv || privDiv;
            const icon = div && div.querySelector('.voice-icon');
            if (icon) icon.className = 'fa fa-play-circle voice-icon';
            if (div) div.classList.remove('playing');
        }
        // 停止当前播放并清理状态
        function stopCurrentVoice() {
            if (!currentVoiceAudio) return;
            currentVoiceAudio.pause();
            currentVoiceAudio.onended = null;
            currentVoiceAudio.onerror = null;
            if (currentVoiceMsgId) resetVoiceUi(currentVoiceMsgId);
            currentVoiceAudio = null;
            currentVoiceMsgId = null;
        }

        // ===== 播放语音 =====
        function playVoice(msgId) {
            const msg = messagesMap[msgId];
            if (!msg) return;
            const div = document.querySelector(`[data-msg-id="${msgId}"] .voice-msg`);
            const icon = div && div.querySelector('.voice-icon');
            // 点击的是当前消息：切换播放/暂停
            if (currentVoiceMsgId === msgId && currentVoiceAudio) {
                if (currentVoiceAudio.paused) {
                    currentVoiceAudio.play();
                    if (icon) icon.className = 'fa fa-pause-circle voice-icon';
                    if (div) div.classList.add('playing');
                } else {
                    currentVoiceAudio.pause();
                    if (icon) icon.className = 'fa fa-play-circle voice-icon';
                    if (div) div.classList.remove('playing');
                }
                return;
            }
            // 切换到新消息，先停止旧的
            stopCurrentVoice();
            const audio = new Audio(msg.content);
            if (icon) icon.className = 'fa fa-pause-circle voice-icon';
            if (div) div.classList.add('playing');
            currentVoiceAudio = audio;
            currentVoiceMsgId = msgId;
            audio.play().catch(() => {
                resetVoiceUi(msgId);
                showToast('语音播放失败', 'error');
                currentVoiceAudio = null;
                currentVoiceMsgId = null;
            });
            audio.onended = () => {
                resetVoiceUi(msgId);
                currentVoiceAudio = null;
                currentVoiceMsgId = null;
            };
            audio.onerror = () => {
                resetVoiceUi(msgId);
                showToast('语音播放失败', 'error');
                currentVoiceAudio = null;
                currentVoiceMsgId = null;
            };
        }

        // ===== 语音转文字（使用 Web Speech API，需浏览器支持）=====
        function transcribeVoice() {
            if (!currentContextMenuMsgId) return;
            const msgId = currentContextMenuMsgId;
            const msg = messagesMap[msgId];
            hideContextMenu();
            if (!msg || msg.type !== 'voice') return;
            // 已有转文字结果则直接显示
            if (msg.transcript) {
                showToast('转文字：' + msg.transcript);
                return;
            }
            // 尝试用 Audio + SpeechRecognition 实时识别（播放语音同时识别）
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                // 浏览器不支持，调用服务端 API 转写（如配置）
                transcribeVoiceServer(msgId);
                return;
            }
            showToast('正在转文字...');
            const audio = new Audio(msg.content);
            // 创建一个 AudioContext 用于把 audio 流送到 SpeechRecognition（部分浏览器支持）
            const recognition = new SpeechRecognition();
            recognition.lang = 'zh-CN';
            recognition.continuous = true;
            recognition.interimResults = false;
            let finalText = '';
            recognition.onresult = (event) => {
                for (let i = event.resultIndex; i < event.results.length; i++) {
                    if (event.results[i].isFinal) {
                        finalText += event.results[i][0].transcript;
                    }
                }
            };
            recognition.onerror = (e) => {
                console.error('[语音转文字] 错误:', e.error);
                // Web Speech API 失败时降级到服务端转写
                if (e.error === 'not-allowed' || e.error === 'no-speech' || e.error === 'audio-capture') {
                    transcribeVoiceServer(msgId);
                } else {
                    showToast('语音转文字失败：' + e.error, 'error');
                }
            };
            recognition.onend = () => {
                if (finalText) {
                    msg.transcript = finalText;
                    updateLocalMessageField(msgId, 'transcript', finalText);
                    showToast('转文字结果：' + finalText);
                } else {
                    // 本地识别为空，尝试服务端转写
                    transcribeVoiceServer(msgId);
                }
            };
            // 播放语音同时启动识别
            try {
                recognition.start();
                audio.play();
                audio.onended = () => {
                    setTimeout(() => recognition.stop(), 500);
                };
                audio.onerror = () => {
                    recognition.stop();
                    // 播放失败也尝试服务端转写
                    transcribeVoiceServer(msgId);
                };
            } catch (e) {
                console.error('[语音转文字] 启动失败:', e);
                transcribeVoiceServer(msgId);
            }
        }

        // 服务端语音转写（POST base64 语音数据，服务端调用外部 API）
        function transcribeVoiceServer(msgId) {
            const msg = messagesMap[msgId];
            if (!msg || msg.type !== 'voice') return;
            showToast('正在调用服务端转写...');
            fetch('/api/chat/transcribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ audioData: msg.content })
            }).then(r => r.json()).then(data => {
                if (data.success && data.text) {
                    msg.transcript = data.text;
                    updateLocalMessageField(msgId, 'transcript', data.text);
                    showToast('转文字：' + data.text);
                } else {
                    showToast(data.error || '当前环境不支持语音转文字', 'error');
                }
            }).catch(() => showToast('服务端转写请求失败', 'error'));
        }

        // ===== 输入框 =====
        let isSendPending = false;  // HTTP 兜底发送进行中，保持发送按钮可见
        function onInputChanged() {
            const input = document.getElementById('msgInput');
            const sendBtn = document.getElementById('sendBtn');
            const plusBtn = document.getElementById('plusBtn');
            if (input.value.trim() || isSendPending) { sendBtn.style.display = 'block'; plusBtn.style.display = 'none'; }
            else { sendBtn.style.display = 'none'; plusBtn.style.display = 'block'; }
            // 自动调整高度（换行时输入框增高，最多 100px）
            input.style.height = 'auto';
            input.style.height = Math.min(input.scrollHeight, 100) + 'px';
        }
        function onKeypress(event) {
            // Enter 发送，Shift+Enter 换行
            if (event.key === 'Enter' && !event.shiftKey && !event.altKey && !event.ctrlKey) {
                event.preventDefault();
                sendTextMessage();
            }
        }

        // ===== 发送文本消息 =====
        function sendTextMessage() {
            if (bannedFromChat) { showToast('你已被禁言', 'error'); return; }
            if (isSendPending) return;  // HTTP 兜底发送中，防重复提交
            const input = document.getElementById('msgInput');
            const content = input.value.trim();
            if (!content) return;
            // 构造 payload，带引用信息
            const payload = { type: 'text', content };
            if (quotingMsg) {
                payload.quote = { id: quotingMsg.id, name: quotingMsg.name, content: quotingMsg.content };
                cancelQuote();
            }
            // Socket.IO 连接正常时用 socket 发送
            if (socket.connected) {
                socket.emit('chat-send-message', payload);
            } else {
                // Socket.IO 断连时，走 HTTP POST 兜底发送（外网 socket 不稳定但 HTTP 通畅）
                // 发送期间按钮进入 pending 状态，防止重复提交
                const btn = document.getElementById('sendBtn');
                isSendPending = true;
                btn.disabled = true;
                btn.textContent = '发送中';
                sendViaHttpFallback(payload).then(success => {
                    isSendPending = false;
                    btn.disabled = false;
                    btn.textContent = '发送';
                    onInputChanged();  // 交回输入状态控制按钮显隐
                    if (success) { showToast('已通过备用通道发送', 'success'); }
                });
            }
            input.value = '';
            onInputChanged();
        }

        // ===== HTTP 兜底发送消息（socket 断连时使用）=====
        async function sendViaHttpFallback(payload) {
            try {
                const res = await fetch('/api/chat/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(Object.assign({
                        userName: myName,
                        userId: myUserId
                    }, payload))
                });
                const data = await res.json();
                if (data.success) {
                    // 自己发送的消息直接显示（不依赖 socket 回推）
                    appendMessage(data.msg);
                    if (data.msg.timestamp > lastReceivedMsgTimestamp) {
                        lastReceivedMsgTimestamp = data.msg.timestamp;
                    }
                    saveLocalMessage(data.msg);
                    return true;
                } else {
                    showToast('发送失败：' + (data.error || '未知错误'), 'error');
                    return false;
                }
            } catch (e) {
                console.error('[HTTP兜底发送] 失败', e);
                showToast('发送失败，请检查网络', 'error');
                return false;
            }
        }

        // ===== 发送图片消息（Canvas 自动压缩，不限制用户上传大小）=====
        // 无论用户选多大图片，都通过 Canvas 压缩到最大 1280px 边、JPEG 0.8 质量（约 100-300KB）
        // 这样不占服务端资源，上传也快，外网 polling 也能稳定传输
        function sendImageMessage(input) {
            if (bannedFromChat) { showToast('你已被禁言', 'error'); input.value = ''; return; }
            const file = input.files[0];
            if (!file) return;
            // 不再限制大小，由 Canvas 压缩处理
            compressImage(file, 1280, 0.8).then(dataUrl => {
                if (!dataUrl) { showToast('图片处理失败', 'error'); input.value = ''; return; }
                // socket 断连时走 HTTP 兜底
                if (socket.connected) {
                    socket.emit('chat-send-message', { type: 'image', content: dataUrl });
                } else {
                    sendViaHttpFallback({ type: 'image', content: dataUrl });
                }
                input.value = '';
                closePlusPanel();
            }).catch(e => {
                console.error('图片压缩失败', e);
                showToast('图片处理失败', 'error');
                input.value = '';
            });
        }

        // Canvas 压缩图片：maxSize=最大边长，quality=JPEG 质量 0-1
        function compressImage(file, maxSize, quality) {
            return new Promise((resolve, reject) => {
                if (!file.type.startsWith('image/')) { reject(new Error('非图片文件')); return; }
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = new Image();
                    img.onload = function() {
                        let { width, height } = img;
                        // 按最大边长等比缩放
                        if (width > maxSize || height > maxSize) {
                            if (width > height) {
                                height = Math.round(height * maxSize / width);
                                width = maxSize;
                            } else {
                                width = Math.round(width * maxSize / height);
                                height = maxSize;
                            }
                        }
                        const canvas = document.createElement('canvas');
                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        // PNG/GIF 用白底（JPEG 不支持透明）
                        if (file.type !== 'image/png' && file.type !== 'image/gif') {
                            ctx.fillStyle = '#fff';
                            ctx.fillRect(0, 0, width, height);
                        }
                        ctx.drawImage(img, 0, 0, width, height);
                        // GIF 压缩为 GIF（保留动画第一帧），其他统一 JPEG
                        const mime = (file.type === 'image/png') ? 'image/png' : 'image/jpeg';
                        const dataUrl = canvas.toDataURL(mime, quality);
                        resolve(dataUrl);
                    };
                    img.onerror = () => reject(new Error('图片加载失败'));
                    img.src = e.target.result;
                };
                reader.onerror = () => reject(new Error('文件读取失败'));
                reader.readAsDataURL(file);
            });
        }

        // ===== 发送视频消息 =====
        // 通过 HTTP 上传文件到服务端，避免 Socket.IO 传输大 base64 和 Android WebView 的 data URL 渲染限制
        function sendVideoMessage(input) {
            if (bannedFromChat) { showToast('你已被禁言', 'error'); input.value = ''; return; }
            const file = input.files[0];
            if (!file) return;
            // 检查视频格式（仅支持 mp4/webm/3gp/quicktime）
            const supportedTypes = ['video/mp4', 'video/webm', 'video/3gpp', 'video/quicktime', 'video/x-matroska'];
            const ext = file.name.split('.').pop().toLowerCase();
            const supportedExts = ['mp4', 'webm', '3gp', 'mov', 'mkv'];
            if (!supportedTypes.includes(file.type) && !supportedExts.includes(ext)) {
                showToast('不支持的视频格式，请发送 MP4 或 WebM', 'error');
                input.value = '';
                return;
            }
            // 限制 30MB
            if (file.size > 30 * 1024 * 1024) {
                showToast('视频不能超过 30MB', 'error');
                input.value = '';
                return;
            }
            showToast('正在上传视频...');
            const reader = new FileReader();
            // 读取超时检测
            let readTimeout = setTimeout(() => {
                if (reader.readyState === FileReader.LOADING) {
                    reader.abort();
                    showToast('视频读取超时，请缩短视频时长', 'error');
                }
            }, 30000);
            reader.onload = function(e) {
                clearTimeout(readTimeout);
                // 通过 HTTP POST 上传视频文件（绕过 Socket.IO 大数据传输限制）
                fetch('/api/chat/upload-video', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ data: e.target.result, name: file.name })
                })
                .then(r => r.json())
                .then(result => {
                    if (result.error) {
                        showToast('视频上传失败：' + result.error, 'error');
                        return;
                    }
                    // 上传成功，通过 Socket.IO 发送消息（content 是 URL，不是 base64）
                    let ackReceived = false;
                    socket.emit('chat-send-message', { type: 'video', content: result.url }, (ack) => {
                        ackReceived = true;
                        if (ack && ack.error) {
                            showToast('视频发送失败：' + ack.error, 'error');
                        } else if (ack && ack.success) {
                            showToast('视频已发送');
                        } else {
                            showToast('视频发送失败：服务端无响应', 'error');
                        }
                    });
                    // 超时兜底
                    setTimeout(() => {
                        if (!ackReceived) {
                            showToast('视频发送超时，请重试', 'error');
                        }
                    }, 10000);
                })
                .catch(err => {
                    console.error('[视频上传] 网络错误:', err);
                    showToast('视频上传失败：网络错误', 'error');
                });
            };
            reader.onerror = function() {
                clearTimeout(readTimeout);
                showToast('视频读取失败', 'error');
            };
            reader.onabort = function() {
                clearTimeout(readTimeout);
            };
            reader.readAsDataURL(file);
            input.value = '';
            closePlusPanel();
        }

        // ===== 媒体多选预览（微信风格：选完先预览确认，可移除个别项，再批量发送）=====
        // 浏览器安全限制无法直接访问相册，多选由系统文件选择器完成（input multiple），
        // 此界面负责发送前的预览与确认，与微信"选择图片→预览→发送"流程一致
        let mediaPickerFiles = [];       // 待发送的 File 列表
        let mediaPickerScope = 'public'; // public 群聊 / private 私聊
        let mediaPickerUrls = [];        // 缩略图 objectURL（关闭时释放）

        function openMediaPicker(fileList, scope) {
            const files = Array.from(fileList || []).filter(f => f.type.startsWith('image/') || f.type.startsWith('video/'));
            if (!files.length) { showToast('请选择图片或视频文件', 'error'); return; }
            mediaPickerFiles = files;
            mediaPickerScope = scope;
            renderMediaPicker();
            document.getElementById('mediaPickerModal').classList.add('show');
        }

        function closeMediaPicker() {
            document.getElementById('mediaPickerModal').classList.remove('show');
            // 释放缩略图 objectURL
            mediaPickerUrls.forEach(u => { try { URL.revokeObjectURL(u); } catch (e) {} });
            mediaPickerUrls = [];
            mediaPickerFiles = [];
        }

        function renderMediaPicker() {
            const grid = document.getElementById('mediaPickerGrid');
            mediaPickerUrls.forEach(u => { try { URL.revokeObjectURL(u); } catch (e) {} });
            mediaPickerUrls = [];
            grid.innerHTML = mediaPickerFiles.map((f, i) => {
                let inner;
                if (f.type.startsWith('image/')) {
                    const url = URL.createObjectURL(f);
                    mediaPickerUrls.push(url);
                    inner = `<img src="${url}">`;
                } else if (f.type.startsWith('video/')) {
                    const url = URL.createObjectURL(f);
                    mediaPickerUrls.push(url);
                    inner = `<video src="${url}" muted preload="metadata"></video><span class="media-picker-badge">视频</span>`;
                } else {
                    inner = `<div class="media-picker-file"><i class="fa fa-file"></i><span>文件</span></div>`;
                }
                return `<div class="media-picker-item">
                    ${inner}
                    <div class="media-picker-remove" onclick="removeMediaPickerItem(${i})"><i class="fa fa-times"></i></div>
                </div>`;
            }).join('');
            document.getElementById('mediaPickerCount').textContent = `已选 ${mediaPickerFiles.length} 项`;
            const btn = document.getElementById('mediaPickerSendBtn');
            btn.textContent = mediaPickerFiles.length ? `发送(${mediaPickerFiles.length})` : '发送';
            btn.disabled = !mediaPickerFiles.length;
        }

        function removeMediaPickerItem(index) {
            mediaPickerFiles.splice(index, 1);
            renderMediaPicker();
        }

        async function confirmSendMedia() {
            if (!mediaPickerFiles.length) { closeMediaPicker(); return; }
            if (bannedFromChat) { showToast('你已被禁言', 'error'); return; }
            const files = mediaPickerFiles.slice();
            const scope = mediaPickerScope;
            // 先关弹窗释放 URL，再逐个发送
            mediaPickerFiles = [];
            closeMediaPicker();
            showToast(`正在发送 ${files.length} 个文件...`, 'info');
            let sent = 0;
            for (const f of files) {
                try {
                    await sendOneMediaFile(f, scope);
                    sent++;
                } catch (e) {
                    console.error('[媒体批量发送] 单个文件失败', f.name, e);
                    showToast(`「${f.name}」发送失败`, 'error');
                }
            }
            if (sent > 0 && sent < files.length) showToast(`已发送 ${sent}/${files.length} 个文件`, 'info');
        }

        // 发送单个媒体文件（图片压缩后发，视频走服务端上传）
        async function sendOneMediaFile(file, scope) {
            if (file.type.startsWith('image/')) {
                const dataUrl = await compressImage(file, 1280, 0.8);
                if (!dataUrl) throw new Error('图片处理失败');
                if (scope === 'private') {
                    await sendPrivateMessageOfType('image', dataUrl);
                } else if (socket.connected) {
                    socket.emit('chat-send-message', { type: 'image', content: dataUrl });
                } else {
                    await sendViaHttpFallback({ type: 'image', content: dataUrl });
                }
                return;
            }
            // 视频：校验格式与大小（与单发逻辑一致）
            const supportedTypes = ['video/mp4', 'video/webm', 'video/3gpp', 'video/quicktime', 'video/x-matroska'];
            const ext = (file.name || '').split('.').pop().toLowerCase();
            const supportedExts = ['mp4', 'webm', '3gp', 'mov', 'mkv'];
            if (!supportedTypes.includes(file.type) && !supportedExts.includes(ext)) {
                throw new Error('不支持的视频格式');
            }
            if (file.size > 30 * 1024 * 1024) {
                throw new Error('视频超过 30MB 限制');
            }
            const url = await uploadVideoFile(file);
            if (scope === 'private') {
                await sendPrivateMessageOfType('video', url);
            } else {
                // 群聊：socket 带确认回执发送
                await new Promise((resolve, reject) => {
                    let ackReceived = false;
                    socket.emit('chat-send-message', { type: 'video', content: url }, (ack) => {
                        ackReceived = true;
                        if (ack && (ack.error)) reject(new Error(ack.error));
                        else resolve();
                    });
                    setTimeout(() => { if (!ackReceived) reject(new Error('发送超时')); }, 15000);
                });
            }
        }

        // 视频上传：读取为 dataURL 后 POST 到服务端（群聊/私聊共用）
        function uploadVideoFile(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                const readTimeout = setTimeout(() => {
                    if (reader.readyState === FileReader.LOADING) reader.abort();
                }, 30000);
                reader.onload = function(e) {
                    clearTimeout(readTimeout);
                    fetch('/api/chat/upload-video', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ data: e.target.result, name: file.name })
                    }).then(r => r.json()).then(data => {
                        if (data.url) resolve(data.url);
                        else reject(new Error(data.error || '视频上传失败'));
                    }).catch(reject);
                };
                reader.onerror = () => { clearTimeout(readTimeout); reject(new Error('视频读取失败')); };
                reader.readAsDataURL(file);
            });
        }

