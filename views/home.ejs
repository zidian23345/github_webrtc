        }
        function formatRemainingText(ms) {
            if (ms < 3600000) return Math.ceil(ms / 60000) + ' 分钟';
            if (ms < 86400000) return Math.ceil(ms / 3600000) + ' 小时';
            return Math.ceil(ms / 86400000) + ' 天';
        }
        function formatNotifTime(ts) {
            if (!ts) return '';
            const d = new Date(ts);
