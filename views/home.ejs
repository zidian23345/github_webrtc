        // 渲染成员列表（在线 + 离线）
        function renderMembersList() {
            const list = document.getElementById('membersList');
            // 在线用户按 name 去重：同一用户多端/多标签在线或重连去抖期间新旧 socket 共存时，只显示一条
            const onlineSorted = Object.values(onlineUsers).sort((a, b) => (b.joinedAt || 0) - (a.joinedAt || 0));
            const onlineSeen = new Set();
            const onlineArr = [];
            for (const u of onlineSorted) {
                const key = u.name || u.socketId;
                if (onlineSeen.has(key)) continue;
                onlineSeen.add(key);
                onlineArr.push(u);
            }
            const onlineNames = new Set(onlineArr.map(u => u.name).filter(Boolean));
            // 离线用户去重：排除与在线用户同名的（避免刷新后出现重复）
            const offlineArr = Array.from(offlineUsers.values()).filter(u => {
                if (u.name && onlineNames.has(u.name)) return false;  // 在线已有同名，不显示离线条目
                return true;
            });
            // 离线用户自身也按 name 去重（保留最近离开的）
            const seenNames = new Set();
            const dedupedOffline = [];
            for (let i = offlineArr.length - 1; i >= 0; i--) {
                const u = offlineArr[i];
                const key = u.name || u.socketId;
                if (!seenNames.has(key)) {
                    seenNames.add(key);
                    dedupedOffline.unshift(u);
                }
            }
            const totalCount = onlineArr.length + dedupedOffline.length;
            document.getElementById('drawerSummary').textContent =
                `在线 ${onlineArr.length} 人 / 共 ${totalCount} 人`;
            list.innerHTML = '';

            // 自己排第一
            onlineArr.sort((a, b) => {
                if (a.socketId === mySocketId) return -1;
                if (b.socketId === mySocketId) return 1;
                return (a.name || '').localeCompare(b.name || '');
            });
            dedupedOffline.sort((a, b) => (a.name || '').localeCompare(b.name || ''));

            // 在线成员
            onlineArr.forEach(u => list.appendChild(buildMemberItem(u, true)));
            // 离线成员
            dedupedOffline.forEach(u => list.appendChild(buildMemberItem(u, false)));
        }

        // 构建单个成员项
        function buildMemberItem(u, isOnline) {
            const item = document.createElement('div');
            item.className = 'member-item';
            item.onclick = () => viewUserProfile(u.socketId);
            const color = u.color || '#5765ec';
            const initial = (u.name || '?')[0].toUpperCase();
            const avatarInner = u.avatar
                ? `<img src="${u.avatar}">`
                : `${initial}`;
            const selfClass = u.socketId === mySocketId ? ' self' : '';
            const meta = isOnline
                ? `加入于 ${formatTime(u.joinedAt || Date.now())}`
                : `离线`;
            item.innerHTML = `
                <div class="member-avatar" style="background:${color}">
                    ${avatarInner}
                    <div class="member-status-dot ${isOnline ? 'online' : ''}"></div>
                </div>
                <div class="member-info">
                    <div class="member-name${selfClass}">${escapeHtml(u.name || '匿名')}</div>
                    <div class="member-meta">${meta}</div>
                </div>
            `;
            return item;
        }

        // 简单的 HTML 转义
        function escapeHtml(s) {
            return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        // 按 userName 生成稳定的头像背景色（与 server.js colorPalette 一致）
        const USER_COLOR_PALETTE = ['#07c160', '#5765ec', '#fa5151', '#ff9c19', '#00ae9d', '#8b5cf6', '#ec4899', '#14b8a6', '#f97316', '#6366f1'];
        const _userColorCache = {};
        function getUserColorByName(name) {
            if (!name) return USER_COLOR_PALETTE[0];
            if (_userColorCache[name]) return _userColorCache[name];
            let hash = 0;
            for (let i = 0; i < name.length; i++) hash = (hash * 31 + name.charCodeAt(i)) | 0;
            const color = USER_COLOR_PALETTE[Math.abs(hash) % USER_COLOR_PALETTE.length];
            _userColorCache[name] = color;
            return color;
        }

        // ===== 用户主页 =====
        function viewUserProfile(socketId) {
            if (!socketId) return;
            socket.emit('get-profile', { socketId });
            showToast('正在加载用户主页...');
        }

        // 查看自己的主页
        function viewMyProfile() {
            if (mySocketId) viewUserProfile(mySocketId);
            else openNameModal();
        }

        function showProfileModal(data) {
            const content = document.getElementById('profileContent');
            const isSelf = data.socketId === mySocketId;
            const color = (onlineUsers[data.socketId] || {}).color || '#5765ec';
            const initial = (data.name || '?')[0].toUpperCase();
            const avatarInner = data.avatar
                ? `<img src="${data.avatar}">`
                : `${initial}`;
            const statusText = data.online ? '在线' : '离线';
            const statusClass = data.online ? '' : ' offline';
            const joinedAt = data.joinedAt ? formatTime(data.joinedAt) : '未知';
            const lastSeen = data.lastSeen ? formatTime(data.lastSeen) : '—';

            let actionsHtml = '';
            if (isSelf) {
                actionsHtml = `<div class="profile-actions">
                    <button class="profile-btn" onclick="document.getElementById('avatarInput').click()">修改头像</button>
                    <button class="profile-btn" onclick="closeProfileModal(); setTimeout(openNameModal, 200);">修改名称</button>
                </div>`;
            }

            content.innerHTML = `
                <div class="profile-avatar-large" style="background:${color}">
                    ${avatarInner}
                    <div class="member-status-dot ${data.online ? 'online' : ''}"></div>
                </div>
                <div class="profile-name">${escapeHtml(data.name || '匿名')}</div>
                <div class="profile-status${statusClass}">${statusText}</div>
                <div class="profile-row"><span>加入时间</span><span>${joinedAt}</span></div>
                <div class="profile-row"><span>最后在线</span><span>${lastSeen}</span></div>
                ${data.avatarBanned ? '<div class="profile-row"><span style="color:#fa5151;">头像功能</span><span style="color:#fa5151;">已被禁用</span></div>' : ''}
                ${actionsHtml}
            `;
            document.getElementById('profileModal').classList.add('show');
        }

        function closeProfileModal() {
            document.getElementById('profileModal').classList.remove('show');
        }

        // 选择头像文件后的回调
        function onAvatarSelected(input) {
            const file = input.files[0];
            if (!file) return;
            if (avatarBanned) { showToast('你已被禁用换头像功能', 'error'); input.value = ''; return; }
            if (file.size > 2 * 1024 * 1024) { showToast('头像不能超过 2MB', 'error'); input.value = ''; return; }
            const reader = new FileReader();
            reader.onload = function(e) {
                socket.emit('set-avatar', { avatar: e.target.result });
                showToast('头像已上传');
                // 本地立即更新
                myAvatar = e.target.result;
                updateNavAvatar();
                if (onlineUsers[mySocketId]) onlineUsers[mySocketId].avatar = myAvatar;
                // 刷新主页弹窗
                const profileBox = document.getElementById('profileModal');
                if (profileBox.classList.contains('show')) {
                    showProfileModal({
                        socketId: mySocketId, name: myName, avatar: myAvatar,
                        avatarBanned: avatarBanned, online: true,
                        joinedAt: (onlineUsers[mySocketId] || {}).joinedAt,
                        lastSeen: null
                    });
                }
            };
            reader.onerror = function() { showToast('头像读取失败', 'error'); };
            reader.readAsDataURL(file);
            input.value = '';
        }

        // 更新导航栏头像
        function updateNavAvatar() {
            const el = document.getElementById('navAvatar');
            if (!el) return;
            if (myAvatar) {
                el.innerHTML = `<img src="${myAvatar}">`;
            } else {
                const initial = (myName || '?')[0].toUpperCase();
                el.textContent = initial;
                el.style.background = myColor;
            }
        }

        // ===== 视频通话 =====
        // 生成 UUID（用于 callId）
        function generateCallId() {
            if (window.crypto && window.crypto.randomUUID) return window.crypto.randomUUID();
            return 'c-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10);
        }

        // 发起通话：弹出选择在线成员
        async function startCall(callType) {
            if (bannedFromMeeting) { showToast('你已被禁用会议功能', 'error'); return; }
            closePlusPanel();
            // 始终通过 HTTP 获取最新在线用户列表（socket 事件可能不完整，导致列表缺失成员）
            let onlineArr = [];
            try {
                const res = await fetch('/api/chat/online-users');
                if (res.ok) {
                    const data = await res.json();
                    const httpUsers = (data.users || []).filter(u => u.socketId !== mySocketId && u.name !== myName);
                    // 合并到本地 onlineUsers（补充 socket 事件丢失的成员）
                    httpUsers.forEach(u => {
                        onlineUsers[u.socketId] = u;
                        if (u.name && u.avatar) avatarByName[u.name] = u.avatar;
                    });
                    onlineArr = httpUsers;
                    console.log('[通话] HTTP 获取到 ' + httpUsers.length + ' 个在线用户');
                }
            } catch (e) {
                console.error('[通话] HTTP 获取在线用户失败', e);
                // 降级：使用本地 onlineUsers
                onlineArr = Object.values(onlineUsers).filter(u => u.socketId !== mySocketId);
            }
            // 按用户名去重：同一用户多端/多标签在线时，避免邀请通话列表重复显示相同头像；同时排除自己（另一端在线）
            const seenNames = new Set([myName]);
            onlineArr = onlineArr.filter(u => {
                const key = u.name || u.socketId;
                if (seenNames.has(key)) return false;
                seenNames.add(key);
                return true;
            });
            if (onlineArr.length === 0) {
                showToast('暂无其他在线成员可呼叫', 'error');
                return;
            }
            const titleMap = { video: '选择视频通话对象', voice: '选择语音通话对象' };
            document.getElementById('callTargetTitle').textContent = titleMap[callType] || '选择通话对象';
            const listEl = document.getElementById('callTargetList');
            listEl.innerHTML = '';
            onlineArr.forEach(u => {
                const item = document.createElement('div');
                item.className = 'call-target-item';
                item.onclick = () => {
                    closeCallTargetModal();
                    inviteCall(u, callType);
                };
                const color = u.color || '#5765ec';
                const initial = (u.name || '?')[0].toUpperCase();
                const avatarInner = u.avatar ? `<img src="${u.avatar}">` : initial;
                item.innerHTML = `
                    <div class="call-target-avatar" style="background:${color}">${avatarInner}</div>
                    <div class="call-target-name">${escapeHtml(u.name || '匿名')}</div>
                `;
                listEl.appendChild(item);
            });
            document.getElementById('callTargetModal').classList.add('show');
        }

        function closeCallTargetModal() {
            document.getElementById('callTargetModal').classList.remove('show');
        }

        // 向某成员发起通话邀请
        function inviteCall(targetUser, callType, isPrivateCall) {
            const callId = generateCallId();
            const roomId = String(Math.floor(100000 + Math.random() * 900000));
            currentCall = {
                callId,
                toSocketId: targetUser.socketId,
                toUserName: targetUser.name,  // 保存目标用户名用于 HTTP 兜底
                callType,
                isOutgoing: true,
                name: targetUser.name,
                avatar: targetUser.avatar,
                color: targetUser.color,
                roomId,
                isPrivateCall: !!isPrivateCall,  // 标记是否私聊通话
                createdAt: Date.now()  // 用于检测僵尸状态
            };
            // 公用聊天室通话：清除 privateCallPeer；私聊通话：保留
            if (!isPrivateCall) {
                localStorage.removeItem('privateCallPeer');
                localStorage.removeItem('callRole');
            } else {
                // 私聊通话：标记为主叫，只有主叫方负责生成通话记录（被叫方等待推送）
                localStorage.setItem('callRole', 'caller');
                // 标记通话处于"呼叫中"状态（用于拒绝/取消时生成对应记录）
                localStorage.setItem('callOutcome', 'calling');
            }
            // 保存通话类型和对方头像到 localStorage，供 room 页面语音通话界面使用
            localStorage.setItem('callType', callType);
            localStorage.setItem('callPeerAvatar', targetUser.avatar || '');
            localStorage.setItem('callPeerName', targetUser.name || '');
            // 优先 socket 发送，断连时走 HTTP 兜底
            if (socket.connected) {
                socket.emit('call-invite', {
                    toSocketId: targetUser.socketId,
                    callType,
                    callId,
                    roomId,
                    isPrivateCall: !!isPrivateCall
                });
            } else {
                // HTTP 兜底发起通话邀请
                fetch('/api/call/invite', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        toUserName: targetUser.name,
                        fromUserName: myName,
                        fromUserId: myUserId,
                        callType,
                        callId,
                        roomId,
                        isPrivateCall: !!isPrivateCall
                    })
                }).then(res => res.json()).then(data => {
                    if (!data.success) {
                        showToast('呼叫失败', 'error');
                        closeCallModal();
                        currentCall = null;
                    } else if (!data.targetOnline) {
                        showToast('对方可能不在线，等待对方上线...', 'info');
                    }
                }).catch(e => {
                    console.error('[HTTP通话邀请] 失败', e);
                    showToast('呼叫失败，请检查网络', 'error');
                    closeCallModal();
                    currentCall = null;
                });
            }
            // 显示呼叫中界面
            showOutgoingCallUI(targetUser, callType);
        }

        // 显示主叫呼叫中界面
        function showOutgoingCallUI(targetUser, callType) {
            const modal = document.getElementById('callModal');
            const statusEl = document.getElementById('callStatus');
            // 完全重置弹窗动画状态，避免上次通话的 closing/rejected 残留导致异常
            modal.classList.remove('incoming', 'closing', 'rejected');
            statusEl.textContent = '正在呼叫...';
            statusEl.classList.remove('calling');
            void statusEl.offsetWidth;  // 强制 reflow，重置 calling 动画
            statusEl.classList.add('calling');
            const avatarEl = document.getElementById('callAvatar');
            const color = targetUser.color || '#5765ec';
            const initial = (targetUser.name || '?')[0].toUpperCase();
            avatarEl.style.background = color;
            avatarEl.innerHTML = targetUser.avatar ? `<img src="${targetUser.avatar}">` : initial;
            document.getElementById('callName').textContent = targetUser.name || '匿名';
            document.getElementById('callTypeLabel').textContent =
                callType === 'video' ? '视频通话' : '语音通话';
            // 只显示取消按钮
            document.getElementById('callActions').innerHTML = `
                <div class="call-btn-wrap">
                    <button class="call-btn reject" onclick="cancelOutgoingCall()"><i class="fa fa-phone"></i></button>
                    <div class="call-btn-label">取消</div>
                </div>
            `;
            modal.classList.remove('incoming');  // 主叫方不响铃/不震动
            modal.classList.add('show');
            // 主叫方不播放铃声（用户没要求），仅靠动画提示
        }

        // 主叫取消呼叫
        function cancelOutgoingCall() {
            if (!currentCall) return;
            // 私聊通话主叫主动取消：生成"通话已取消"记录
            const isPrivate = currentCall.isPrivateCall;
            const peerName = currentCall.toUserName || currentCall.name;
            const callType = currentCall.callType;
            if (socket.connected) {
                socket.emit('call-caller-cancel', {
                    callId: currentCall.callId,
                    toSocketId: currentCall.toSocketId
                });
            } else if (currentCall.toUserName) {
                // HTTP 兜底取消
                fetch('/api/call/cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ callId: currentCall.callId, toUserName: currentCall.toUserName })
                }).catch(e => console.error('[HTTP取消通话] 失败', e));
            }
            closeCallModal('cancel');  // 取消动画：缩放淡出
            currentCall = null;
            if (isPrivate && peerName) {
                generatePrivateCallRecord(peerName, callType, 0, 'cancelled');
            }
        }

        // 显示来电界面
        function showIncomingCall(data) {
            // 已知来电 callId 去重（socket + HTTP 轮询可能重复触发）
            if (currentCall && currentCall.callId === data.callId) {
                console.log('[通话] 来电 callId 已存在，跳过', data.callId);
                return;
            }
            // 僵尸状态检测：currentCall 残留超过 15 秒（接听后跳转失败/页面异常等），清理后处理新来电
            // 避免残留的 accepted=true 状态导致所有新来电被自动拒绝（"一直显示被叫拒绝"的根因）
            if (currentCall && currentCall.createdAt && (Date.now() - currentCall.createdAt > 15000)) {
                console.log('[通话] 检测到僵尸通话状态，清理后处理新来电', currentCall.callId, '->', data.callId);
                closeCallModal();
                stopCallRingAndVibrate();
                currentCall = null;
            }
            // 如果已在通话中（已接听），才拒绝并发来电
            if (currentCall && currentCall.accepted === true && currentCall.callId !== data.callId) {
                console.log('[通话] 正在通话中，拒绝并发来电', data.callId);
                if (socket.connected) {
                    socket.emit('call-reject', { callId: data.callId, toSocketId: data.from });
                }
                return;
            }
            // currentCall 存在但未接听（待接听/呼叫中），直接覆盖，允许新来电
            if (currentCall && !currentCall.accepted) {
                console.log('[通话] 覆盖未接听的旧来电', currentCall.callId, '->', data.callId);
                closeCallModal();
                stopCallRingAndVibrate();
                currentCall = null;
            }
            const caller = onlineUsers[data.from] || {};
            currentCall = {
                callId: data.callId,
                toSocketId: data.from,
                fromSocketId: data.from,
                fromUserName: data.fromName || caller.name || '未知',  // 保存主叫用户名用于 HTTP 兜底
                callType: data.callType,
                isOutgoing: false,
                isPrivateCall: !!data.isPrivateCall,  // 标记是否私聊通话（由主叫透传）
                name: data.fromName || caller.name || '未知',
                avatar: caller.avatar,
                color: caller.color,
                roomId: data.roomId,
                createdAt: Date.now()  // 用于检测僵尸状态
            };
            // 保存通话类型和对方头像到 localStorage，供 room 页面语音通话界面使用
            localStorage.setItem('callType', data.callType);
            localStorage.setItem('callPeerAvatar', caller.avatar || '');
            localStorage.setItem('callPeerName', data.fromName || caller.name || '');
            const modal = document.getElementById('callModal');
            document.getElementById('callStatus').textContent = '来电...';
            const avatarEl = document.getElementById('callAvatar');
            const color = caller.color || '#5765ec';
            const initial = (data.fromName || '?')[0].toUpperCase();
            avatarEl.style.background = color;
            avatarEl.innerHTML = caller.avatar ? `<img src="${caller.avatar}">` : initial;
            document.getElementById('callName').textContent = data.fromName || '未知';
            document.getElementById('callTypeLabel').textContent =
                data.callType === 'video' ? '视频通话' : '语音通话';
            // 显示接听和拒绝按钮
            document.getElementById('callActions').innerHTML = `
                <div class="call-btn-wrap">
                    <button class="call-btn reject" onclick="rejectIncomingCall()"><i class="fa fa-phone"></i></button>
                    <div class="call-btn-label">拒绝</div>
                </div>
                <div class="call-btn-wrap">
                    <button class="call-btn accept" onclick="acceptIncomingCall()"><i class="fa fa-phone"></i></button>
                    <div class="call-btn-label">接听</div>
                </div>
            `;
            // 来电样式 + 启动铃声 + 震动
            modal.classList.add('show', 'incoming');
            startCallRingAndVibrate();
        }

        // 接听来电
        function acceptIncomingCall() {
            if (!currentCall) return;
            // 清除来电系统通知（Android）
            try { if (window.AndroidApp && window.AndroidApp.dismissCallNotification) window.AndroidApp.dismissCallNotification(); } catch(e) {}
            // 标记为已接听（用于 showIncomingCall 判断是否拒绝并发来电）
            currentCall.accepted = true;
            // 超时清理：接听后应在 180ms 跳转房间，若 5 秒后仍未跳转（WebView 异常/跳转被拦截），清理 currentCall 避免残留导致后续来电被自动拒绝
            const acceptedCallId = currentCall.callId;
            setTimeout(() => {
                if (currentCall && currentCall.callId === acceptedCallId && currentCall.accepted === true) {
                    console.log('[通话] 接听后跳转超时，清理 currentCall 避免残留', acceptedCallId);
                    currentCall = null;
                    closeCallModal();
                }
            }, 5000);
            if (socket.connected) {
                socket.emit('call-accept', { callId: currentCall.callId, toSocketId: currentCall.toSocketId });
            } else if (currentCall.fromUserName) {
                // HTTP 兜底接受
                fetch('/api/call/respond', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        callId: currentCall.callId,
                        toUserName: currentCall.fromUserName,
                        fromUserName: myName,
                        action: 'accept'
                    })
                }).catch(e => console.error('[HTTP接受通话] 失败', e));
            }
            // 记录通话开始时间到 localStorage
            localStorage.setItem('callStartTime', String(Date.now()));
            localStorage.setItem('callPeerName', currentCall.name || '');
            localStorage.setItem('callType', currentCall.callType || 'voice');
            // 保存通话房间信息，供返回聊天页时显示通话状态横条
            localStorage.setItem('activeCallRoomId', currentCall.roomId || '');
            localStorage.setItem('activeCallPeerName', currentCall.name || '');
            localStorage.setItem('activeCallType', currentCall.callType || 'voice');
            // 私聊通话：被叫方也设置 privateCallPeer，防止通话记录被误发到公用聊天室
            if (currentCall.isPrivateCall) {
                localStorage.setItem('privateCallPeer', currentCall.name || '');
                // 标记为被叫，被叫方不生成通话记录（等主叫方推送）
                localStorage.setItem('callRole', 'callee');
            } else {
                localStorage.removeItem('privateCallPeer');
                localStorage.removeItem('callRole');
            }
            const roomId = currentCall.roomId;
            closeCallModal('accept');  // 接听动画：缩放淡出
            // 通话开始：显示屏幕共享按钮
            nativeSetShareButtonVisible(true);
            // 跳转到房间（稍微延迟，让接听动画播一下）
            setTimeout(() => { window.location.href = `/room/${roomId}`; }, 180);
        }

        // 拒绝来电
        function rejectIncomingCall() {
            if (!currentCall) return;
            // 清除来电系统通知（Android）
            try { if (window.AndroidApp && window.AndroidApp.dismissCallNotification) window.AndroidApp.dismissCallNotification(); } catch(e) {}
            // 私聊通话：被叫方不生成记录（主叫方收到 call-rejected 后会生成并推送，避免重复）
            if (socket.connected) {
                socket.emit('call-reject', { callId: currentCall.callId, toSocketId: currentCall.toSocketId });
            } else if (currentCall.fromUserName) {
                // HTTP 兜底拒绝
                fetch('/api/call/respond', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        callId: currentCall.callId,
                        toUserName: currentCall.fromUserName,
                        fromUserName: myName,
                        action: 'reject'
                    })
                }).catch(e => console.error('[HTTP拒绝通话] 失败', e));
            }
            closeCallModal('reject');  // 拒绝动画：左右抖动后淡出
            currentCall = null;
        }

        // 关闭通话弹窗（带动画效果）
        // type: 'accept' 接听（缩放淡出） / 'reject' 拒绝（左右抖动后淡出） / 'cancel' 取消（缩放淡出） / 默认 立即关闭
        function closeCallModal(type) {
            const modal = document.getElementById('callModal');
            // 立即停止铃声 + 震动
            stopCallRingAndVibrate();
            // 清除 calling 状态文字脉冲动画
            document.getElementById('callStatus').classList.remove('calling');
            if (!modal.classList.contains('show')) {
                modal.classList.remove('incoming', 'closing', 'rejected');
                return;
            }
            if (type === 'reject') {
                // 拒绝：左右抖动后淡出
                modal.classList.add('rejected');
                setTimeout(() => {
                    modal.classList.remove('show', 'incoming', 'closing', 'rejected');
                }, 400);
            } else if (type === 'accept' || type === 'cancel') {
                // 接听/取消：缩放淡出
                modal.classList.add('closing');
                setTimeout(() => {
                    modal.classList.remove('show', 'incoming', 'closing', 'rejected');
                }, 200);
            } else {
                modal.classList.remove('show', 'incoming', 'closing', 'rejected');
            }
        }

        // 页面加载完成后初始化导航栏头像
        (function initNavAvatar() {
            updateNavAvatar();
            // 先加载本地缓存（避免空白等待服务端）
            loadLocalMessages();
            // 再请求服务端最新消息，用服务端数据覆盖本地缓存
            loadServerMessages();
            // 启动 HTTP 持续轮询兜底（外网 socket 推送不可靠，用 HTTP 轮询确保消息实时性）
            startHttpPolling();
            // 通过 HTTP 兜底加载自己头像（socket chat-online-users 事件可能丢失）
            if (myName) {
                fetch('/api/user/avatar-by-name/' + encodeURIComponent(myName))
                    .then(r => r.json())
                    .then(data => {
                        if (data.avatar && !myAvatar) {
                            myAvatar = data.avatar;
                            updateNavAvatar();
                            avatarByName[myName] = data.avatar;
                        }
                    }).catch(e => console.error('加载自己头像失败', e));
            }
            // 检查是否有未完成的通话总结（即使没收到 chat-history）
            setTimeout(checkPendingCallSummary, 500);
            // ===== 主题初始化（设置系统主题变化监听器）=====
            initTheme();
            // ===== 好友系统初始化 =====
            initFriendsSystem();
        })();

        // ===== 好友系统逻辑 =====
        let myFriends = [];          // 缓存好友列表
        let friendUnread = {};        // 每个好友的未读消息数（按 peerName 索引）
        let lastReadTs = {};          // 每个好友最后已读消息的时间戳（用于避免已读消息重复计数）
        let currentPrivatePeer = null;  // 当前打开的私聊对方名称
        let privateMsgsCache = {};   // 每个好友的本地消息缓存（按 peerName 索引，全部消息）

