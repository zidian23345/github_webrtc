        // ===== 聊天记录搜索 =====
        // 入口：点击他人头像（群聊） / 私聊页右上角三个点 → 聊天记录
        // 范围：与该用户的私聊记录 + 该用户在群聊中发送的消息（本地缓存）
        let chatSearchPeer = null;

        function openChatSearch(peerName) {
            chatSearchPeer = peerName;
            const html = `
                <div class="modal-title"><i class="fa fa-search"></i> 与 ${escapeHtml(peerName)} 的聊天记录</div>
                <div class="modal-content">
                    <div style="display:flex;gap:8px;margin-bottom:10px;">
                        <input type="text" id="chatSearchInput" placeholder="输入关键词搜索（含私聊和群聊）" style="flex:1;height:40px;border:1px solid #d9d9d9;border-radius:6px;padding:0 10px;font-size:14px;outline:none;" onkeypress="if(event.key==='Enter')runChatSearch()">
                        <button onclick="runChatSearch()" style="height:40px;padding:0 16px;background:#5765ec;color:#fff;border:none;border-radius:6px;font-size:14px;">搜索</button>
                    </div>
                    <div style="font-size:12px;color:#999;margin-bottom:8px;">提示：留空搜索最近记录；支持搜索文字内容，输入 [图片] [语音] [视频] 可按类型筛选</div>
                    <button onclick="openReportUser(chatSearchPeer, 'group')" style="width:100%;height:36px;background:#fff0e6;color:#e65100;border:1px solid #ffd3b3;border-radius:6px;font-size:13px;margin-bottom:10px;"><i class="fa fa-flag"></i> 举报该用户</button>
                    <div id="chatSearchResults" style="max-height:320px;overflow-y:auto;border:1px solid #eee;border-radius:8px;padding:4px;"></div>
